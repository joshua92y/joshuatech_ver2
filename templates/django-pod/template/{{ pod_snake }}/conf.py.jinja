"""{{ pod_name }} 설정 모델(T072 D5) — env를 읽어 검증한 값만 settings.py에 넘긴다.

정본: contracts/pod-template.md §런타임 계약 「설정」 · 「DB 연결」 행 · 규칙 .claude/rules/django-pod.md §Settings.

프로필 = env JT_SETTINGS_PROFILE: runtime(없음 · 기본) | migrate — 그 밖의 값(빈 값 포함)은 기동 실패다.
- runtime(web · relay · celery · CronJob · initContainer startup-check):
  - 필수(비지 않음): SECRET_KEY · DATABASE_URL · DRAGONFLY_URL · KAFKA_BOOTSTRAP · KAFKA_USERNAME · KAFKA_PASSWORD ·
    AUTHENTIK_ISSUER · AUTHENTIK_JWKS_URL · AUTHENTIK_AUDIENCE · ACCESS_TEAM_DOMAIN · ACCESS_AUD_M2M · ACCESS_EXPECTED_CN ·
    ALLOWED_HOSTS · ENV · APP_VERSION · APP_GIT_SHA(이미지 ENV)
  - 필수(존재만 — 빈 값 유효): ACCESS_AUD_ADMIN · ADMIN_HOST
  - 선택(기본 빈 값): AUTH_ACTOR_SUB · SENTRY_DSN(빈 값 = 끔){% if has_admin %} · FORCE_SCRIPT_NAME(→ ADMIN_SCRIPT_NAME){% endif %} · POD_IP · POD_NAMESPACE ·
    JT_PLACEHOLDER_EXEMPT
  - 거부: 비지 않은 DATABASE_OWNER_URL(런타임에 owner 자격이 섞인 사고를 기동 실패로 바꾼다 — 심층 방어)
- migrate(PreSync migrate Job 전용): DATABASE_OWNER_URL만 필수 · ENV는 선택(없으면 verify-full을 강제한다 — Job에는
  ConfigMap이 없다). 런타임 설정(DRAGONFLY_URL · KAFKA_* · AUTHENTIK_* · SECRET_KEY …)은 정의하지 않는다 —
  <pod>-migrate에 런타임 키를 더하지 않는다(owner 비밀의 범위가 넓어진다).

모델 다음 교차 규칙(_runtime_problems · _migrate_problems)이 이름을 모은다:
- 자격 URL(DATABASE_URL · DATABASE_OWNER_URL · DRAGONFLY_URL): 사용자 정보는 [A-Za-z0-9_-]만(libpq · redis URI 파서 오류
  문구가 자격 조각을 싣지 않게) · 공백 · 제어 문자 · 비ASCII 없음 · DB URL 쿼리는 sslmode · sslrootcert만.
- DB TLS: ENV가 dev · prod(또는 migrate에서 없음)면 sslmode=verify-full + sslrootcert=/etc/pg/ca.crt, test면 require ·
  verify-ca · verify-full.
- dev · prod: ACCESS_TEAM_DOMAIN의 http:// 거부(루프백 http는 ENV=test만).
- 클러스터 안 URL(IN_CLUSTER_URL_SETTINGS · process env OTLP 엔드포인트 둘)의 호스트가 joshuatech.dev이거나 그 하위면 거부.
  DATABASE_URL · DRAGONFLY_URL · KAFKA_BOOTSTRAP 밖의 목록 이름은 http(s) URL이어야 한다 — 꼴이 틀렸거나 모델 필드가 없으면 그
  이름도 거부(넓힌 이름이 조용히 검사 밖에 남지 않게).
- SECRET_KEY 강도: 50자 이상 · 서로 다른 글자 5 이상 · django-insecure- 접두 아님(Django security.W009).
- 게이트 2: 문자열 값에 PLACEHOLDER-가 있으면 거부 — 예외는 env JT_PLACEHOLDER_EXEMPT(쉼표 이름) ∩ PLACEHOLDER_EXEMPTABLE뿐이고,
  상수 밖 이름을 env에 적어도 거부한다.
- 클러스터 교차 규칙(POD_NAMESPACE가 있을 때 — 런타임 컨테이너 전부의 downward API): ENV ≠ test · POD_NAMESPACE = jt-<ENV> ·
  KAFKA_USERNAME = (dev면 dev-) + 이 pod 이름 · DATABASE_URL 사용자 = (dev면 dev_) + {{ pod_snake }}_app · ALLOWED_HOSTS에
  {{ pod_name }}.<POD_NAMESPACE>.svc. ENV=test는 클러스터 밖(생성물 시험 · 로컬 compose) 전용이다.

실패는 ImproperlyConfigured("설정 오류: <이름들>")다 — 설정 이름만 싣고 값 · 연쇄 예외를 싣지 않는다(pydantic
ValidationError의 입력 값 표현은 env 값 — 비밀 포함 — 을 되풀이한다). 모델에도 hide_input_in_errors=True를 둔다. pod가 넓히는
목록(T073 등): SECRET_SETTINGS · IN_CLUSTER_URL_SETTINGS · PLACEHOLDER_EXEMPTABLE — 새 설정은 모델 필드와 이 목록에 함께 더한다.
"""

from __future__ import annotations

import ipaddress
import os
import re
from collections.abc import Iterable, Mapping
from dataclasses import dataclass, field
from functools import cache
from typing import Annotated, Any, Literal
from urllib.parse import SplitResult, parse_qsl, urlsplit

from django.core.exceptions import ImproperlyConfigured
from pydantic import Field, ValidationError, field_validator
from pydantic_settings import BaseSettings, NoDecode, PydanticBaseSettingsSource, SettingsConfigDict

__all__ = [
    "IN_CLUSTER_URL_SETTINGS",
    "KAFKA_CA_FILE",
    "MIGRATE",
    "PG_CA_FILE",
    "PLACEHOLDER_EXEMPTABLE",
    "POD_NAME",
    "POD_SNAKE",
    "RUNTIME",
    "SECRET_SETTINGS",
    "DatabaseUrl",
    "LoadedSettings",
    "MigrateEnv",
    "RuntimeEnv",
    "load",
]

POD_NAME = "{{ pod_name }}"
POD_SNAKE = "{{ pod_snake }}"
PROFILE_ENV = "JT_SETTINGS_PROFILE"
RUNTIME = "runtime"
MIGRATE = "migrate"
PROFILES = (RUNTIME, MIGRATE)
# 마운트 경로 상수(env 키가 아니다) — deploy/base가 Secret jt-kafka-cluster-ca-cert · pg-main-ca를 여기에 마운트한다.
KAFKA_CA_FILE = "/etc/kafka/ca.crt"
PG_CA_FILE = "/etc/pg/ca.crt"
# 비밀 설정 — 빈 값도 기동 실패(빈 키 · 토큰은 누구나 만든다). pod 계약이 이름을 더한다(identity-admin = T073).
SECRET_SETTINGS: tuple[str, ...] = ("SECRET_KEY", "KAFKA_PASSWORD")
# pod가 직접 부르는 클러스터 안 서비스 — 호스트가 공개 도메인이면 기동 실패(FR-046). AUTHENTIK_ISSUER는 문자열 비교만 하는 공개
# URL이라 넣지 않는다. 넓히는 자리(T073: AUTHENTIK_API_URL · OPENFGA_API_URL): 모델 필드와 함께 더하면 http(s) URL로 검사된다
# (DATABASE_URL · DRAGONFLY_URL · KAFKA_BOOTSTRAP만 따로 파싱한다 — _in_cluster_problems).
IN_CLUSTER_URL_SETTINGS: tuple[str, ...] = ("DATABASE_URL", "DRAGONFLY_URL", "KAFKA_BOOTSTRAP", "AUTHENTIK_JWKS_URL")
OTLP_ENDPOINT_ENVS = ("OTEL_EXPORTER_OTLP_ENDPOINT", "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT")
PUBLIC_DOMAIN = "joshuatech.dev"
# 게이트 2 — base ConfigMap의 자리값(PLACEHOLDER-SET-IN-OVERLAY)이 overlay에서 빠지면 기동 실패. 면제 가능한 이름은 코드
# 상수로만 정한다(템플릿은 빈 집합).
PLACEHOLDER_MARK = "PLACEHOLDER-"
PLACEHOLDER_EXEMPT_ENV = "JT_PLACEHOLDER_EXEMPT"
PLACEHOLDER_EXEMPTABLE: frozenset[str] = frozenset()
# Django security.W009 기준
SECRET_KEY_MIN_LENGTH = 50
SECRET_KEY_MIN_UNIQUE = 5
SECRET_KEY_INSECURE_PREFIX = "django-insecure-"

_DB_SCHEMES = frozenset({"postgresql", "postgres"})
_DB_QUERY_KEYS = frozenset({"sslmode", "sslrootcert"})
_STRICT_SSLMODE = "verify-full"
_TEST_SSLMODES = frozenset({"require", "verify-ca", "verify-full"})
_REDIS_SCHEMES = frozenset({"redis", "rediss"})
_USERINFO_RE = re.compile(r"[A-Za-z0-9_-]+")
_DB_NAME_RE = re.compile(r"[A-Za-z0-9_][A-Za-z0-9_-]*")
_HOST_PORT_RE = re.compile(r"(\[[0-9A-Fa-f:.]+\]|[A-Za-z0-9.-]+):([0-9]{1,5})")
_GIT_SHA_RE = re.compile(r"[0-9a-f]{7,64}")
_SCRIPT_NAME_RE = re.compile(r"/[a-z][a-z0-9]*(-[a-z0-9]+)*")
_PRINTABLE_ASCII_RE = re.compile(r"[!-~]+")

_MODEL_CONFIG = SettingsConfigDict(
    case_sensitive=True,
    env_file=None,
    env_ignore_empty=False,
    hide_input_in_errors=True,
    extra="ignore",
)

NonEmpty = Annotated[str, Field(min_length=1)]
# 비밀 · 자격 URL — 모델 repr에서도 뺀다(값이 어디에도 찍히지 않게 — 심층 방어).
NonEmptySecret = Annotated[str, Field(min_length=1, repr=False)]
OptionalSecret = Annotated[str, Field(repr=False)]


class RuntimeEnv(BaseSettings):
    """runtime 프로필 env(값은 문자열 그대로 — 꼴 검사는 교차 규칙이 이름만 모은다)."""

    model_config = _MODEL_CONFIG

    SECRET_KEY: NonEmptySecret
    DATABASE_URL: NonEmptySecret
    DRAGONFLY_URL: NonEmptySecret
    KAFKA_BOOTSTRAP: NonEmpty
    KAFKA_USERNAME: NonEmpty
    KAFKA_PASSWORD: NonEmptySecret
    AUTHENTIK_ISSUER: NonEmpty
    AUTHENTIK_JWKS_URL: NonEmpty
    AUTHENTIK_AUDIENCE: NonEmpty
    ACCESS_TEAM_DOMAIN: NonEmpty
    ACCESS_AUD_M2M: NonEmpty
    ACCESS_AUD_ADMIN: str  # 존재 필수 · 빈 값 = admin AUD 없음
    ACCESS_EXPECTED_CN: NonEmpty
    # NoDecode: pydantic-settings가 복합 형 env를 JSON으로 풀지 않게 하고 쉼표로 나눈다(아래 검증기).
    ALLOWED_HOSTS: Annotated[tuple[str, ...], NoDecode]
    ADMIN_HOST: str  # 존재 필수 · 빈 값 = admin 없음(dev)
    ENV: Literal["dev", "prod", "test"]
    APP_VERSION: NonEmpty
    APP_GIT_SHA: NonEmpty
    AUTH_ACTOR_SUB: str = ""
    SENTRY_DSN: OptionalSecret = ""
{%- if has_admin %}
    FORCE_SCRIPT_NAME: str = ""
{%- endif %}
    POD_IP: str = ""
    POD_NAMESPACE: str = ""
    DATABASE_OWNER_URL: OptionalSecret = ""
    JT_PLACEHOLDER_EXEMPT: str = ""

    @field_validator("ALLOWED_HOSTS", mode="before")
    @classmethod
    def _split_hosts(cls, value: object) -> object:
        if isinstance(value, str):
            return tuple(part.strip() for part in value.split(","))
        return value


class MigrateEnv(BaseSettings):
    """migrate 프로필 env — DATABASE_OWNER_URL만 필수(런타임 설정은 정의하지 않는다)."""

    model_config = _MODEL_CONFIG

    DATABASE_OWNER_URL: NonEmptySecret
    ENV: Literal["dev", "prod", "test"] | None = None
    JT_PLACEHOLDER_EXEMPT: str = ""


@dataclass(frozen=True)
class DatabaseUrl:
    """postgresql URL을 나눈 값(비밀번호는 repr에서 뺀다)."""

    name: str
    user: str
    host: str
    port: int
    sslmode: str
    sslrootcert: str
    password: str = field(repr=False)

    def django(self) -> dict[str, Any]:
        """Django DATABASES 항목 — URL의 sslmode · sslrootcert + 연결 정책(계약 「DB 연결」 행 · D6)."""
        options: dict[str, Any] = {
            "sslmode": self.sslmode,
            "connect_timeout": 2,
            "keepalives_idle": 30,
            "keepalives_interval": 10,
            "keepalives_count": 3,
            "tcp_user_timeout": 30000,
        }
        if self.sslrootcert:
            options["sslrootcert"] = self.sslrootcert
        return {
            "ENGINE": "django.db.backends.postgresql",
            "NAME": self.name,
            "USER": self.user,
            "PASSWORD": self.password,
            "HOST": self.host,
            "PORT": str(self.port),
            "OPTIONS": options,
            "CONN_MAX_AGE": 60,
            "CONN_HEALTH_CHECKS": True,
        }


@dataclass(frozen=True)
class LoadedSettings:
    """load()의 결과 — profile · DB(default 별칭) · runtime env(migrate면 None) · ENV(migrate에서 없으면 None)."""

    profile: str
    database: DatabaseUrl
    env: str | None
    runtime: RuntimeEnv | None = field(default=None, repr=False)


def _printable(value: str) -> bool:
    """공백 없는 출력 가능 ASCII(`!`–`~`)만인가 — urlsplit이 조용히 떼는 공백 · 탭 · 줄바꿈 · 제어 문자를 막는다."""
    return _PRINTABLE_ASCII_RE.fullmatch(value) is not None


def _split(value: str) -> SplitResult | None:
    if not _printable(value):
        return None
    try:
        parts = urlsplit(value)
        parts.port  # noqa: B018 — 포트 꼴 검사(ValueError)
    except ValueError:
        return None
    return parts


def database_url(value: str) -> DatabaseUrl | None:
    """postgresql URL → DatabaseUrl(꼴이 틀리면 None — 호출자는 설정 이름만 보고한다)."""
    parts = _split(value)
    if parts is None or parts.scheme not in _DB_SCHEMES or parts.fragment:
        return None
    host = parts.hostname or ""
    user = parts.username or ""
    password = parts.password or ""
    name = parts.path.removeprefix("/")
    if not host or not _USERINFO_RE.fullmatch(user) or not _USERINFO_RE.fullmatch(password):
        return None
    if not parts.path.startswith("/") or not _DB_NAME_RE.fullmatch(name):
        return None
    try:
        pairs = parse_qsl(parts.query, keep_blank_values=True, strict_parsing=bool(parts.query))
    except ValueError:
        return None
    keys = [key for key, _ in pairs]
    if len(keys) != len(set(keys)) or not set(keys) <= _DB_QUERY_KEYS:
        return None
    query = dict(pairs)
    return DatabaseUrl(
        name=name,
        user=user,
        host=host,
        port=parts.port or 5432,
        sslmode=query.get("sslmode", ""),
        sslrootcert=query.get("sslrootcert", ""),
        password=password,
    )


def _tls_ok(database: DatabaseUrl, env: str | None) -> bool:
    if env == "test":
        return database.sslmode in _TEST_SSLMODES
    return database.sslmode == _STRICT_SSLMODE and database.sslrootcert == PG_CA_FILE


def _dragonfly_host(value: str) -> str | None:
    """redis URL의 호스트(꼴이 틀리면 None) — 사용자 · 비밀번호 필수 · 쿼리 · 조각 없음."""
    parts = _split(value)
    if parts is None or parts.scheme not in _REDIS_SCHEMES or parts.query or parts.fragment:
        return None
    if not _USERINFO_RE.fullmatch(parts.username or "") or not _USERINFO_RE.fullmatch(parts.password or ""):
        return None
    return parts.hostname or None


def _kafka_hosts(value: str) -> list[str] | None:
    """host:port 쉼표 목록 → 호스트 목록(꼴이 틀리면 None)."""
    hosts: list[str] = []
    for item in value.split(","):
        match = _HOST_PORT_RE.fullmatch(item)
        if match is None or not 1 <= int(match.group(2)) <= 65535:
            return None
        hosts.append(match.group(1).strip("[]"))
    return hosts


def _url_host(value: str) -> str | None:
    parts = _split(value)
    if parts is None or parts.scheme.lower() not in ("http", "https"):
        return None
    return parts.hostname or None


def _public_host(host: str) -> bool:
    name = host.lower().rstrip(".")
    return name == PUBLIC_DOMAIN or name.endswith("." + PUBLIC_DOMAIN)


def _secret_key_ok(value: str) -> bool:
    return (
        len(value) >= SECRET_KEY_MIN_LENGTH
        and len(set(value)) >= SECRET_KEY_MIN_UNIQUE
        and not value.startswith(SECRET_KEY_INSECURE_PREFIX)
    )


def _placeholder_problems(values: Mapping[str, object], exempt_raw: str) -> list[str]:
    """게이트 2 — PLACEHOLDER-가 든 값의 이름 + 상수 밖 면제 요청(JT_PLACEHOLDER_EXEMPT)."""
    requested = {name.strip() for name in exempt_raw.split(",") if name.strip()}
    problems = [PLACEHOLDER_EXEMPT_ENV] if requested - PLACEHOLDER_EXEMPTABLE else []
    exempt = requested & PLACEHOLDER_EXEMPTABLE
    for name, value in values.items():
        texts: Iterable[object] = value if isinstance(value, tuple) else (value,)
        if name not in exempt and any(isinstance(text, str) and PLACEHOLDER_MARK in text for text in texts):
            problems.append(name)
    return problems


def _runtime_problems(env: RuntimeEnv, process_env: Mapping[str, str]) -> tuple[list[str], DatabaseUrl | None]:
    """runtime 교차 규칙(모듈 독스트링) — 어긴 설정 이름과 나눈 DB URL(꼴이 틀리면 None)."""
    problems: list[str] = []
    database = database_url(env.DATABASE_URL)
    if database is None or not _tls_ok(database, env.ENV):
        problems.append("DATABASE_URL")
    dragonfly_host = _dragonfly_host(env.DRAGONFLY_URL)
    if dragonfly_host is None:
        problems.append("DRAGONFLY_URL")
    kafka_hosts = _kafka_hosts(env.KAFKA_BOOTSTRAP)
    if kafka_hosts is None:
        problems.append("KAFKA_BOOTSTRAP")
    problems.extend(_in_cluster_problems(env, database, dragonfly_host, kafka_hosts))
    for name in OTLP_ENDPOINT_ENVS:
        host = _url_host(process_env.get(name, "") or "")
        if host is not None and _public_host(host):
            problems.append(name)
    if env.DATABASE_OWNER_URL:
        problems.append("DATABASE_OWNER_URL")
    problems.extend(name for name in SECRET_SETTINGS if not getattr(env, name, ""))
    if not _secret_key_ok(env.SECRET_KEY):
        problems.append("SECRET_KEY")
    if env.ENV in ("dev", "prod") and env.ACCESS_TEAM_DOMAIN.lower().startswith("http://"):
        problems.append("ACCESS_TEAM_DOMAIN")
    hosts = env.ALLOWED_HOSTS
    if not hosts or any(not host or "*" in host or not _printable(host) for host in hosts):
        problems.append("ALLOWED_HOSTS")
    if env.ADMIN_HOST and not _printable(env.ADMIN_HOST):
        problems.append("ADMIN_HOST")
    if _GIT_SHA_RE.fullmatch(env.APP_GIT_SHA) is None:
        problems.append("APP_GIT_SHA")
    if env.POD_IP:
        try:
            ipaddress.ip_address(env.POD_IP)
        except ValueError:
            problems.append("POD_IP")
{%- if has_admin %}
    if env.FORCE_SCRIPT_NAME and _SCRIPT_NAME_RE.fullmatch(env.FORCE_SCRIPT_NAME) is None:
        problems.append("FORCE_SCRIPT_NAME")
{%- endif %}
    if env.POD_NAMESPACE:
        problems.extend(_cluster_problems(env, database))
    problems.extend(_placeholder_problems(env.model_dump(), env.JT_PLACEHOLDER_EXEMPT))
    return problems, database


def _in_cluster_problems(
    env: RuntimeEnv, database: DatabaseUrl | None, dragonfly_host: str | None, kafka_hosts: list[str] | None
) -> list[str]:
    """IN_CLUSTER_URL_SETTINGS — 호스트가 공개 도메인이면 그 이름. 따로 파싱하는 셋(DATABASE_URL · DRAGONFLY_URL ·
    KAFKA_BOOTSTRAP — 꼴이 틀린 경우는 호출자가 이미 실었다) 밖의 이름은 http(s) URL로 일반 계산한다: 꼴이 틀렸거나 모델에 그
    필드가 없으면 그 이름도 문제다(닫힌 쪽 — SECRET_SETTINGS와 같다). 넓힌 이름(T073 · SP-2)이 조용히 검사 밖에 남지 않는다."""
    parsed_hosts: dict[str, list[str]] = {
        "DATABASE_URL": [database.host] if database is not None else [],
        "DRAGONFLY_URL": [dragonfly_host] if dragonfly_host else [],
        "KAFKA_BOOTSTRAP": kafka_hosts or [],
    }
    problems: list[str] = []
    for name in IN_CLUSTER_URL_SETTINGS:
        hosts = parsed_hosts.get(name)
        if hosts is None:
            value = getattr(env, name, "")
            host = _url_host(value) if isinstance(value, str) else None
            if host is None:
                problems.append(name)
                continue
            hosts = [host]
        if any(_public_host(host) for host in hosts):
            problems.append(name)
    return problems


def _cluster_problems(env: RuntimeEnv, database: DatabaseUrl | None) -> list[str]:
    """클러스터 교차 규칙(POD_NAMESPACE가 있을 때 — 모듈 독스트링)."""
    namespace = env.POD_NAMESPACE
    problems: list[str] = []
    if env.ENV == "test":
        problems.extend(("ENV", "POD_NAMESPACE"))
    else:
        dev = env.ENV == "dev"
        if namespace != f"jt-{env.ENV}":
            problems.append("POD_NAMESPACE")
        if env.KAFKA_USERNAME != ("dev-" if dev else "") + POD_NAME:
            problems.append("KAFKA_USERNAME")
        if database is not None and database.user != ("dev_" if dev else "") + f"{POD_SNAKE}_app":
            problems.append("DATABASE_URL")
    if f"{POD_NAME}.{namespace}.svc" not in env.ALLOWED_HOSTS:
        problems.append("ALLOWED_HOSTS")
    return problems


def _migrate_problems(env: MigrateEnv) -> tuple[list[str], DatabaseUrl | None]:
    problems: list[str] = []
    database = database_url(env.DATABASE_OWNER_URL)
    if database is None or not _tls_ok(database, env.ENV):
        problems.append("DATABASE_OWNER_URL")
    elif _public_host(database.host):
        problems.append("DATABASE_OWNER_URL")
    problems.extend(_placeholder_problems(env.model_dump(), env.JT_PLACEHOLDER_EXEMPT))
    return problems, database


def _model_problem_names(error: ValidationError) -> list[str]:
    """pydantic 오류 → 설정 이름(loc 첫 칸)만 — 메시지 · 입력 값은 버린다."""
    return [str(item["loc"][0]) if item.get("loc") else "settings" for item in error.errors(include_input=False)]


def _refuse(names: Iterable[str]) -> ImproperlyConfigured:
    unique = sorted(set(names))
    return ImproperlyConfigured(f"설정 오류: {', '.join(unique)}")


@cache
def _mapping_only[M: BaseSettings](model: type[M]) -> type[M]:
    """model과 같은 필드 · 검증기 · 설정이되 값 소스가 생성자 인자뿐인 하위 클래스 — BaseSettings는 model_validate · 생성자
    인자에도 process env 소스를 합치므로(pydantic-settings 2.16 실측), 매핑 검증에 process env가 섞이지 않게 소스를 좁힌다."""

    class MappingOnly(model):  # type: ignore[valid-type, misc]
        @classmethod
        def settings_customise_sources(
            cls,
            settings_cls: type[BaseSettings],
            init_settings: PydanticBaseSettingsSource,
            env_settings: PydanticBaseSettingsSource,
            dotenv_settings: PydanticBaseSettingsSource,
            file_secret_settings: PydanticBaseSettingsSource,
        ) -> tuple[PydanticBaseSettingsSource, ...]:
            return (init_settings,)

    MappingOnly.__name__ = MappingOnly.__qualname__ = model.__name__
    return MappingOnly


def _read[M: BaseSettings](model: type[M], environ: Mapping[str, str] | None) -> tuple[M | None, list[str]]:
    """모델 하나를 읽는다 → (모델 | None, 어긴 설정 이름). environ이 None이면 pydantic-settings가 process env를 읽고,
    매핑이면 그 매핑의 모델 필드 이름만 검증한다(시험용 — 같은 필드 · 같은 검증기 · process env는 섞지 않는다)."""
    try:
        if environ is None:
            return model(), []
        return _mapping_only(model)(**{name: environ[name] for name in model.model_fields if name in environ}), []
    except ValidationError as error:
        names = _model_problem_names(error)
    # 예외 처리 블록 밖에서 돌려준다 — ValidationError(입력 값 표현 · 비밀)가 호출자 예외의 __context__로 남지 않게.
    return None, names


def load(environ: Mapping[str, str] | None = None) -> LoadedSettings:
    """env를 읽어 검증한다 — 실패는 이름만 실은 ImproperlyConfigured(연쇄 예외 없음). environ 인자는 시험용이다(기본 =
    process env)."""
    process_env = os.environ if environ is None else environ
    profile = process_env.get(PROFILE_ENV, RUNTIME)
    if profile not in PROFILES:
        raise _refuse([PROFILE_ENV]) from None
    if profile == MIGRATE:
        migrate, names = _read(MigrateEnv, environ)
        if migrate is None:
            raise _refuse(names) from None
        problems, owner = _migrate_problems(migrate)
        if problems or owner is None:
            raise _refuse(problems or ["DATABASE_OWNER_URL"]) from None
        return LoadedSettings(profile=MIGRATE, database=owner, env=migrate.ENV)
    runtime, names = _read(RuntimeEnv, environ)
    if runtime is None:
        raise _refuse(names) from None
    problems, database = _runtime_problems(runtime, process_env)
    if problems or database is None:
        raise _refuse(problems or ["DATABASE_URL"]) from None
    return LoadedSettings(profile=RUNTIME, database=database, env=runtime.ENV, runtime=runtime)


def allowed_hosts(runtime: RuntimeEnv) -> list[str]:
    """Django ALLOWED_HOSTS = 설정 값 + POD_IP(kubelet 프로브 Host — IPv6는 괄호)."""
    hosts = list(runtime.ALLOWED_HOSTS)
    if runtime.POD_IP:
        address = ipaddress.ip_address(runtime.POD_IP)
        hosts.append(f"[{address}]" if address.version == 6 else str(address))
    return hosts
