"""{{ pod_name }} 소비 토픽(T072 D13 · copier consumes_events) — 소비자 프로세스와 워크로드는 SP-2다(여기는 이름 규칙과 처리 규칙만).

처리 규칙(.claude/rules/events.md §Consumer rules · contracts/events.md):
- 봉투 data를 packages/events 스키마로 검증하고, 검증 실패는 DLQ로 보낸다(느슨한 파싱 금지).
- (consumer_group, 봉투 id)로 멱등 처리한다 — 재배달 · 순서 바뀜을 견딘다(파티션 키 = tenantid).
- 오프셋은 처리 트랜잭션이 커밋된 뒤에만 커밋한다. 처리 실패 3회 → 원래 봉투(+ error 헤더)를 DLQ로 · DLQ 재처리는 수동 명령만.
- 컨슈머 그룹 이름: prod <pod>-<purpose> · dev dev-<pod>-<purpose>(group_id) · Kafka 토픽 = env 접두 + 논리 토픽(kafka_topic).
"""

from __future__ import annotations

import re

CONSUMED_TOPICS: tuple[str, ...] = (
{%- for topic in consumes_events %}
    {{ topic | tojson }},
{%- endfor %}
)

_PURPOSE_RE = re.compile(r"[a-z][a-z0-9]*(-[a-z0-9]+)*")


def kafka_topic(topic: str) -> str:
    """소비 토픽의 Kafka 이름 = OUTBOX_TOPIC_PREFIX(prod "" · dev "dev.") + 논리 토픽 — CONSUMED_TOPICS 밖이면 ValueError."""
    if topic not in CONSUMED_TOPICS:
        raise ValueError("소비 토픽이 아니다(CONSUMED_TOPICS 밖) — copier consumes_events를 먼저 더한다")
    from django.conf import settings

    return f"{settings.OUTBOX_TOPIC_PREFIX}{topic}"


def group_id(purpose: str) -> str:
    """컨슈머 그룹 이름 — prod <pod>-<purpose> · dev(접두 dev.) dev-<pod>-<purpose>. purpose는 케밥 이름이다."""
    if not isinstance(purpose, str) or _PURPOSE_RE.fullmatch(purpose) is None:
        raise ValueError("purpose는 케밥 이름이어야 한다")
    from django.conf import settings

    env_prefix = "dev-" if settings.OUTBOX_TOPIC_PREFIX == "dev." else ""
    return f"{env_prefix}{settings.OUTBOX_SOURCE}-{purpose}"
