from django.urls import path

from {{ pod_snake }}.api import api

urlpatterns = [path("", api.urls)]

handler400 = "{{ pod_snake }}.errors.bad_request"
handler403 = "{{ pod_snake }}.errors.permission_denied"
handler404 = "{{ pod_snake }}.errors.page_not_found"
handler500 = "{{ pod_snake }}.errors.server_error"
