"""{{ pod_name }} 미들웨어(T072 D10 · D11) — sync 전용.

- HttpMetricsMiddleware: web 9100 지표 http_requests_total{route,status}(route = 해석된 URL 패턴 · 해석 안 됨 = 빈 값 — 원문 경로를
  라벨에 싣지 않는다). 지표는 이 미들웨어 인스턴스가 만들어질 때(web 처리기 적재) 등록된다 — relay · celery도 시스템 검사에서 이
  모듈을 import하지만 인스턴스를 만들지 않으므로 그 레지스트리에는 생기지 않는다({{ pod_snake }}.metrics 독스트링).
{%- if has_admin %}
- AdminHostMiddleware: ADMIN_HOST가 비었거나 요청 호스트가 정확히 같지 않으면 손대지 않는다. ADMIN_HOST 요청이면
  ① GET · HEAD /static/<p> → staticfiles serve(insecure=True — finders: 앱 정적 디렉터리만 · 경로 탈출은 SuspiciousFileOperation →
     handler400 400 validation_error)로 곧바로 응답한다. JwtAuthMiddleware 앞이라 자격이 필요 없다(admin 페이지 자산 · Access 뒤).
  ② 그 밖 → request.urlconf = ADMIN_URLCONF. ADMIN_SCRIPT_NAME이 있으면 script prefix · request.path · META["SCRIPT_NAME"]에
     접두를 넣고(reverse() · 리다이렉트 Location) 요청이 끝나면 finally에서 script prefix를 되돌린다 — 같은 스레드의 다음 요청에
     접두가 남지 않는다(Django 전역 FORCE_SCRIPT_NAME은 두지 않는다).
  WhiteNoise · collectstatic은 쓰지 않는다.
{%- endif %}
"""

from __future__ import annotations

from collections.abc import Callable
{% if has_admin %}
from django.conf import settings
from django.contrib.staticfiles.views import serve
{%- endif %}
from django.http import HttpRequest, HttpResponseBase
{%- if has_admin %}
from django.urls import get_script_prefix, set_script_prefix
{%- endif %}

from {{ pod_snake }}.metrics import http_requests_total

GetResponse = Callable[[HttpRequest], HttpResponseBase]


class HttpMetricsMiddleware:
    sync_capable = True
    async_capable = False

    def __init__(self, get_response: GetResponse) -> None:
        self.get_response = get_response
        self.requests_total = http_requests_total()

    def __call__(self, request: HttpRequest) -> HttpResponseBase:
        response = self.get_response(request)
        match = getattr(request, "resolver_match", None)
        route = match.route if match is not None else ""
        self.requests_total.labels(route=route, status=str(response.status_code)).inc()
        return response
{%- if has_admin %}


STATIC_PREFIX = "/static/"
_STATIC_METHODS = frozenset({"GET", "HEAD"})


class AdminHostMiddleware:
    sync_capable = True
    async_capable = False

    def __init__(self, get_response: GetResponse) -> None:
        self.get_response = get_response

    def __call__(self, request: HttpRequest) -> HttpResponseBase:
        admin_host = settings.ADMIN_HOST
        if not admin_host or request.get_host() != admin_host:
            return self.get_response(request)
        if request.method in _STATIC_METHODS and request.path_info.startswith(STATIC_PREFIX):
            return serve(request, request.path_info.removeprefix(STATIC_PREFIX), insecure=True)
        request.urlconf = settings.ADMIN_URLCONF
        prefix = settings.ADMIN_SCRIPT_NAME
        if not prefix:
            return self.get_response(request)
        previous = get_script_prefix()
        set_script_prefix(prefix + "/")
        request.path = prefix + request.path_info
        request.META["SCRIPT_NAME"] = prefix
        try:
            return self.get_response(request)
        finally:
            set_script_prefix(previous)
{%- endif %}
