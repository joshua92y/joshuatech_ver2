#!/usr/bin/env python
"""{{ pod_name }} 관리 명령 진입점 — 설정 모듈 기본값은 {{ pod_snake }}.settings(이미지 ENV도 같은 값)."""

import os
import sys


def main() -> None:
    os.environ.setdefault("DJANGO_SETTINGS_MODULE", "{{ pod_snake }}.settings")
    from django.core.management import execute_from_command_line

    execute_from_command_line(sys.argv)


if __name__ == "__main__":
    main()
