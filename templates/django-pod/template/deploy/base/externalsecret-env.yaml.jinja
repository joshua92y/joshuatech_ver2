# {{ pod_name }} 런타임 비밀 → Secret {{ pod_name }}-env(web · relay · {% if has_celery %}celery{% else %}CronJob{% endif %} · initContainer envFrom). 일반 리소스(hook 아님) · sync-wave -1.
# data[] 순번은 overlay 인덱스 패치의 인터페이스다 — prod overlay는 인덱스 replace마다 앞에 op: test(path /spec/data/N/secretKey ·
# value <이름>)를 둔다. 새 항목은 끝(8번부터)에만 덧붙인다. DB URL은 role 이름(<db>_app)에서 DB 이름을 파생해 조립한다(prod overlay가
# URL 문자열을 패치하지 않는다 · TLS 매개변수는 매니페스트가 보장한다).
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{ pod_name }}-env
  labels:
    app.kubernetes.io/name: {{ pod_name }}
  annotations:
    argocd.argoproj.io/sync-wave: "-1"
spec:
  refreshInterval: 5m
  refreshPolicy: Periodic
  secretStoreRef:
    kind: ClusterSecretStore
    name: vault-dev
  target:
    name: {{ pod_name }}-env
    creationPolicy: Owner
    template:
      engineVersion: v2
      mergePolicy: Replace
      data:
        {% raw %}DATABASE_URL: 'postgresql://{{ .db_username }}:{{ .db_password }}@pg-main-rw.data.svc:5432/{{ .db_username | trimSuffix "_app" }}?sslmode=verify-full&sslrootcert=/etc/pg/ca.crt'
        KAFKA_PASSWORD: '{{ .kafka_password }}'
        DRAGONFLY_URL: '{{ .dragonfly_url }}'
        AUTHENTIK_ISSUER: '{{ .authentik_issuer }}'
        AUTHENTIK_JWKS_URL: '{{ .authentik_jwks_url }}'
        SENTRY_DSN: '{{ .sentry_dsn }}'
        SECRET_KEY: '{{ .secret_key }}'{% endraw %}
  data:
    - secretKey: db_username
      remoteRef:
        key: dev/db/dev_{{ pod_snake }}/app
        property: username
    - secretKey: db_password
      remoteRef:
        key: dev/db/dev_{{ pod_snake }}/app
        property: password
    - secretKey: kafka_password
      remoteRef:
        key: dev/kafka/{{ pod_name }}
        property: password
    - secretKey: dragonfly_url
      remoteRef:
        key: dev/dragonfly/{{ pod_name }}
        property: url
    - secretKey: authentik_issuer
      remoteRef:
        key: dev/authentik/{{ pod_name }}
        property: issuer
    - secretKey: authentik_jwks_url
      remoteRef:
        key: dev/authentik/{{ pod_name }}
        property: jwks_url
    - secretKey: sentry_dsn
      remoteRef:
        key: dev/sentry/{{ pod_name }}
        property: dsn
    - secretKey: secret_key
      remoteRef:
        key: dev/django/{{ pod_name }}
        property: secret_key
