# {{ pod_name }} 로컬 의존 서비스(T072 D19 · contracts/pod-template.md §생성 트리 compose.dev.yml 행) — 로컬 실행 전용이다(ENV=test ·
# Kafka PLAINTEXT · DB sslmode=require — 절차는 README 「로컬 실행」). 시험은 compose를 쓰지 않는다(testcontainers — tests/conftest.py).
# 저장소에 비밀 0:
# - postgres 슈퍼유저 비밀번호는 셸 env POSTGRES_PASSWORD에서만 온다(이 파일에 값 없음 — 비어 있으면 postgres 이미지가 초기화를
#   거부하고 컨테이너가 끝난다).
# - Dragonfly 사용자는 nopass다(compose/dragonfly-dev.acl — 운영 aclfile과 같은 규칙에서 비밀번호만 뺐다 · 비인증 연결은 NOAUTH).
#   주 포트의 HTTP(인증 없는 상태 페이지 · /metrics · /profilez)는 운영 Deployment처럼 끈다(--primary_port_http_enabled=false).
# 포트는 127.0.0.1에만 연다. 호스트 포트가 이미 쓰이면 셸 env JT_DEV_POSTGRES_PORT · JT_DEV_DRAGONFLY_PORT · JT_DEV_KAFKA_PORT로
# 바꾼다(기본 5432 · 6379 · 9092 — Kafka 광고 리스너도 같은 값을 따른다).
# 하네스 gen-35가 `docker compose -f compose.dev.yml --profile "*" config --format json`(모든 프로필 — 프로필로 묶은 도구 서비스도)으로
# 이 꼴(127.0.0.1 · digest · aclfile 읽기 전용 · HTTP 끔 · pg-tls build)을 본다.
# 기동 · 정리(이 디렉터리에서):
#   read -rs POSTGRES_PASSWORD; export POSTGRES_PASSWORD
#   docker compose -f compose.dev.yml up -d --wait
#   docker compose -f compose.dev.yml down -v      # 컨테이너 · 네트워크 · 볼륨(DB 내용 포함)을 지운다
name: {{ pod_name }}-dev

services:
  postgres:
    # 시험과 같은 TLS 전용 PostgreSQL 18.6(tests/docker/pg-tls — 평문 TCP 거부 · 빌드 때 만드는 1회용 자체 서명 인증서)
    build: tests/docker/pg-tls
    environment:
      POSTGRES_PASSWORD: "${POSTGRES_PASSWORD:-}"
    ports:
      - "127.0.0.1:${JT_DEV_POSTGRES_PORT:-5432}:5432"
    healthcheck:
      # 초기화 중 임시 서버는 TCP를 열지 않는다 — TCP 127.0.0.1(TLS)로 받으면 본 서버가 뜬 것이다(up --wait가 기다린다)
      test: ["CMD", "pg_isready", "--host", "127.0.0.1", "--username", "postgres"]
      interval: 2s
      timeout: 5s
      retries: 60

  dragonfly:
    # 시험 픽스처(tests/conftest.py)와 같은 이미지 · 스레드 · 메모리 + aclfile(admin · {{ pod_name }} — nopass) + 주 포트 HTTP 끔
    image: ghcr.io/dragonflydb/dragonfly:v1.40.1@sha256:ebf3c6c213e82fb51b4521660cca13f06f3421dc5b1ed14f2f474c50b5e29986
    command: ["--proactor_threads=2", "--maxmemory=512mb", "--aclfile=/etc/dragonfly/users.acl", "--primary_port_http_enabled=false"]
    volumes:
      - ./compose/dragonfly-dev.acl:/etc/dragonfly/users.acl:ro
    ports:
      - "127.0.0.1:${JT_DEV_DRAGONFLY_PORT:-6379}:6379"

  kafka:
    # KRaft 단일 노드(broker + controller) · PLAINTEXT · 자격 없음 — 호스트 프로세스가 127.0.0.1:<포트>로 붙는다(광고 리스너)
    image: apache/kafka:4.3.1@sha256:77e3df9054047a88b520d0cc46e16696d3b22022e1d580aeccd2632df6532837
    environment:
      KAFKA_NODE_ID: "1"
      KAFKA_PROCESS_ROLES: broker,controller
      KAFKA_LISTENERS: PLAINTEXT://:9092,CONTROLLER://:9093
      KAFKA_ADVERTISED_LISTENERS: "PLAINTEXT://127.0.0.1:${JT_DEV_KAFKA_PORT:-9092}"
      KAFKA_CONTROLLER_LISTENER_NAMES: CONTROLLER
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@localhost:9093
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: "1"
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: "1"
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: "1"
      KAFKA_SHARE_COORDINATOR_STATE_TOPIC_REPLICATION_FACTOR: "1"
      KAFKA_SHARE_COORDINATOR_STATE_TOPIC_MIN_ISR: "1"
      KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS: "0"
      KAFKA_NUM_PARTITIONS: "3"
    ports:
      - "127.0.0.1:${JT_DEV_KAFKA_PORT:-9092}:9092"
