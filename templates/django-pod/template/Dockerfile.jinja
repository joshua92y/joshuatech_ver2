# {{ pod_name }} 컨테이너 이미지(T072 D18 · contracts/pod-template.md §생성 트리 Dockerfile 행) — uv 빌더 단계 → python:3.13-slim 런타임.
# 빌드는 저장소 루트에서 한다(컨텍스트 = 저장소 루트 — packages/django-common을 함께 COPY한다 · 규칙 django-pod.md §Template):
#   docker buildx build --platform linux/arm64 -f apps/{{ pod_name }}/Dockerfile -t {{ pod_name }}:<태그> .
#   build-arg APP_VERSION(기본 0.0.0+local) · APP_GIT_SHA(기본 0000000 — 소문자 hex 7–64자 · 기동 단언이 꼴을 본다) → ENV +
#   라벨 org.opencontainers.image.revision. 두 ARG는 COPY --from=builder 뒤(LABEL · ENV 바로 앞)에 둔다 — build-arg가 바뀌어도
#   useradd · COPY 층 캐시가 깨지지 않는다(앞에 두면 그 뒤 RUN이 build-arg를 env로 받아 층이 다시 만들어진다).
# 컨텍스트 거르기는 이 파일 옆 Dockerfile.dockerignore다 — pod 안까지 허용 목록(pod 패키지 · manage.py · pyproject.toml · uv.lock +
#   django-common pyproject.toml · src만 넣고 캐시 · venv · 비밀 후보를 다시 뺀다)이라 작업 트리와 무관하게 이미지의 /src/apps/{{ pod_name }}
#   최상위는 .venv · {{ pod_snake }} · manage.py · pyproject.toml · uv.lock뿐이다. BuildKit은 -f 파일 이름 + .dockerignore를 컨텍스트
#   루트 .dockerignore(`*`)보다 먼저 쓴다 — 이 파일을 다른 이름으로 복사해 빌드하면 빈 컨텍스트로 COPY에서 실패한다(닫힌 쪽).
# USER는 숫자 10001:10001이다 — kubelet은 이름 USER(예: app)를 숫자로 풀지 못해 runAsNonRoot를 판정하지 못한다. deploy/base
#   securityContext의 runAsUser · runAsGroup 10001과 같은 값이다.
# digest 갱신: FROM 두 줄은 태그 + 인덱스 digest로 고정한다(# syntax 줄 없음 — Renovate가 FROM을 직접 올린다). 빌더 uv 이미지 태그 ·
#   digest(uv:<ver>-python3.13-trixie-slim)는 CI setup-uv version(.github/workflows/ci.yml)과 로컬 uv를 같은 변경에서 함께 올린다.
#   빌더와 런타임의 PYTHON_VERSION이 같은지 확인한다(minor는 반드시 같다 — venv의 python 경로 · cp313 ABI).
# 런타임 단계는 빌더가 만든 /src/apps/{{ pod_name }}(.venv 포함)만 받는다 — uv sync --no-editable이 django-common을 venv
#   site-packages에 정규 설치하므로 /src/packages가 필요 없다 · --no-dev라 시험 의존(pytest · testcontainers …)은 없다.
#   collectstatic · HEALTHCHECK는 두지 않는다(프로브는 deploy/base). 기본 명령(CMD)은 web이고 deploy/base web은 명령을 덮지 않는다(같은
#   토큰만 허용 — 하네스 렌더 단언). CMD는 exec 꼴(JSON 배열)이고 ENTRYPOINT는 두지 않는다 — 셸 꼴이면 PID 1이 sh라 SIGTERM이 gunicorn에
#   닿지 않고(grace 끝에 SIGKILL), ENTRYPOINT가 있으면 deploy/base의 command + args가 실제 실행 명령이 아니게 된다(하네스 gen-33 이미지
#   판정). 루트 파일시스템은 읽기 전용으로 돈다 — 쓰기는 /tmp(emptyDir)뿐이다(gunicorn worker_tmp_dir · celery beat 일정 파일).
FROM ghcr.io/astral-sh/uv:0.13.7-python3.13-trixie-slim@sha256:6ff812e34a0e14b4b8bc9ddf25e77b3e16bac6e0c4d9b67641f40366fa382d4c AS builder
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /src/apps/{{ pod_name }}
COPY packages/django-common/pyproject.toml /src/packages/django-common/pyproject.toml
COPY packages/django-common/src /src/packages/django-common/src
COPY apps/{{ pod_name }}/pyproject.toml apps/{{ pod_name }}/uv.lock ./
RUN uv sync --locked --no-install-project --no-dev --no-editable
COPY apps/{{ pod_name }}/ ./
RUN uv sync --locked --no-dev --no-editable

FROM python:3.13-slim-trixie@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90
RUN groupadd --system --gid 10001 app && useradd --system --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin app
WORKDIR /src/apps/{{ pod_name }}
COPY --from=builder /src/apps/{{ pod_name }} /src/apps/{{ pod_name }}
ARG APP_VERSION=0.0.0+local
ARG APP_GIT_SHA=0000000
LABEL org.opencontainers.image.revision=$APP_GIT_SHA
ENV PATH=/src/apps/{{ pod_name }}/.venv/bin:$PATH PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DJANGO_SETTINGS_MODULE={{ pod_snake }}.settings APP_VERSION=$APP_VERSION APP_GIT_SHA=$APP_GIT_SHA
USER 10001:10001
EXPOSE 8000 9100 9464
CMD ["gunicorn", "--config", "python:{{ pod_snake }}.gunicorn_conf", "--no-control-socket", "{{ pod_snake }}.wsgi:application"]
