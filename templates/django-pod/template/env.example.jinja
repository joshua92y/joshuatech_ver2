# {{ pod_name }} 런타임 env — 키만 둔다(값은 저장소에 두지 않는다 · contracts/pod-template.md §생성 트리 env.example 행).
# 운영: 비밀은 ExternalSecret <pod>-env(Vault) · 나머지는 ConfigMap <pod>-config(deploy/base). 로컬 실행은 ENV=test다(README).
# DATABASE_OWNER_URL은 migrate Job(<pod>-migrate) 전용이라 여기에 없다 · 메일은 MAILERS만(EMAIL_* 없음) · POD_* 는 downward API다.

# 비밀(빈 값 = 기동 실패) · 자격 URL(사용자 정보는 [A-Za-z0-9_-]만)
DATABASE_URL=
DRAGONFLY_URL=
KAFKA_PASSWORD=
SECRET_KEY=

# Kafka · Authentik(JWKS = 클러스터 안 svc DNS · ISSUER = 공개 URL 문자열)
KAFKA_BOOTSTRAP=
KAFKA_USERNAME=
AUTHENTIK_ISSUER=
AUTHENTIK_JWKS_URL=
AUTHENTIK_AUDIENCE=

# Cloudflare Access · 호스트(ACCESS_AUD_ADMIN · ADMIN_HOST · AUTH_ACTOR_SUB는 빈 값이 유효하다)
ACCESS_TEAM_DOMAIN=
ACCESS_AUD_M2M=
ACCESS_AUD_ADMIN=
ACCESS_EXPECTED_CN=
AUTH_ACTOR_SUB=
ADMIN_HOST=
ALLOWED_HOSTS=
{%- if has_admin %}
FORCE_SCRIPT_NAME=
{%- endif %}

# 관측(SENTRY_DSN 빈 값 = 끔 · OTEL 엔드포인트 빈 값 = 내보내기 끔)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER=
OTEL_TRACES_SAMPLER_ARG=

# 환경 · 빌드(APP_VERSION · APP_GIT_SHA는 이미지 ENV가 준다 — 이미지 밖에서 돌릴 때만 둔다)
ENV=
APP_VERSION=
APP_GIT_SHA=
