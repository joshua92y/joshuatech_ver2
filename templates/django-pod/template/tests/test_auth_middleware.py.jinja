def test_error_handlers_declared_in_every_urlconf() -> None:
    """pod가 라우팅하는 urlconf마다 handler400/403/404/500 = {{ pod_snake }}.errors의 처리기(Django는 요청의 urlconf에서 처리기를
    찾는다) · probe urlconf는 그 값을 그대로 복사했다(아래 probe 시험이 pod 처리기를 본다)."""
    from {{ pod_snake }} import errors, urls
{%- if has_admin %}
    from {{ pod_snake }} import urls_admin
{%- endif %}

    import tests.probe_urls
{%- if has_admin %}
    import tests.probe_admin_urls
{%- endif %}

    expected = {
        "handler400": errors.bad_request,
        "handler403": errors.permission_denied,
        "handler404": errors.page_not_found,
        "handler500": errors.server_error,
    }
    pairs = [(urls, tests.probe_urls){% if has_admin %}, (urls_admin, tests.probe_admin_urls){% endif %}]
    for pod_urlconf, probe_urlconf in pairs:
        declared = {name: import_string(getattr(pod_urlconf, name)) for name in expected}
        assert declared == expected, pod_urlconf.__name__
        copied = {name: getattr(probe_urlconf, name) for name in expected}
        assert copied == {name: getattr(pod_urlconf, name) for name in expected}, probe_urlconf.__name__


