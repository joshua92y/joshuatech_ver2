def test_boot_force_script_name_sets_absolute_static_url() -> None:
    """env FORCE_SCRIPT_NAME=/{{ pod_name }} + ADMIN_HOST → ADMIN_SCRIPT_NAME = 접두 · STATIC_URL = 절대
    /{{ pod_name }}/static/ · Django 전역 FORCE_SCRIPT_NAME None · 기동 직후 script prefix "/" · CSRF_TRUSTED_ORIGINS =
    https://<ADMIN_HOST> / env 없음(래퍼) → ADMIN_SCRIPT_NAME 빈 값 · ADMIN_HOST 빈 값(존재만 — 유효) · CSRF_TRUSTED_ORIGINS 빈
