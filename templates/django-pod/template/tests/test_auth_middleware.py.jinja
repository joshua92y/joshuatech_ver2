def _runtime_env_names() -> tuple[str, ...]:
    """migrate Job env에 없는 런타임 키 — 시험 래퍼가 덮어쓴 필수 키(Django 설정 POD_SETTINGS_ENV)."""
    from django.conf import settings

    return tuple(settings.POD_SETTINGS_ENV)


def test_boot_migrate_profile_needs_only_owner_url() -> None:
    """migrate 프로필(JT_SETTINGS_PROFILE=migrate · 런타임 키 없음 · ENV 없음 → verify-full 강제)이 DATABASE_OWNER_URL만으로 기동 —
    profile migrate · ENV 없음 · 런타임 설정(DRAGONFLY_URL · KAFKA_CLIENT_CONFIG · AUTHENTIK_JWKS_URL) 없음 · celery 미import ·
    DB 사용자 = owner · 이름 조회 0."""
    facts = boot_facts(
        boot(_migrate_overrides(f"sslmode=verify-full&sslrootcert={PG_CA_FILE}"), remove=_runtime_env_names()),
        network_zero=True,
    )
    assert (facts["profile"], facts["env"]) == ("migrate", None)
    assert facts["runtime_settings"] == []
    assert facts["celery_imported"] is False
    assert facts["db_user"] == f"{POD_SNAKE}_owner"


