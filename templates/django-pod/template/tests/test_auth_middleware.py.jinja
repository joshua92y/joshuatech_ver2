def _overriding_case(case: str) -> tuple[str, str]:
    """(env 이름, 값) — 브로커 · 결과 URL은 공개 호스트 + 새 난수 비밀번호(위생이 그 URL · 비밀번호 부재를 본다) · gunicorn은 워커 수 ·
    preload를 덮는 인자 · `-empty` 사례는 빈 값(빈 값도 거부 — 있는 것 자체가 오설정이다)."""
    name = case.removesuffix("-empty").upper().replace("-", "_")
    if case.endswith("-empty"):
        return name, ""
    if name == "GUNICORN_CMD_ARGS":
        return name, "--workers 4 --preload"
    return name, f"redis://{POD_NAME}:{secrets.token_urlsafe(24)}@cache.{PUBLIC}:6379/0"


