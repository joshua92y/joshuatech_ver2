    monkeypatch.setattr(conf, "IN_CLUSTER_URL_SETTINGS", (*conf.IN_CLUSTER_URL_SETTINGS, "PROBE_MISSING_URL"))
    missing_field = _load_refusal(base)
    assert missing_field == ["PROBE_MISSING_URL"]


def _documented_violation(case: str, base: Mapping[str, str]) -> tuple[dict[str, str], str]:
    database = base["DATABASE_URL"]
    cases: dict[str, tuple[dict[str, str], str]] = {
        "allowed-hosts-star": ({"ALLOWED_HOSTS": "*"}, "ALLOWED_HOSTS"),
        "allowed-hosts-empty-item": ({"ALLOWED_HOSTS": f"{HOST},"}, "ALLOWED_HOSTS"),
        "database-query-target-session-attrs": (
            {"DATABASE_URL": f"{database}&target_session_attrs=any"},
            "DATABASE_URL",
        ),
        "database-query-options": ({"DATABASE_URL": f"{database}&options=-c%20statement_timeout%3D0"}, "DATABASE_URL"),
        "test-env-sslmode-disable": (
            {"DATABASE_URL": database.replace("sslmode=require", "sslmode=disable")},
            "DATABASE_URL",
        ),
        "git-sha-uppercase": ({"APP_GIT_SHA": "ABCDEF0"}, "APP_GIT_SHA"),
        "git-sha-too-short": ({"APP_GIT_SHA": "abcdef"}, "APP_GIT_SHA"),
        "kafka-bootstrap-without-port": ({"KAFKA_BOOTSTRAP": "kafka-bootstrap"}, "KAFKA_BOOTSTRAP"),
    }
    return cases[case]


@pytest.mark.parametrize(
    "case",
    [
        "allowed-hosts-star",
        "allowed-hosts-empty-item",
        "database-query-target-session-attrs",
        "database-query-options",
        "test-env-sslmode-disable",
        "git-sha-uppercase",
        "git-sha-too-short",
        "kafka-bootstrap-without-port",
    ],
)
def test_settings_load_refuses_documented_violations(case: str) -> None:
    """계약 · D5 거부 규칙의 회귀 보호(기준 = 래퍼 env · ENV=test에서 하나만 바꾼다): ALLOWED_HOSTS `*` · 빈 항목 · DATABASE_URL 쿼리
    키는 sslmode · sslrootcert만(target_session_attrs · options 거부 — Django 설정이 버려 조용히 무시되는 오설정이 되지 않게) ·
    ENV=test도 sslmode는 require 이상(disable 거부) · APP_GIT_SHA는 소문자 hex 7–64(대문자 · 7자 미만 거부 — r3 J3) ·
    KAFKA_BOOTSTRAP은 host:port 목록 → conf.load(environ=…)의 거부 이름이 정확히 그 설정이다."""
    base = _wrapper_environ()
    premise = base.get("ENV") == "test" and "?sslmode=require" in base.get("DATABASE_URL", "")
    assert premise, "기준 매핑의 전제(ENV=test · DATABASE_URL 쿼리 sslmode=require 하나)가 아니다"
    changes, name = _documented_violation(case, base)
    refused = _load_refusal({**base, **changes})
    assert refused == [name]


