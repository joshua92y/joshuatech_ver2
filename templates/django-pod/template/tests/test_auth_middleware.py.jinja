@DB
@pytest.mark.usefixtures("auth_settings", "dragonfly_clean")
def test_bearer_expired_or_for_another_audience_is_401(jwks_server: JwksInfo) -> None:
    """Bearer exp 과거 → 401 invalid_token · Bearer aud = 다른 pod → 401 invalid_token(Access는 유효)."""
    client = Client()
    access = _access(jwks_server)
    now = int(time.time())
    for case, bearer in {
        "expired": _bearer(jwks_server, iat=now - 360, exp=now - 60),
        "other-audience": _bearer(jwks_server, aud="other-pod"),
    }.items():
        response = _get(client, OPENAPI_PATH, _headers(access=access, bearer=bearer))
        assert response.status_code == 401, case
        assert_problem(response, 401, "invalid_token")


