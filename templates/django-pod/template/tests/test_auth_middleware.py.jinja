def test_settings_model_never_repeats_input() -> None:
    """설정 모델(hide_input_in_errors=True): 잘못된 값의 ValidationError 문자열 표현에 입력 값 · `input_value=`가 없다(이름 ENV만
    싣는다) · 비밀 필드(SECRET_KEY · DATABASE_URL · DRAGONFLY_URL · KAFKA_PASSWORD)는 모델 repr에 없다."""
    from pydantic import ValidationError

    from {{ pod_snake }} import conf

    planted = Secret(secrets.token_urlsafe(48))
    failure: ValidationError | None = None
    try:
        conf.RuntimeEnv.model_validate({"ENV": planted})
    except ValidationError as exc:
        failure = exc
    assert failure is not None
    text = str(failure)
    repeated = planted in text or PYDANTIC_INPUT_MARK in text
    assert not repeated, "설정 모델 오류 표현이 입력 값을 되풀이한다(hide_input_in_errors)"
    assert {str(item["loc"][0]) for item in failure.errors(include_input=False)} == {"ENV"}
    secret_names = ("SECRET_KEY", "DATABASE_URL", "DRAGONFLY_URL", "KAFKA_PASSWORD")
    model_repr = repr(conf.RuntimeEnv())
    assert_absent("설정 모델 repr", model_repr, *(os.environ[name] for name in secret_names))


def test_settings_load_validates_given_mapping_only() -> None:
    """conf.load(environ=매핑)(시험용 진입점)은 그 매핑만 검증한다 — 이 프로세스 env의 값이 섞이지 않는다(BaseSettings는
    model_validate · 생성자 인자에도 env 소스를 합친다): SECRET_KEY가 없는 매핑 → ImproperlyConfigured("설정 오류: SECRET_KEY") ·
    연쇄 예외(__cause__ · __context__) 없음 / 매핑 전체 → runtime 프로필로 읽힌다."""
    from {{ pod_snake }} import conf

    # 래퍼가 채웠다 — 섞이면 아래 거부가 통과로 바뀐다(bool로 접는다: 단언 식의 os.environ은 실패 출력에 env 전체를 찍는다 — r3 J1)
    wrapped = "SECRET_KEY" in os.environ
    assert wrapped, "시험 래퍼가 SECRET_KEY를 채우지 않았다"
    without_key = {name: value for name, value in _wrapper_environ().items() if name != "SECRET_KEY"}
    refused: ImproperlyConfigured | None = None
    try:
        conf.load(environ=without_key)
    except ImproperlyConfigured as exc:
        refused = exc
    assert refused is not None, "conf.load(environ=…)가 매핑에 없는 SECRET_KEY를 process env에서 읽었다"
    assert str(refused) == "설정 오류: SECRET_KEY"
    assert (refused.__cause__, refused.__context__) == (None, None)
    loaded = conf.load(environ=_wrapper_environ())
    assert loaded.profile == conf.RUNTIME


# --- conf.load(environ=…) 거부 규칙(같은 모델 · 교차 규칙 · process env 섞임 없음 — 하위 프로세스 없이 빠르게) ---------------------------


def _wrapper_environ() -> dict[str, str]:
    """시험 래퍼가 채운 설정 env(ENV=test · 닫힌 포트 자리값) — conf.load(environ=…)가 그대로 통과하는 기준 매핑. 래퍼가 정한 이름
    (래퍼 상수 POD_SETTINGS_ENV — _runtime_env_names)만 싣는다: 개발자 · CI 셸의 다른 env는 들어가지 않는다(T072 ② r3 J1 · B-1).
    래퍼가 지운 이름(선택 설정 · 프로필 · OTLP 엔드포인트 — POD_SETTINGS_ENV_REMOVED)은 process env에도 없으므로 결과는 같다. 이
    매핑(자리값 비밀 포함)을 넘기는 호출은 단언 밖에서 지역 변수로 받는다 — 단언 재작성은 단언 식 안 호출의 인자를 실패 출력에 찍는다."""
    return {name: os.environ[name] for name in _runtime_env_names() if name in os.environ}


def _load_refusal(environ: Mapping[str, str]) -> list[str] | None:
    """conf.load(environ=environ)의 거부 이름(정렬 · 「설정 오류: <이름들>」 꼴) — 통과하면 None."""
    from {{ pod_snake }} import conf

    refused: ImproperlyConfigured | None = None
    try:
        conf.load(environ=environ)
    except ImproperlyConfigured as exc:
        refused = exc
    if refused is None:
        return None
    text = str(refused)
    shaped = text.startswith(REFUSAL_PREFIX)
    assert shaped, "거부 문구가 「설정 오류: <이름들>」 꼴이 아니다"
    return sorted(part.strip() for part in text.removeprefix(REFUSAL_PREFIX).split(","))


def _with_host(value: str, host: str) -> str:
    """URL value의 호스트만 host로 바꾼다(스킴 · 사용자 정보 · 포트 · 경로 · 질의는 그대로 — 다른 규칙이 함께 걸리지 않게)."""
    parts = urlsplit(value)
    userinfo, at, _ = parts.netloc.rpartition("@")
    port = f":{parts.port}" if parts.port is not None else ""
    return urlunsplit(parts._replace(netloc=f"{userinfo}{at}{host}{port}"))


def _public_value(name: str, base: Mapping[str, str], host: str) -> str:
    """IN_CLUSTER_URL_SETTINGS 이름의 공개 호스트 값 — KAFKA_BOOTSTRAP은 host:port 목록, 나머지는 기준 URL(없으면 https URL)의
    호스트만 바꾼다."""
    if name == "KAFKA_BOOTSTRAP":
        return f"{host}:9093"
    return _with_host(base.get(name) or "https://placeholder.invalid/", host)


@pytest.mark.parametrize("name", IN_CLUSTER_URL_SETTINGS, ids=_kebab)
def test_settings_load_refuses_public_in_cluster_url(name: str) -> None:
    """conf.IN_CLUSTER_URL_SETTINGS의 이름마다(목록에서 직접 매개화 — T073 · SP-2가 넓힌 이름도 스스로 검증된다): 기준 매핑(래퍼
    env)은 통과하고, 그 이름 하나만 공개 도메인 호스트(하위 소문자 · apex 대문자)로 바꾸면 conf.load(environ=…)의 거부 이름이 정확히
    그 이름이다(DATABASE_URL · DRAGONFLY_URL · KAFKA_BOOTSTRAP 밖의 이름은 http(s) URL로 일반 계산한다 — FR-046)."""
    base = _wrapper_environ()
    baseline = _load_refusal(base)
    assert baseline is None, f"기준 매핑이 거부됐다 {baseline} — 넓힌 이름은 모델 필드와 래퍼 자리값이 함께 필요하다"
    for host in (f"svc.{PUBLIC}", PUBLIC.upper()):
        refused = _load_refusal({**base, name: _public_value(name, base, host)})
        assert refused == [name], f"{name}: 공개 호스트 {host!r}의 거부 이름 {refused}(기대 [{name!r}])"


def test_in_cluster_url_settings_extension_is_checked(monkeypatch: pytest.MonkeyPatch) -> None:
    """확장 지점(T073 · SP-2가 모델 필드와 IN_CLUSTER_URL_SETTINGS에 함께 더하는 http(s) URL 설정 — 여기서는 시험용 필드
    PROBE_API_URL): 클러스터 안 호스트는 통과 · 공개 도메인(하위 · apex 대문자)이면 그 이름만 거부 · URL 꼴이 아니면 그 이름 거부 /
    목록에만 있고 모델 필드가 없는 이름도 거부(닫힌 쪽 — SECRET_SETTINGS와 같다). 따로 파싱하는 셋 밖의 이름이 조용히 빠지지
    않는다(옛 코드는 이 이름들을 검사하지 않았다 — A-1)."""
    from {{ pod_snake }} import conf

    class ProbeEnv(conf.RuntimeEnv):
        PROBE_API_URL: str

    monkeypatch.setattr(conf, "RuntimeEnv", ProbeEnv)
