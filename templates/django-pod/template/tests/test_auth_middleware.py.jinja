@pytest.mark.usefixtures("auth_settings", "dragonfly_clean")
def test_admin_audience_accepted_only_when_configured(jwks_server: JwksInfo, settings: SettingsWrapper) -> None:
    """ACCESS_AUD_ADMIN 빈 값(래퍼 기본 — admin AUD 없음) → admin aud 토큰 403 / 설정하면(새 Client) admin aud 200 · M2M aud도 200."""
    assert settings.ACCESS_AUD_ADMIN == ""
    bearer = _bearer(jwks_server)
    admin_access = _access(jwks_server, aud=[ADMIN_AUDIENCE])
    assert_problem(_get(Client(), OPENAPI_PATH, _headers(access=admin_access, bearer=bearer)), 403, "access_required")
    settings.ACCESS_AUD_ADMIN = ADMIN_AUDIENCE
    client = Client()
    admin_response = _get(client, OPENAPI_PATH, _headers(access=admin_access, bearer=bearer))
    assert admin_response.status_code == 200
    m2m_response = _get(client, OPENAPI_PATH, _headers(access=_access(jwks_server), bearer=bearer))
    assert m2m_response.status_code == 200


