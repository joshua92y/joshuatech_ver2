def _access(jwks: JwksInfo, **overrides: Any) -> str:
    """Access 키로 서명한 Cf-Access-Jwt-Assertion(기본 = 유효 서비스 토큰)."""
    return mint(access_claims(**overrides), jwks.access_key, ACCESS_KID)


def _bearer(jwks: JwksInfo, **overrides: Any) -> str:
    """Authentik 키로 서명한 Bearer 토큰(기본 = 유효 · tenant_id = 테넌트 A)."""
    return mint(bearer_claims(**overrides), jwks.authentik_key, AUTHENTIK_KID)


def _headers(host: str = HOST, *, access: str | None = None, bearer: str | None = None) -> dict[str, str]:
    headers = {"host": host}
    if access is not None:
        headers["Cf-Access-Jwt-Assertion"] = access
    if bearer is not None:
        headers["Authorization"] = f"Bearer {bearer}"
    return headers


def _valid(jwks: JwksInfo, host: str = HOST) -> dict[str, str]:
    """유효한 Access(서비스 토큰) + Bearer(테넌트 A) 헤더."""
    return _headers(host, access=_access(jwks), bearer=_bearer(jwks))


def _closed_port() -> int:
    """연결을 받지 않는 127.0.0.1 포트 — bind로 번호만 받고 닫는다."""
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as probe:
        probe.bind(("127.0.0.1", 0))
        port: int = probe.getsockname()[1]
    return port


def _fail_without_trace(what: str, exc: BaseException) -> NoReturn:
    """예외를 원 트레이스백 · 메시지 없이 실패로 바꾼다(형식 이름만 — 호출자는 except 블록 밖에서 부른다)."""
    kind = f"{type(exc).__module__}.{type(exc).__name__}"
    pytest.fail(f"{what}: 예외로 끝났다({kind}) — 원 트레이스백 · 메시지는 비밀 노출을 막으려고 싣지 않는다", pytrace=False)


def _call(what: str, request: Callable[[], HttpResponse]) -> HttpResponse:
    failure: BaseException | None = None
    try:
        return request()
    except Exception as exc:  # noqa: BLE001 — 어떤 예외든 원 트레이스백 없이 실패로 바꾼다
        failure = exc
    _fail_without_trace(what, failure)


def _get(client: Client, path: str, headers: dict[str, str]) -> HttpResponse:
    return _call(f"GET {path}", lambda: client.get(path, headers=headers))


def _post(client: Client, path: str, headers: dict[str, str], body: str, content_type: str) -> HttpResponse:
    return _call(f"POST {path}", lambda: client.post(path, data=body, content_type=content_type, headers=headers))


def _timed_get(client: Client, path: str, headers: dict[str, str]) -> tuple[HttpResponse, float]:
    """GET 한 번과 그 경과(초) — 요청은 데몬 스레드에서 돌고 HANG_LIMIT_S 안에 끝나지 않으면 실패로 끝낸다. 작업 스레드의 DB
    연결은 끝날 때 닫는다."""
    outcome: list[HttpResponse | BaseException] = []

    def run() -> None:
        try:
            outcome.append(client.get(path, headers=headers))
        except BaseException as exc:  # noqa: BLE001 — 스레드 경계: 어떤 예외든 호출 스레드로 넘긴다
            outcome.append(exc)
        finally:
            connections.close_all()

    worker = threading.Thread(target=run, name="auth-timed-get", daemon=True)
    start = time.perf_counter()
    worker.start()
    worker.join(HANG_LIMIT_S)
    elapsed = time.perf_counter() - start
    if worker.is_alive():
        pytest.fail(f"GET {path}가 {HANG_LIMIT_S:.0f} s 안에 끝나지 않았다 — 의존 조회에 시간 초과가 없는 구현인가")
    result = outcome[0]
    if isinstance(result, BaseException):
        _fail_without_trace(f"GET {path}", result)
    return result, elapsed


def _response_text(response: HttpResponse) -> str:
    headers = "\n".join(f"{name}: {value}" for name, value in response.items())
    return f"{response.content.decode('utf-8', errors='replace')}\n{headers}"


def _assert_django_errors(client: Client, headers: dict[str, str]) -> None:
    """probe urlconf(tests.probe_urls · tests.probe_admin_urls — 처리기는 pod urlconf의 것을 복사)의 Django 자체 오류가 모두
    problem+json이다(detail 없음). client는 raise_request_exception=False(500을 응답으로 받는다)."""
    urlencoded = "application/x-www-form-urlencoded"
    cases: list[tuple[str, Callable[[], HttpResponse], int, str]] = [
        ("bad-request", lambda: client.get("/probe/bad-request", headers=headers), 400, "validation_error"),
        ("suspicious", lambda: client.get("/probe/suspicious", headers=headers), 400, "validation_error"),
        (
            "request-data-too-big",
            lambda: client.post("/probe/read-body", data="x=" + "a" * (BODY_LIMIT * 2), content_type=urlencoded,
                                headers=headers),
            400,
            "validation_error",
        ),
        ("permission-denied", lambda: client.get("/probe/forbidden", headers=headers), 403, "forbidden"),
        ("no-such-url", lambda: client.get("/probe/no-such-path", headers=headers), 404, "not_found"),
        ("unhandled", lambda: client.get("/probe/boom", headers=headers), 500, "internal_error"),
    ]
    for case, request, status, slug in cases:
        response = _call(case, request)
        assert response.status_code == status, case
        body = assert_problem(response, status, slug)
        assert "detail" not in body, case
    small = _post(client, "/probe/read-body", headers, "x=1", urlencoded)
    assert small.status_code == 204  # 한도 안의 본문은 통과한다 — 위 400은 크기 때문이다


