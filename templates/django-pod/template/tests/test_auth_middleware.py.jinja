def _improperly_configured(call: Callable[[], object]) -> str:
    failure: ImproperlyConfigured | None = None
    try:
        call()
    except ImproperlyConfigured as exc:
        failure = exc
    assert failure is not None, "ImproperlyConfigured가 나지 않았다"
    return str(failure)


