def _prod_shape() -> dict[str, str]:
    """dev 모양 위에 덮는 prod 값 — 클러스터 교차 규칙(ENV=prod · jt-prod · Kafka 사용자 = pod 이름 · DB 사용자 접두 없음 · svc 이름)."""
    verify_full = f"sslmode=verify-full&sslrootcert={PG_CA_FILE}"
    return {
        "POD_NAMESPACE": "jt-prod",
        "ENV": "prod",
        "KAFKA_USERNAME": POD_NAME,
        "DATABASE_URL": db_url(f"{POD_SNAKE}_app", POD_SNAKE, host="pg-main-rw.data.svc:5432", query=verify_full),
        "ALLOWED_HOSTS": f"{POD_NAME}.jt-prod.svc",
    }


def test_boot_prod_shape_passes_cluster_rules() -> None:
    """클러스터 교차 규칙 양성 — prod 모양(dev 모양 위에 POD_NAMESPACE=jt-prod · ENV=prod · KAFKA_USERNAME={{ pod_name }} ·
    {{ pod_snake }}_app/{{ pod_snake }} + verify-full · {{ pod_name }}.jt-prod.svc) → 기동 통과 · 이름 조회 0 · 위생 · prod 토픽 접두 ""(prod
    이벤트가 dev. 토픽으로 가지 않는다 — prod KafkaUser ACL은 <pod>. 접두만 연다) · Kafka 사용자 = pod 이름 · CA =
    /etc/kafka/ca.crt · DB 사용자 = {{ pod_snake }}_app."""
    env = dev_shape_env()
    env.update(_prod_shape())
    facts = boot_facts(boot(env), network_zero=True)
    assert (facts["profile"], facts["env"]) == ("runtime", "prod")
    assert facts["outbox_topic_prefix"] == ""
    assert facts["kafka_sasl_username"] == POD_NAME
    assert facts["kafka_ca_location"] == "/etc/kafka/ca.crt"
    assert facts["db_user"] == f"{POD_SNAKE}_app"
    assert facts["allowed_hosts"] == [f"{POD_NAME}.jt-prod.svc"]


def _cluster_case(case: str) -> tuple[dict[str, str], tuple[str, ...]]:
    env = dev_shape_env()
    verify_full = f"sslmode=verify-full&sslrootcert={PG_CA_FILE}"
    prod_db = db_url(f"{POD_SNAKE}_app", POD_SNAKE, host="pg-main-rw.data.svc:5432", query=verify_full)
    prod_svc = f"{POD_NAME}.jt-prod.svc"
    changes: dict[str, tuple[dict[str, str], tuple[str, ...]]] = {
        "namespace-not-jt-env": ({"POD_NAMESPACE": "jt-prod", "ALLOWED_HOSTS": prod_svc}, ("POD_NAMESPACE",)),
        "prod-with-dev-kafka-user": (
            {"ENV": "prod", "POD_NAMESPACE": "jt-prod", "ALLOWED_HOSTS": prod_svc, "DATABASE_URL": prod_db},
            ("KAFKA_USERNAME",),
        ),
        "db-user-without-dev-prefix": (
            {"DATABASE_URL": prod_db.replace(f"/{POD_SNAKE}?", f"/dev_{POD_SNAKE}?")},
            ("DATABASE_URL",),
        ),
        "svc-name-missing": ({"ALLOWED_HOSTS": "other-pod.jt-dev.svc"}, ("ALLOWED_HOSTS",)),
        "test-env-in-cluster": ({"ENV": "test"}, ("ENV", "POD_NAMESPACE")),
    }
    overrides, names = changes[case]
    env.update(overrides)
    return env, names


@pytest.mark.parametrize(
    "case",
    [
        "namespace-not-jt-env",
        "prod-with-dev-kafka-user",
        "db-user-without-dev-prefix",
        "svc-name-missing",
        "test-env-in-cluster",
    ],
)
def test_boot_refuses_cluster_cross_rule_violation(case: str) -> None:
    """클러스터 교차 규칙 음성(dev 모양에서 하나만 바꾼다): POD_NAMESPACE ≠ jt-<ENV> · ENV=prod에 dev- Kafka 사용자 · dev에 dev_ 없는
    DB 사용자 · ALLOWED_HOSTS에 <pod>.<ns>.svc 없음 · 클러스터 안 ENV=test → 기동 실패 · 거부 이름 정확히(그 규칙만) · 위생."""
    env, names = _cluster_case(case)
    assert_refused(boot(env), *names)
