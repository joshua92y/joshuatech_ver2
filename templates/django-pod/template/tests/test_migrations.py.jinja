def _job_script() -> str:
    """deploy/base/migrate-job.yaml(pyyaml)의 Job 하나 · migrate 컨테이너 하나의 command + args = ["python", "-c", <스크립트>] — 그
    스크립트(값이 없는 고정 문자열이라 실패 출력에 실려도 된다)."""
    documents = [doc for doc in yaml.safe_load_all(MIGRATE_JOB.read_text(encoding="utf-8")) if doc is not None]
    jobs = [doc for doc in documents if isinstance(doc, dict) and doc.get("kind") == "Job"]
    assert len(jobs) == 1, f"migrate-job.yaml의 Job 문서 {len(jobs)}개(기대 1)"
    containers = jobs[0]["spec"]["template"]["spec"]["containers"]
    commands = [
        [*container.get("command", []), *container.get("args", [])]
        for container in containers
        if container.get("name") == MIGRATE_CONTAINER
    ]
    assert len(commands) == 1, f"{MIGRATE_CONTAINER} 컨테이너 {len(commands)}개(기대 1)"
    command = commands[0]
    shape = [*command[:2], type(command[2]).__name__ if len(command) > 2 else None, len(command)]
    assert shape == ["python", "-c", "str", 3], f"migrate 명령 꼴 {shape}(기대 python -c <스크립트>)"
    return command[2]


def _job_env(owner_url: str | None, **overrides: str) -> dict[str, str]:
    """migrate Job 컨테이너 꼴의 하위 프로세스 env — 셸 env는 허용 목록(JOB_BASE_ENV)만 물려주고 DATABASE_OWNER_URL(<pod>-migrate — None이면
    없음) · JT_SETTINGS_PROFILE=migrate(Job env) · DJANGO_SETTINGS_MODULE(이미지 ENV와 같은 값) + overrides. 마감 env
    JT_DB_CONNECT_WAIT_SECONDS는 매니페스트처럼 두지 않는다(스크립트 기본 120 — T072 마지막 라운드 N2(2)) — 시험이 overrides로 줄 때만 있다."""
    env = {name: value for name, value in os.environ.items() if name.upper() in JOB_BASE_ENV}
    env.update(
        JT_SETTINGS_PROFILE="migrate",
        DJANGO_SETTINGS_MODULE=POD_SETTINGS,
        PYTHONIOENCODING="utf-8",
    )
    if owner_url is not None:
        env["DATABASE_OWNER_URL"] = owner_url
    env.update(overrides)
    return env


def _connect_grantees(pg: PgInfo) -> frozenset[str]:
    """시험 DB ACL(pg_database.datacl)에서 CONNECT를 받는 grantee — PUBLIC 의사 role은 'PUBLIC'(owner 연결로 읽는다)."""
    with pg.connect("owner") as conn:
        rows = conn.execute(
            "SELECT CASE WHEN a.grantee = 0 THEN %s ELSE pg_catalog.pg_get_userbyid(a.grantee)::text END"
            " FROM pg_catalog.pg_database d CROSS JOIN LATERAL pg_catalog.aclexplode(d.datacl) a"
            " WHERE d.datname = %s AND a.privilege_type = 'CONNECT'",
            [PUBLIC, pg.dbname],
        ).fetchall()
    return frozenset(row[0] for row in rows)


def _public_can_connect(pg: PgInfo) -> bool:
    """PUBLIC 의사 role(권한을 하나도 받지 않은 새 role이 받는 권한)이 시험 DB에 CONNECT할 수 있는가."""
    with pg.connect("owner") as conn:
        row = conn.execute("SELECT pg_catalog.has_database_privilege('public', %s, 'CONNECT')", [pg.dbname]).fetchone()
    return bool(row and row[0])


def _grant_public_connect(pg: PgInfo) -> None:
    """PUBLIC CONNECT를 되돌린다(conftest가 만든 세션 DB 상태 — DB 소유자 owner로 · 멱등)."""
    with pg.connect("owner") as conn:
        conn.execute(sql.SQL("GRANT CONNECT ON DATABASE {} TO PUBLIC").format(sql.Identifier(pg.dbname)))


def _closed_port() -> int:
    """127.0.0.1의 빈 포트(잡았다 놓은 포트 — 그 사이 다른 프로세스가 잡을 확률은 무시한다)."""
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as probe:
        probe.bind(("127.0.0.1", 0))
        return int(probe.getsockname()[1])


def _operational_error_names() -> frozenset[str]:
    """psycopg.OperationalError와 그 하위 클래스 전부의 이름 — 스크립트의 재시도 경로(except psycopg.OperationalError)가 싣는 클래스
    이름이다(그 밖의 예외는 다른 경로 — 즉시 실패)."""
    import psycopg

    names: set[str] = set()
    pending: list[type] = [psycopg.OperationalError]
    while pending:
        cls = pending.pop()
        if cls.__name__ not in names:
            names.add(cls.__name__)
            pending.extend(cls.__subclasses__())
    return frozenset(names)


def _line_class(pattern: re.Pattern[str], line: str) -> str | None:
    """pattern에 통째로 맞는 줄이면 그 예외 클래스 이름(첫 무리), 아니면 None."""
    match = pattern.fullmatch(line)
    return match.group(1) if match else None


