_URL_PASSWORD_RE = re.compile(r"://[^/@:\s]*:([^@/\s]+)@")


def _redact(text: str, env: Mapping[str, str]) -> str:
    values: set[str] = set()
    for name, value in env.items():
        if value and len(value) >= 4 and any(marker in name.upper() for marker in SENSITIVE_ENV_MARKERS):
            values.add(value)
            values.update(password for password in _URL_PASSWORD_RE.findall(value) if len(password) >= 4)
    for value in sorted(values, key=len, reverse=True):
        text = text.replace(value, "***")
    return text


@dataclass(frozen=True)
class CommandRun:
    """하위 프로세스 결과 — 출력 · env는 repr에서 뺀다(단언 실패 출력에 실리지 않게)."""

    returncode: int
    stdout: str = field(repr=False)
    stderr: str = field(repr=False)
    env: dict[str, str] = field(repr=False)

    def summary(self) -> str:
        """종료 코드 + stderr 마지막 줄(env 비밀 값 가림 · 300자)."""
        lines = [line for line in self.stderr.splitlines() if line.strip()]
        last = _redact(lines[-1], self.env)[:300] if lines else ""
        return f"종료 코드 {self.returncode} · stderr 마지막 줄: {last}"


def _migrate_env(pg: PgInfo) -> dict[str, str]:
    """migrate Job과 같은 env — 이 프로세스의 os.environ에서 pod 설정 키(시험 래퍼가 덮어쓴 필수 키 · 지운 선택 키)를 빼고
    JT_SETTINGS_PROFILE=migrate · ENV=test · DATABASE_OWNER_URL(시험 DB owner) · DJANGO_SETTINGS_MODULE=pod 설정을 넣는다."""
    removed = {name.upper() for name in (*settings.POD_SETTINGS_ENV, *settings.POD_SETTINGS_ENV_REMOVED)}
    env = {name: value for name, value in os.environ.items() if name.upper() not in removed}
    env.update(
        JT_SETTINGS_PROFILE="migrate",
        ENV="test",
        DATABASE_OWNER_URL=str(pg.url("owner")),
        DJANGO_SETTINGS_MODULE=POD_SETTINGS,
        PYTHONIOENCODING="utf-8",
    )
    return env


def _run(argv: list[str], env: dict[str, str]) -> CommandRun:
    completed: subprocess.CompletedProcess[str] | None
    try:
        completed = subprocess.run(  # noqa: S603 — 인자 고정 · shell 없음 · 이 프로세스의 인터프리터
            [sys.executable, *argv],
            cwd=POD_ROOT,
            env=env,
            capture_output=True,
            encoding="utf-8",
            errors="replace",
            timeout=BOOT_TIMEOUT_S,
            check=False,
            shell=False,
        )
    except subprocess.TimeoutExpired:
        completed = None  # 실패는 except 밖에서 낸다(명령 줄 · 부분 출력이 연쇄 예외로 실리지 않게)
    if completed is None:
        pytest.fail(f"하위 프로세스가 {BOOT_TIMEOUT_S} s 안에 끝나지 않았다", pytrace=False)
    return CommandRun(completed.returncode, completed.stdout, completed.stderr, env)


def _app_table_privileges(pg: PgInfo, table: str) -> frozenset[str]:
    held: set[str] = set()
    with connections["owner"].cursor() as cursor:
        for privilege in sorted(DML):
            cursor.execute("SELECT has_table_privilege(%s, %s, %s)", [pg.app_user, f"public.{table}", privilege])
            if cursor.fetchone()[0]:
                held.add(privilege)
    return frozenset(held)


def _app_default_grants(pg: PgInfo) -> frozenset[tuple[str, str]]:
    """pg_default_acl에서 app role이 받는 (객체 종류, 권한) 쌍."""
    with connections["owner"].cursor() as cursor:
        cursor.execute(
            "SELECT d.defaclobjtype::text, a.privilege_type FROM pg_catalog.pg_default_acl d"
            " CROSS JOIN LATERAL aclexplode(d.defaclacl) a"
            " WHERE a.grantee = (SELECT oid FROM pg_catalog.pg_roles WHERE rolname = %s)",
            [pg.app_user],
        )
        return frozenset((objtype, privilege) for objtype, privilege in cursor.fetchall())


def _grants_state(pg: PgInfo) -> dict[str, Any]:
    return {
        "outbox": _app_table_privileges(pg, "outbox"),
        "rls_widget": _app_table_privileges(pg, "rls_widget"),
        "django_migrations": _app_table_privileges(pg, "django_migrations"),
        "default": _app_default_grants(pg),
    }


