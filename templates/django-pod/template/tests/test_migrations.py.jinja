def test_lintmigrations_covers_every_pod_app() -> None:
    """린터 대상(시험 래퍼 MIGRATION_LINTER_OPTIONS include_apps) = pod 패키지의 앱 라벨 전부({{ pod_snake }} · core — pod가 앱을
    더하면 그 라벨도) · 캐시 파일 없음 — pod 앱({{ pod_snake }})에 모델 · 마이그레이션이 생겨도 린트된다(T072 ② r2 H8 · A-8)."""
    from django.apps import apps

    pod_labels = sorted(
        config.label
        for config in apps.get_app_configs()
        if config.name == POD_SNAKE or config.name.startswith(f"{POD_SNAKE}.")
    )
    options = settings.MIGRATION_LINTER_OPTIONS
    assert {POD_SNAKE, POD_APP_LABEL} <= set(pod_labels)
    assert sorted(options["include_apps"]) == pod_labels
    assert options["no_cache"] is True


