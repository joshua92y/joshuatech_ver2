def test_migrate_job_script_passes_migrate_exit_code_after_connect_boundary(pg: PgInfo) -> None:
    """(a) 시험 DB owner로 접속 · CONNECT 경계 SQL이 끝난 뒤 하위 migrate가 실패한다(JT_SETTINGS_PROFILE=bogus): 스크립트 종료 코드 =
    같은 env로 따로 돈 `manage.py migrate --noinput`의 종료 코드(≠ 0 · 거부 이름 JT_SETTINGS_PROFILE — X4 · sys.exit(subprocess.call)) ·
    CONNECT를 받는 grantee {PUBLIC, <db>_owner, <db>_app} → {<db>_owner, <db>_app} · PUBLIC 의사 role의 CONNECT 거짓 · 출력에 owner
    URL · 비밀번호 없음. 끝에 PUBLIC CONNECT를 되돌린다(이 세션의 다른 시험이 보는 DB 상태)."""
    script = _job_script()
    owner_url = str(pg.url("owner"))
    env = _job_env(owner_url, JT_SETTINGS_PROFILE="bogus")
    alone = _run(["manage.py", "migrate", "--noinput"], env)
    alone_refused = any(PROFILE_REFUSED.search(line.strip()) for line in alone.stderr.splitlines())
    assert alone.returncode != 0, alone.summary()
    assert alone_refused, alone.summary()
    before = _connect_grantees(pg)
    assert before == {PUBLIC, pg.owner_user, pg.app_user}  # 회수가 보이는 출발점(PUBLIC 기본 CONNECT + conftest GRANT 둘)
    try:
        result = _run(["-c", script], env)
        after = _connect_grantees(pg)
        public_after = _public_can_connect(pg)
    finally:
        _grant_public_connect(pg)
    script_refused = any(PROFILE_REFUSED.search(line.strip()) for line in result.stderr.splitlines())
    output = result.stdout + result.stderr
    leaked = owner_url in output or pg.owner_password in output
    assert result.returncode == alone.returncode, result.summary()
    assert script_refused, result.summary()
    assert not leaked, "스크립트 출력에 owner URL · 비밀번호가 있다"
    assert after == {pg.owner_user, pg.app_user}
    assert public_after is False
    assert _public_can_connect(pg) is True  # 되돌림 확인


def test_migrate_job_script_succeeds_with_manifest_env(pg: PgInfo) -> None:
    """(a) 성공 경로(T072 마지막 라운드 N2(2) · 조각 ④ 리뷰 A-1 — 상수 종료 1 · 기본 마감 무효화 변이를 잡는다): Job 매니페스트 env 그대로
    (JT_SETTINGS_PROFILE=migrate · JT_DB_CONNECT_WAIT_SECONDS 없음 = 스크립트 기본 120) + 시험 DB owner URL + ENV=test(시험 DB는 TLS require다 —
    운영 Job의 verify-full + /etc/pg/ca.crt는 이 호스트에 없다) → 스크립트 종료 0 · 하위 migrate가 돌았다(Django migrate 머리 줄 둘 — 세션
    DB가 이미 마이그레이션됐는지와 무관하다) · CONNECT 경계 적용(PUBLIC 회수 · <db>_owner · <db>_app만) · 스크립트 줄(db_*) 0 · 출력에 owner
    URL · 비밀번호 없음. 끝에 PUBLIC CONNECT를 되돌린다(이 세션의 다른 시험이 보는 DB 상태)."""
    script = _job_script()
    owner_url = str(pg.url("owner"))
    env = _job_env(owner_url, ENV="test")
    manifest_wait = WAIT_ENV in env
    assert not manifest_wait, f"{WAIT_ENV}가 env에 있다(매니페스트에는 없다 — 기본 120을 시험한다)"
    before = _connect_grantees(pg)
    assert before == {PUBLIC, pg.owner_user, pg.app_user}  # 회수가 보이는 출발점(PUBLIC 기본 CONNECT + conftest GRANT 둘)
    try:
        result = _run(["-c", script], env)
        after = _connect_grantees(pg)
        public_after = _public_can_connect(pg)
    finally:
        _grant_public_connect(pg)
    output = result.stdout + result.stderr
    leaked = owner_url in output or pg.owner_password in output
    script_lines = [line for line in output.splitlines() if line.startswith("db_")]
    migrated = all(marker in result.stdout for marker in MIGRATE_RAN)
    assert result.returncode == 0, result.summary()
    assert migrated, f"하위 migrate 출력에 머리 줄 {MIGRATE_RAN}가 없다 — {result.summary()}"
    assert script_lines == [], f"스크립트 줄 {len(script_lines)}개(기대 0 — 재시도 · 실패 없음)"
    assert not leaked, "스크립트 출력에 owner URL · 비밀번호가 있다"
    assert after == {pg.owner_user, pg.app_user}
    assert public_after is False
    assert _public_can_connect(pg) is True  # 되돌림 확인


def test_migrate_job_script_connect_failure_is_one_stderr_line() -> None:
    """(b) 닫힌 포트(127.0.0.1의 빈 포트) + JT_DB_CONNECT_WAIT_SECONDS=8(CONNECT_FAILURE_WAIT — 두 OS 모두에서 재시도가 한 번 이상 생기는 마감 ·
    T072 마지막 라운드 N2(2)): 종료 1 · stdout = 재시도 줄(`db_connect_retry <클래스> attempt=N`) 하나 이상뿐 · stderr = 정확히 한 줄
    `db_connect_failed <클래스>`(클래스 = psycopg.OperationalError 계열 — 재시도 경로의 마감 · Linux는 OperationalError · Windows psycopg는
    ConnectionTimeout · 트레이스백 · 예외 메시지 · 값 없음 — X25) · 출력에 심은 비밀번호 · URL 없음. 접속이 실패하는 경로라 DB가 필요 없다."""
    script = _job_script()
    password = secrets.token_urlsafe(24)
    owner_url = f"postgresql://{POD_SNAKE}_owner:{password}@127.0.0.1:{_closed_port()}/{POD_SNAKE}?sslmode=require"
    result = _run(["-c", script], _job_env(owner_url, **{WAIT_ENV: CONNECT_FAILURE_WAIT}))
    family = _operational_error_names()
    stderr_lines = [line.strip() for line in result.stderr.splitlines() if line.strip()]
    stdout_lines = [line.strip() for line in result.stdout.splitlines() if line.strip()]
    failed = [_line_class(CONNECT_FAILED_LINE, line) for line in stderr_lines]
    retried = [_line_class(RETRY_LINE, line) for line in stdout_lines]
    one_line = len(failed) == 1 and failed[0] in family
    retries_only = len(retried) >= 1 and all(name in family for name in retried)
    output = result.stdout + result.stderr
    leaked = password in output or owner_url in output
    assert result.returncode == 1, result.summary()
    assert one_line, f"stderr {len(stderr_lines)}줄(기대 정확히 한 줄 db_connect_failed <OperationalError 계열>) — {result.summary()}"
    assert retries_only, (
        f"stdout {len(stdout_lines)}줄(기대 재시도 줄 db_connect_retry <OperationalError 계열> attempt=N 하나 이상뿐 — 마감"
        f" {CONNECT_FAILURE_WAIT} s)"
    )
    assert not leaked, "스크립트 출력에 심은 비밀번호 · URL이 있다"


def test_migrate_job_script_url_failure_is_one_stderr_line() -> None:
    """DATABASE_OWNER_URL 해석 실패(T072 마지막 라운드 N1 · N2(2)): netloc의 비ASCII 글자가 NFKC로 '/'가 되는 owner URL(Python urlsplit이
    netloc 전체 — 심은 비밀번호 포함 — 를 실은 ValueError를 낸다) → 접속 전에 종료 1 · stderr = 정확히 한 줄 `db_url_invalid ValueError` ·
    stdout 없음 · 출력에 심은 비밀번호 · netloc · 트레이스백 없음."""
    script = _job_script()
    password = secrets.token_urlsafe(24)
    netloc = f"{POD_SNAKE}_owner:{password}{chr(0xFF0F)}x@127.0.0.1:{_closed_port()}"
    owner_url = f"postgresql://{netloc}/{POD_SNAKE}?sslmode=require"
    result = _run(["-c", script], _job_env(owner_url))
    stderr_lines = [line.strip() for line in result.stderr.splitlines() if line.strip()]
    failed = [_line_class(URL_INVALID_LINE, line) for line in stderr_lines]
    output = result.stdout + result.stderr
    leaked = password in output or netloc in output or "Traceback" in output
    quiet = result.stdout.strip() == ""
    assert result.returncode == 1, result.summary()
    assert failed == ["ValueError"], f"stderr {len(stderr_lines)}줄(기대 정확히 한 줄 db_url_invalid ValueError) — {result.summary()}"
    assert quiet, "stdout에 줄이 있다(URL 해석 실패는 접속 전이다)"
    assert not leaked, "스크립트 출력에 심은 비밀번호 · netloc · 트레이스백이 있다"


def test_migrate_job_script_boundary_failure_is_one_stderr_line(pg: PgInfo) -> None:
    """CONNECT 경계 SQL 실패(T072 마지막 라운드 N1 · N2(2)): 시험 owner로 <db>_app role이 없는 DB(ROLELESS_DB — 첫 배포에서 app role이 DB보다
    늦게 생길 때와 같은 GRANT 실패 · 실제 psycopg가 UndefinedObject를 낸다)에 접속 + 마감 4 s(BOUNDARY_FAILURE_WAIT) → 다시 접속해 경계를
    재시도(stdout `db_boundary_retry UndefinedObject attempt=N` 하나 이상) → 마감 뒤 종료 1 · stderr = 정확히 한 줄 `db_boundary_failed
    UndefinedObject` · 하위 migrate 없음 · 출력에 owner URL · 비밀번호 없음 · 시험 DB의 CONNECT 경계는 그대로(다른 DB에 접속했다)."""
    script = _job_script()
    owner_url = str(pg.url("owner")).replace(f"/{pg.dbname}?", f"/{ROLELESS_DB}?", 1)
    before = _connect_grantees(pg)
    try:
        result = _run(["-c", script], _job_env(owner_url, **{WAIT_ENV: BOUNDARY_FAILURE_WAIT}))
    finally:
        _grant_public_connect(pg)  # 시험 DB는 건드리지 않는다 — 혹시 바뀌었으면 세션 상태로 되돌린다(멱등)
    after = _connect_grantees(pg)
    stderr_lines = [line.strip() for line in result.stderr.splitlines() if line.strip()]
    stdout_lines = [line.strip() for line in result.stdout.splitlines() if line.strip()]
    failed = [_line_class(BOUNDARY_FAILED_LINE, line) for line in stderr_lines]
    retried = [_line_class(BOUNDARY_RETRY_LINE, line) for line in stdout_lines]
    output = result.stdout + result.stderr
    leaked = owner_url in output or pg.owner_password in output
    migrated = any(marker in output for marker in MIGRATE_RAN)
    assert result.returncode == 1, result.summary()
    assert failed == ["UndefinedObject"], (
        f"stderr {len(stderr_lines)}줄(기대 정확히 한 줄 db_boundary_failed UndefinedObject) — {result.summary()}"
    )
    assert len(retried) >= 1 and set(retried) == {"UndefinedObject"}, (
        f"stdout {len(stdout_lines)}줄(기대 재시도 줄 db_boundary_retry UndefinedObject attempt=N 하나 이상뿐)"
    )
    assert not migrated, "경계 실패 뒤 하위 migrate가 돌았다"
    assert not leaked, "스크립트 출력에 owner URL · 비밀번호가 있다"
    assert after == before
