@DB
def test_migrate_profile_reverses_and_reapplies_app_role_grants(pg: PgInfo) -> None:
    """migrate 프로필 하위 프로세스(owner · SECRET_KEY · DRAGONFLY_URL 없음): `migrate core zero` 종료 0 → app role의 표 권한 ·
    기본 권한이 사라진다(reverse_sql) → `migrate --noinput` 종료 0 · 0001_app_role_grants 적용 → 권한이 돌아온다. 중간에 실패해도
    끝에 같은 마이그레이션을 다시 적용해 둔다(이 세션의 다른 시험이 쓰는 권한)."""
    env = _migrate_env(pg)
    assert not {"SECRET_KEY", "DRAGONFLY_URL", "DATABASE_URL"} & {name.upper() for name in env}
    assert _grants_state(pg) == GRANTED
    try:
        unapplied = _run(["manage.py", "migrate", POD_APP_LABEL, "zero", "--noinput"], env)
        assert unapplied.returncode == 0, unapplied.summary()
        assert f"Unapplying {POD_APP_LABEL}.{GRANTS_MIGRATION}... OK" in unapplied.stdout
        assert _grants_state(pg) == REVOKED
        applied = _run(["manage.py", "migrate", "--noinput"], env)
        assert applied.returncode == 0, applied.summary()
        assert f"Applying {POD_APP_LABEL}.{GRANTS_MIGRATION}... OK" in applied.stdout
    finally:
        # 이미 적용돼 있으면 아무것도 하지 않는다(멱등) — 하위 프로세스가 중간에 실패한 경우만 되살린다.
        call_command("migrate", POD_APP_LABEL, database="owner", verbosity=0)
    assert _grants_state(pg) == GRANTED


