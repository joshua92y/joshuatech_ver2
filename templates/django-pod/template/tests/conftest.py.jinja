# --- 시험 실행 위생 가드(T072 ② r2 H9 · H12 — B-1 · B-4) ----------------------------------------------------------------------

WRAPPER_SETTINGS = "tests.settings"
RUN_GUARD_PREFIX = "생성물 시험 실행 위생 위반: "


def run_guard_problems(config: pytest.Config) -> list[str]:
    """이 pytest 실행이 어긴 위생 조건의 이름(값 없음) — python -O · PYTHONOPTIMIZE(재작성 밖 assert가 사라진다) · short가 아닌
    --tb · -l/--showlocals · no가 아닌 --show-capture · --full-trace(실패 출력이 접속 문자열 · 심은 비밀을 싣는다 — --full-trace는
    --tb를 long으로 바꾼다) · tests.settings가 아닌 설정 모듈(셸 env DJANGO_SETTINGS_MODULE · --ds가 시험 래퍼를 비켜 가면 셸의 실제
    설정이 pod 설정이 된다 — pytest-django를 끈 실행도 여기 걸린다). 명령줄 · PYTEST_ADDOPTS · -o로 들어온 값 모두 본다."""
    from django.conf import settings

    problems: list[str] = []
    if sys.flags.optimize:
        problems.append("PYTHONOPTIMIZE(-O)")
    if config.getoption("tbstyle", "auto") != "short":
        problems.append("--tb")
    if config.getoption("showlocals", False):
        problems.append("--showlocals(-l)")
    if config.getoption("showcapture", "all") != "no":
        problems.append("--show-capture")
    if config.getoption("fulltrace", False):
        problems.append("--full-trace")
    if (settings.SETTINGS_MODULE if settings.configured else None) != WRAPPER_SETTINGS:
        problems.append("DJANGO_SETTINGS_MODULE(--ds)")
    return problems


def pytest_configure(config: pytest.Config) -> None:
    """시험 실행 위생 가드 — 어긴 조건이 있으면 시험을 모으기 전에 UsageError(종료 4 · 조건 이름만). pytest-django는 이 훅보다 먼저
    (pytest_load_initial_conftests) 설정을 적재한다."""
    problems = run_guard_problems(config)
    if problems:
        raise pytest.UsageError(
            RUN_GUARD_PREFIX
            + " · ".join(problems)
            + " — pyproject addopts(--tb=short · --show-capture=no · --ds=tests.settings)를 넓히거나 덮지 말고 python -O 없이"
            " 돈다(README 「시험」)"
        )


