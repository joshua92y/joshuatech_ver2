# --- 로컬 키 서버(Authentik JWKS · Cloudflare Access certs) ---------------------------------------------------------------


@dataclass(frozen=True)
class JwksInfo:
    """로컬 키 서버 — base_url = `http://127.0.0.1:<port>`(Access 팀 도메인 자리 · Access iss) · jwks_url(운영 svc DNS 자리) ·
    certs_url · hits = 경로별 GET 수(서버 스레드가 잠금 아래 올린다). 서명 키(세션 생성 RSA 2048)는 repr에서 뺀다."""

    base_url: str
    jwks_url: str
    certs_url: str
    authentik_key: rsa.RSAPrivateKey = field(repr=False)
    access_key: rsa.RSAPrivateKey = field(repr=False)
    hits: dict[str, int]


def _jwks_handler(documents: dict[str, bytes], hits: dict[str, int], lock: threading.Lock) -> type[BaseHTTPRequestHandler]:
    class JwksHandler(BaseHTTPRequestHandler):
        def do_GET(self) -> None:  # 이름은 BaseHTTPRequestHandler 규약(do_<METHOD>)이다
            with lock:
                hits[self.path] = hits.get(self.path, 0) + 1
            body = documents.get(self.path)
            if body is None:
                self.send_error(HTTPStatus.NOT_FOUND)
                return
            self.send_response(HTTPStatus.OK)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, format: str, *args: Any) -> None:  # 인자 이름 format은 부모 시그니처 그대로다
            """요청 로그를 끈다(기본 구현은 요청마다 stderr에 한 줄을 쓴다)."""

    return JwksHandler


