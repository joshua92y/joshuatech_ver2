PG_TLS_CONTEXT = Path(__file__).resolve().parent / "docker" / "pg-tls"
PG_TLS_TAG = "jt-{{ pod_name }}-pg-tls:18.6"
PG_SUPERUSER = "postgres"
PG_DB = POD_SNAKE
OWNER_ROLE = f"{POD_SNAKE}_owner"
APP_ROLE = f"{POD_SNAKE}_app"
CONNECT_TIMEOUT_S = 10


@dataclass(frozen=True)
class PgInfo:
    """컨테이너 접속 정보 — 비밀번호는 repr에서 뺀다(실패 출력에 남지 않게)."""

    host: str
    port: int
    dbname: str
    owner_user: str
    app_user: str
    owner_password: str = field(repr=False)
    app_password: str = field(repr=False)

    def connect(self, role: Literal["owner", "app"], *, sslmode: str = "require") -> psycopg.Connection[Any]:
        """role로 시험 DB에 접속한다(기본 sslmode=require)."""
        user, password = {
            "owner": (self.owner_user, self.owner_password),
            "app": (self.app_user, self.app_password),
        }[role]
        return psycopg.connect(
            host=self.host,
            port=self.port,
            dbname=self.dbname,
            user=user,
            password=password,
            sslmode=sslmode,
            connect_timeout=CONNECT_TIMEOUT_S,
        )

    def url(self, role: Literal["owner", "app"], *, sslmode: str = "require") -> Secret:
        """role의 postgresql URL(Secret) — 기동 하위 프로세스에 DATABASE_URL · DATABASE_OWNER_URL로 넘길 때 쓴다(token_urlsafe
        비밀번호는 URL 인코딩이 필요 없다)."""
        user, password = (self.owner_user, self.owner_password) if role == "owner" else (self.app_user, self.app_password)
        return Secret(f"postgresql://{user}:{password}@{self.host}:{self.port}/{self.dbname}?sslmode={sslmode}")


def _redacted(text: str, *values: str) -> str:
    for value in values:
        text = text.replace(value, "***")
    return text


def _bootstrap_roles(info: PgInfo, superuser_password: str) -> None:
    """superuser로 owner/app role을 만든다 — 기본 권한(DEFAULT PRIVILEGES)과 멤버십은 주지 않는다(GRANT 마이그레이션이 증명한다).

    CREATE ROLE … PASSWORD는 유틸리티 문이라 서버 쪽 바인드 파라미터를 받지 않는다 → psycopg.sql.Literal로 클라이언트에서 묶는다.
    """
    owner, app, db = sql.Identifier(OWNER_ROLE), sql.Identifier(APP_ROLE), sql.Identifier(PG_DB)
    statements = (
        sql.SQL("CREATE ROLE {} LOGIN BYPASSRLS PASSWORD {}").format(owner, sql.Literal(info.owner_password)),
        sql.SQL("CREATE ROLE {} LOGIN NOBYPASSRLS PASSWORD {}").format(app, sql.Literal(info.app_password)),
        sql.SQL("ALTER DATABASE {} OWNER TO {}").format(db, owner),
        sql.SQL("GRANT CONNECT ON DATABASE {} TO {}, {}").format(db, owner, app),
    )
    with psycopg.connect(
        host=info.host,
        port=info.port,
        dbname=PG_DB,
        user=PG_SUPERUSER,
        password=superuser_password,
        sslmode="require",
        connect_timeout=CONNECT_TIMEOUT_S,
        autocommit=True,
    ) as conn:
        for statement in statements:
            conn.execute(statement)


