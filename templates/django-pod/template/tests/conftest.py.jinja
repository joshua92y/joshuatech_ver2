            bootstrap.execute_command("ACL", "SETUSER", "default", "off")
        except Exception as exc:  # noqa: BLE001 — 오류 메시지가 규칙 토큰(비밀번호)을 되풀이할 수 있다 → 가린 사본만
            failure = _redacted(f"Dragonfly ACL 준비 실패: {type(exc).__name__}: {exc}", *passwords.values())
        finally:
            bootstrap.close()
        if failure is not None:
            raise RuntimeError(failure)
        yield DragonflyInfo(
            host=host,
            port=port,
            admin_url=_redis_url("admin", passwords["admin"], host, port),
            pod_url=_redis_url(POD_NAME, passwords[POD_NAME], host, port),
        )
    finally:
        container.stop()


