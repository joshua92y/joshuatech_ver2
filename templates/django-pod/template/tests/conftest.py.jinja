class LogLines:
    """log_sink 읽기 객체 — 부를 때마다 지난 호출 뒤에 쓰인 새 줄을 JSON 객체(dict) 목록으로 돌려준다.

    한 줄 = 한 JSON 객체여야 한다(아니면 AssertionError — 실패 메시지에는 줄 번호와 길이만). 읽은 원문은 raw에 쌓는다 — "출력
    어디에도 X가 없다" 단언은 `needle in raw`를 따로 계산해 bool만 단언한다(원문이 실패 출력에 실리지 않게).
    """

    def __init__(self, sink: io.StringIO) -> None:
        self._sink = sink
        self.raw = ""

    def __call__(self) -> list[dict[str, Any]]:
        text = self._sink.getvalue()
        self._sink.seek(0)
        self._sink.truncate()
        self.raw += text
        if text and not text.endswith("\n"):
            raise AssertionError("로그 출력이 줄바꿈으로 끝나지 않는다(한 줄 = 한 JSON 객체)")
        records: list[dict[str, Any]] = []
        # splitlines()가 아니라 "\n"으로 자른다 — 문자열 안에 그대로 둔 U+2028 등을 줄 끝으로 오인하지 않게.
        for number, line in enumerate(text.split("\n")[:-1], start=1):
            try:
                record = json.loads(line)
            except ValueError:
                raise AssertionError(f"로그 {number}번째 줄이 JSON이 아니다(길이 {len(line)})") from None
            if not isinstance(record, dict):
                raise AssertionError(f"로그 {number}번째 줄이 JSON 객체가 아니다({type(record).__name__})")
            records.append(record)
        return records


