def log_lines(log_sink: io.StringIO) -> LogLines:
    """sink를 비우고 LogLines를 준다(함수 스코프) — 이 시험이 만든 줄만 읽힌다."""
    log_sink.seek(0)
    log_sink.truncate()
    return LogLines(log_sink)


