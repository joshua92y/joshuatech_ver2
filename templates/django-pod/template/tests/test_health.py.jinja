def _closed_port() -> int:
    """연결을 받지 않는 127.0.0.1 포트 — bind로 번호만 받고 닫는다."""
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as probe:
        probe.bind(("127.0.0.1", 0))
        port: int = probe.getsockname()[1]
    return port


class _Listener:
    """연결을 받자마자 끊고 수락 수를 세는 127.0.0.1 리스너의 손잡이(_counting_listener)."""

    def __init__(self, address: str, counts: list[int], lock: threading.Lock) -> None:
        self.address = address
        self._counts = counts
        self._lock = lock

    @property
    def count(self) -> int:
        with self._lock:
            return self._counts[0]


@contextmanager
def _counting_listener() -> Iterator[_Listener]:
    """127.0.0.1 임시 포트에서 TCP 연결을 받자마자 닫고 수락 수를 세는 리스너(데몬 스레드) — 어떤 의존에 "다이얼했는가"를 시간 ·
    플랫폼과 무관하게 증명한다. 연결을 곧바로 끊으므로 클라이언트는 즉시(redis-py) 또는 자기 시간 초과 안에(librdkafka) 실패한다."""
    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server.bind(("127.0.0.1", 0))
    server.listen(16)
    server.settimeout(0.1)
    host, port = server.getsockname()
    stop = threading.Event()
    lock = threading.Lock()
    counts = [0]

    def serve() -> None:
        while not stop.is_set():
            try:
                accepted, _ = server.accept()
            except TimeoutError:
                continue
            except OSError:
                break
            with lock:
                counts[0] += 1
            accepted.close()

    thread = threading.Thread(target=serve, name="health-counting-listener", daemon=True)
    thread.start()
    try:
        yield _Listener(f"{host}:{port}", counts, lock)
    finally:
        stop.set()
        thread.join(2.0)
        server.close()


@contextmanager
def _db_down(pg: PgInfo) -> Iterator[Secret]:
    """default 별칭을 닫힌 127.0.0.1 포트로 돌려 DB 다운을 흉내 낸다 · 끝나면 되돌린다 · app role 비밀번호(Secret)를 준다.

    connection.settings_dict는 settings.DATABASES["default"]와 같은 dict라 헬스 작업 스레드의 새 연결에도 유효하다. HOST도
    127.0.0.1로 둔다(`localhost`는 ::1 시도가 먼저라 판정이 두 배가 된다)."""
    connection = connections["default"]
    original = deepcopy(connection.settings_dict)
    try:
        connection.close()
        connection.settings_dict["HOST"] = "127.0.0.1"
        connection.settings_dict["PORT"] = str(_closed_port())
        connection.settings_dict["OPTIONS"] = {**original["OPTIONS"], "connect_timeout": DB_DOWN_CONNECT_TIMEOUT_S}
        yield Secret(pg.app_password)
    finally:
        connection.close()
        connection.settings_dict.clear()
        connection.settings_dict.update(original)


def _fail_without_trace(what: str, exc: BaseException) -> NoReturn:
    """예외를 원 트레이스백 · 메시지 없이 실패로 바꾼다 — psycopg Connection.connect의 conninfo 인자(비밀번호)를 긴 트레이스백이
    찍지 않게 형식 이름만 싣는다. 호출자는 except 블록 밖에서 부른다(연쇄된 원 예외도 남지 않게)."""
    kind = f"{type(exc).__module__}.{type(exc).__name__}"
    pytest.fail(f"{what}: 예외로 끝났다({kind}) — 원 트레이스백 · 메시지는 비밀 노출을 막으려고 싣지 않는다", pytrace=False)


def _safe_get(client: Client, path: str) -> HttpResponse:
    """DB에 닿는 GET — 예외가 나면 _fail_without_trace로 끝난다(시험 Client는 뷰 예외를 그대로 다시 올린다)."""
    failure: BaseException | None = None
    try:
        return client.get(path, headers={"host": HOST})
    except Exception as exc:  # noqa: BLE001 — 어떤 예외든 원 트레이스백 없이 실패로 바꾼다
        failure = exc
    _fail_without_trace(f"GET {path}", failure)


def _timed_get(client: Client, path: str) -> tuple[HttpResponse, float]:
    """GET 한 번과 그 경과(초) — 요청은 데몬 스레드에서 돈다. HANG_LIMIT_S 안에 끝나지 않으면(시간 초과가 없는 구현) 실패로
    끝낸다. 작업 스레드는 settings.DATABASES의 같은 dict로 새 연결을 열고 끝날 때 자기 연결만 닫는다."""
    outcome: list[HttpResponse | BaseException] = []

    def run() -> None:
        try:
            outcome.append(client.get(path, headers={"host": HOST}))
        except BaseException as exc:  # noqa: BLE001 — 스레드 경계: 어떤 예외든 호출 스레드로 넘긴다
            outcome.append(exc)
        finally:
            connections.close_all()

    worker = threading.Thread(target=run, name="health-timed-get", daemon=True)
    start = time.perf_counter()
    worker.start()
    worker.join(HANG_LIMIT_S)
    elapsed = time.perf_counter() - start
    if worker.is_alive():
        pytest.fail(f"GET {path}가 {HANG_LIMIT_S:.0f} s 안에 끝나지 않았다 — 의존 조회에 시간 초과가 없는 구현인가")
    result = outcome[0]
    if isinstance(result, BaseException):
        _fail_without_trace(f"GET {path}", result)
    return result, elapsed


def _health_body(response: HttpResponse) -> tuple[Any, dict[str, Any]]:
    """/health 본문의 status와 항목별 status(checks의 키 집합은 정확히 db · dragonfly · kafka_producer)."""
    body: dict[str, Any] = json.loads(response.content)
    checks = body.get("checks")
    assert isinstance(checks, dict)
    assert set(checks) == CHECK_NAMES
    statuses = {name: check.get("status") if isinstance(check, dict) else None for name, check in checks.items()}
    return body.get("status"), statuses


def _response_text(response: HttpResponse) -> str:
    headers = "\n".join(f"{name}: {value}" for name, value in response.items())
    return f"{response.content.decode('utf-8', errors='replace')}\n{headers}"


def _assert_absent(where: str, text: str, *needles: str) -> None:
    """needles(비밀번호 · 자격 URL)가 text 어디에도 없다 — 인자를 Secret으로 다시 묶고(트레이스백 인자 repr) 위치 번호로 접는다
    (단언 재작성이 비교 피연산자를 찍지 않게)."""
    text = Secret(text)
    needles = tuple(Secret(needle) for needle in needles)
    leaked = [index for index, needle in enumerate(needles) if needle and needle in text]
    assert leaked == [], f"{where}에 민감 값이 있다(needles 위치 {leaked})"


def _redact_env(text: str, env: Mapping[str, str]) -> str:
    """text에서 비밀처럼 보이는 env 값(이름에 PASSWORD · SECRET · TOKEN · KEY · URL · DSN)을 가린다(긴 값부터)."""
    values = {
        value
        for name, value in env.items()
        if value and len(value) >= 4 and any(marker in name.upper() for marker in SENSITIVE_ENV_MARKERS)
    }
    for value in sorted(values, key=len, reverse=True):
        text = text.replace(value, "***")
    return text


@dataclass(frozen=True)
class ProbeRun:
    """기동 하위 프로세스 결과 — 출력 · env는 repr에서 뺀다(단언 실패 출력에 실리지 않게)."""

    returncode: int
    stdout: str = field(repr=False)
    stderr: str = field(repr=False)
    env: dict[str, str] = field(repr=False)

    def summary(self) -> str:
        """종료 코드 + stderr 마지막 줄(env 비밀 값 가림 · 300자)."""
        lines = [line for line in self.stderr.splitlines() if line.strip()]
        last = _redact_env(lines[-1], self.env)[:300] if lines else ""
        return f"종료 코드 {self.returncode} · stderr 마지막 줄: {last}"

    def facts(self) -> dict[str, Any]:
        """종료 0 · PROBE_MARK 줄 하나 → 그 JSON."""
        assert self.returncode == 0, self.summary()
        lines = [line for line in self.stdout.splitlines() if line.startswith(PROBE_MARK)]
        assert len(lines) == 1, f"탐침 결과 줄 수 {len(lines)} · {self.summary()}"
        facts: dict[str, Any] = json.loads(lines[0][len(PROBE_MARK) :])
        return facts


# wsgi 진입점(django.setup → configure_otel → configure_sentry → WSGIHandler)을 그대로 적재한 뒤 Host마다 GET /healthz를
# application(environ, start_response)로 부른다 — 시험 Client가 아니라 web이 실제로 쓰는 application 객체다.
_WSGI_PROBE_BODY = """
import json
import sys
from wsgiref.util import setup_testing_defaults

from {{ pod_snake }}.wsgi import application
from django.conf import settings


def call(host):
    environ = {"PATH_INFO": "/healthz", "REQUEST_METHOD": "GET", "HTTP_HOST": host}
    setup_testing_defaults(environ)
    seen = {}

    def start_response(status, headers, exc_info=None):
        seen["status"] = int(status.split(" ", 1)[0])
        seen["content_type"] = dict(headers).get("Content-Type", "")

    body = b"".join(application(environ, start_response))
    try:
        parsed = json.loads(body)
    except ValueError:
        parsed = None
    seen["body"] = parsed if isinstance(parsed, dict) else None
    return seen


facts = {"middleware0": settings.MIDDLEWARE[0], "results": {host: call(host) for host in sys.argv[1:]}}
print(MARK + json.dumps(facts), flush=True)
"""
WSGI_PROBE_SCRIPT = f"MARK = {PROBE_MARK!r}\n" + _WSGI_PROBE_BODY


def _wsgi_probe(pod_ip: str | None, hosts: tuple[str, ...]) -> ProbeRun:
    """pod 설정(래퍼가 아니다)으로 새 프로세스를 띄워 wsgi 진입점을 적재하고 hosts마다 /healthz를 부른다.

    env = 이 프로세스의 os.environ(래퍼가 채운 설정 env) + DJANGO_SETTINGS_MODULE={{ pod_snake }}.settings · POD_IP는 인자대로
    (None이면 지운다) · OTEL_* 는 지운다(configure_otel 기본값 — 개발자 셸 값이 결과를 바꾸지 않게) · cwd = pod 루트 · shell 없음."""
    env = {name: value for name, value in os.environ.items() if not name.upper().startswith("OTEL_")}
    env["DJANGO_SETTINGS_MODULE"] = POD_SETTINGS
    env["PYTHONIOENCODING"] = "utf-8"
    env.pop("POD_IP", None)
    env.pop("SSLKEYLOGFILE", None)
    if pod_ip is not None:
        env["POD_IP"] = pod_ip
    completed: subprocess.CompletedProcess[str] | None
    try:
        completed = subprocess.run(  # noqa: S603 — 인자 고정 · shell 없음 · 이 프로세스의 인터프리터
            [sys.executable, "-c", WSGI_PROBE_SCRIPT, *hosts],
            cwd=POD_ROOT,
            env=env,
            capture_output=True,
            encoding="utf-8",
            errors="replace",
            timeout=BOOT_TIMEOUT_S,
            check=False,
            shell=False,
        )
    except subprocess.TimeoutExpired:
        completed = None  # 실패는 except 밖에서 낸다(명령 줄 · 부분 출력이 연쇄 예외로 실리지 않게)
    if completed is None:
        pytest.fail(f"wsgi 탐침이 {BOOT_TIMEOUT_S} s 안에 끝나지 않았다", pytrace=False)
    return ProbeRun(completed.returncode, completed.stdout, completed.stderr, env)


def _requests_total(route: str, status: str) -> float:
    value = REGISTRY.get_sample_value("http_requests_total", {"route": route, "status": status})
    return value or 0.0


