def test_http_requests_total_labels_route_pattern_only() -> None:
    """/healthz → http_requests_total{route="healthz",status="200"} +1 · 해석 전에 거절된 경로(자격 없음 403 — JwtAuthMiddleware가
    URL 해석보다 먼저 판정한다) → {route="",status="403"} +1 · 그 원문 경로는 어느 라벨에도 없다."""
    stray = f"/no-route-{secrets.token_hex(4)}"
    before_ok = _requests_total("healthz", "200")
    before_refused = _requests_total("", "403")
    client = Client()
    assert client.get("/healthz", headers={"host": HOST}).status_code == 200
    assert_problem(client.get(stray, headers={"host": HOST}), 403, "access_required")
    assert _requests_total("healthz", "200") == before_ok + 1
    assert _requests_total("", "403") == before_refused + 1
    labels = {
        value
        for metric in REGISTRY.collect()
        if metric.name == "http_requests"
        for sample in metric.samples
        for value in sample.labels.values()
    }
    assert stray.strip("/") not in {label.strip("/") for label in labels}
    assert not any("no-route-" in label for label in labels)


