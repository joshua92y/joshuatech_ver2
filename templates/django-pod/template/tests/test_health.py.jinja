def test_healthz_is_process_only() -> None:
    """/healthz — DB 마크 없이 200(DB에 닿으면 pytest-django가 막는다) · JSON 본문 = status ok · version · git_sha(설정 값)."""
    response = Client().get("/healthz", headers={"host": HOST})
    assert response.status_code == 200
    assert response["Content-Type"].startswith("application/json")
    expected = {"status": "ok", "version": settings.APP_VERSION, "git_sha": settings.APP_GIT_SHA}
    assert json.loads(response.content) == expected


@DB
def test_ready_and_healthz_dial_no_dependency(settings: SettingsWrapper) -> None:
    """Dragonfly · Kafka 자리에 수락 수를 세는 리스너 → /ready 200 {status: ok} · /healthz 200 · 그동안 수락 0 · 각 1 s 안 /
    /health 200 degraded(db ok · dragonfly fail · kafka_producer fail) · 3 s 안 · 두 리스너에 수락 ≥ 1(상세 헬스는 의존을 실제로
    본다) · 응답에 Dragonfly 비밀번호 · URL 없음."""
    password = Secret(secrets.token_urlsafe(16))
    with _counting_listener() as dragonfly_sink, _counting_listener() as kafka_sink:
        url = Secret(f"redis://{POD_NAME}:{password}@{dragonfly_sink.address}/0")
        settings.DRAGONFLY_URL = url
        settings.KAFKA_BOOTSTRAP_SERVERS = kafka_sink.address
        client = Client()
        ready, ready_s = _timed_get(client, "/ready")
        healthz, healthz_s = _timed_get(client, "/healthz")
        quiet = (dragonfly_sink.count, kafka_sink.count)
        health, health_s = _timed_get(client, "/health")
        dialed = (dragonfly_sink.count, kafka_sink.count)
    for response in (ready, healthz, health):
        _assert_absent("응답", _response_text(response), password, url)
    assert ready.status_code == 200
    assert json.loads(ready.content) == {"status": "ok"}
    assert healthz.status_code == 200
    assert quiet == (0, 0), f"/ready · /healthz가 의존에 다이얼했다(Dragonfly · Kafka 수락 수 {quiet})"
    assert ready_s < QUIET_LIMIT_S, f"/ready 경과 {ready_s:.3f} s"
    assert healthz_s < QUIET_LIMIT_S, f"/healthz 경과 {healthz_s:.3f} s"
    assert health.status_code == 200
    status, checks = _health_body(health)
    assert status == "degraded"
    assert checks == {"db": "ok", "dragonfly": "fail", "kafka_producer": "fail"}
    assert dialed[0] >= 1 and dialed[1] >= 1, f"/health가 의존에 다이얼하지 않았다(수락 수 {dialed})"
    assert health_s < DOWN_LIMIT_S, f"/health 경과 {health_s:.3f} s"


@DB
@pytest.mark.usefixtures("auth_settings", "kafka_settings")
def test_db_down_ready_503_and_health_degraded(pg: PgInfo, log_lines: LogLines) -> None:
    """DB 다운: /ready 503 not_ready(problem+json · detail 없음) · /healthz 200 · /health 200 degraded(db만 fail —
    Dragonfly · Kafka는 시험 컨테이너로 살아 있다) · 각 3 s 안 · 응답 · 로그에 app role 비밀번호 없음 → 되돌리면 /ready 200."""
    client = Client()
    with _db_down(pg) as password:
        ready, ready_s = _timed_get(client, "/ready")
        healthz, healthz_s = _timed_get(client, "/healthz")
        health, health_s = _timed_get(client, "/health")
    for response in (ready, healthz, health):
        _assert_absent("응답", _response_text(response), password)
    log_lines()
    _assert_absent("로그", log_lines.raw, password)
    body = assert_problem(ready, 503, "not_ready")
    assert "detail" not in body
    assert healthz.status_code == 200
    assert health.status_code == 200
    status, checks = _health_body(health)
    assert status == "degraded"
    assert checks == {"db": "fail", "dragonfly": "ok", "kafka_producer": "ok"}
    elapsed = {"/ready": round(ready_s, 2), "/healthz": round(healthz_s, 2), "/health": round(health_s, 2)}
    slow = [path for path, seconds in elapsed.items() if seconds >= DOWN_LIMIT_S]
    assert slow == [], f"경과(s) {elapsed}"
    assert _safe_get(client, "/ready").status_code == 200


