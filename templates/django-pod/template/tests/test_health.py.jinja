@pytest.mark.parametrize(
    ("pod_ip", "expected"),
    [
        pytest.param("10.42.0.7", {"10.42.0.7:8000": 200, "10.42.0.8:8000": 400}, id="ipv4"),
        pytest.param(None, {"10.42.0.7:8000": 400}, id="absent"),
        pytest.param("fd00::7", {"[fd00::7]:8000": 200, "[fd00::8]:8000": 400}, id="ipv6"),
    ],
)
def test_probe_host_is_pod_ip(pod_ip: str | None, expected: dict[str, int]) -> None:
    """wsgi 진입점(OTel 미들웨어가 MIDDLEWARE 맨 앞) + env POD_IP → Host `<POD_IP>:8000`의 /healthz 200(본문 status ok) · POD_IP가
    없거나 다른 IP의 Host는 400 invalid_host(problem+json) — 프로브에 httpHeaders를 두지 않아도 된다."""
    facts = _wsgi_probe(pod_ip, tuple(expected)).facts()
    middleware0 = facts.get("middleware0")
    assert isinstance(middleware0, str) and middleware0.startswith(OTEL_MIDDLEWARE_PREFIX), "OTel 미들웨어가 맨 앞에 없다"
    results: dict[str, Any] = facts["results"]
    for host, status in expected.items():
        result = results[host]
        assert result["status"] == status, (host, result["status"])
        body = result["body"] or {}
        if status == 200:
            assert body.get("status") == "ok", host
        else:
            assert result["content_type"].startswith("application/problem+json"), host
            assert body.get("type") == problem_type("invalid_host"), host


