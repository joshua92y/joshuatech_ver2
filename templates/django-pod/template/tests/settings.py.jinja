    "DATABASE_URL": f"postgresql://{_snake}_app:{secrets.token_urlsafe(24)}@{_loopback}/{_snake}?sslmode=require",
    "DRAGONFLY_URL": f"redis://{_pod}:{secrets.token_urlsafe(24)}@{_loopback}/0",
    "KAFKA_BOOTSTRAP": _loopback,
    "KAFKA_USERNAME": _pod,
