    "AUTHENTIK_ISSUER": f"https://auth.joshuatech.dev/application/o/{_pod}/",
    "AUTHENTIK_JWKS_URL": f"http://{_loopback}/application/o/{_pod}/jwks/",
    "AUTHENTIK_AUDIENCE": _pod,
    "ACCESS_TEAM_DOMAIN": f"http://{_loopback}",
    "ACCESS_AUD_M2M": "test-access-audience",
    "ACCESS_AUD_ADMIN": "",
