# 덮어쓴 필수 키 · 지운 키(선택 설정 · 프로필 · 런타임 거부 대상 · 개발자 셸의 OTLP 내보내기 대상 · 검증된 설정을 대신하는 env —
# Celery 브로커 · 결과 URL · GUNICORN_CMD_ARGS: 기동 단언이 거부한다 · T072 ② r2 H10) — 기동 시험이 자식 env를 만들 때 쓴다(Django
# 설정으로도 보인다).
POD_SETTINGS_ENV = tuple(_required_values)
POD_SETTINGS_ENV_REMOVED = (
    "AUTH_ACTOR_SUB",
    "SENTRY_DSN",
{%- if has_admin %}
    "FORCE_SCRIPT_NAME",
{%- endif %}
    "POD_IP",
    "POD_NAMESPACE",
    "JT_PLACEHOLDER_EXEMPT",
    "JT_SETTINGS_PROFILE",
    "DATABASE_OWNER_URL",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT",
    "CELERY_BROKER_URL",
    "CELERY_BROKER_READ_URL",
    "CELERY_BROKER_WRITE_URL",
    "CELERY_RESULT_BACKEND",
    "GUNICORN_CMD_ARGS",
