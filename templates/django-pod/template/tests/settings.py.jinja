for _name in POD_SETTINGS_ENV_REMOVED:
    os.environ.pop(_name, None)
os.environ.update(_required_values)

from {{ pod_snake }}.settings import *  # noqa: E402, F403

INSTALLED_APPS = [*INSTALLED_APPS, "tests.rlsapp", "django_migration_linter"]  # noqa: F405
# django-migration-linter(test_migrations — lintmigrations): 캐시 파일을 쓰지 않는다 · 판정 대상 = pod 패키지의 앱 라벨 전부(pod 앱
# {{ pod_snake }} · core — 앱을 더하면 넓힌다 · pod 앱에 마이그레이션이 생겨도 린트된다 · T072 ② r2 H8).
MIGRATION_LINTER_OPTIONS = {"no_cache": True, "include_apps": ["{{ pod_snake }}", "core"]}


def _test_database(user: str, **options: object) -> dict[str, object]:
    """시험 DB 별칭 — 접속 정보는 conftest(django_db_modify_db_settings)가 testcontainers 값(HOST · PORT · NAME · USER · PASSWORD)으로
    채운다. 그 전의 값은 닫힌 포트다 — pytest 밖에서 이 설정으로 돈 관리 명령(makemigrations의 이력 검사 등)은 어디에도 닿지 않고
    OperationalError로 끝난다.

    connect_timeout 5(시험 전용 — psycopg 기본은 주소당 130 s라 접속 불가가 멈춤이 된다) · CONN_MAX_AGE 0 · 연결 풀 없음(별칭의 첫
    설정을 고정하는 풀은 settings_dict를 바꿔 DB 다운을 흉내 내는 시험과 맞지 않는다)."""
    return {
        "ENGINE": "django.db.backends.postgresql",
        "HOST": "127.0.0.1",
        "PORT": str(CLOSED_PORT),
        "NAME": _snake,
        "USER": user,
        "PASSWORD": "",
        "OPTIONS": {"sslmode": "require", "connect_timeout": 5, **options},
        "CONN_MAX_AGE": 0,
    }


DATABASES = {
    # 런타임 별칭 = app role(NOBYPASSRLS · 기본 권한 없음 — 0001_app_role_grants가 준다). TEST.MIRROR owner: 두 별칭은 같은 물리
    # DB다 — TransactionTestCase는 mirror가 아닌 별칭만 flush(TRUNCATE)하고, app role에는 TRUNCATE 권한이 없다. DB 마크는
    # databases=["default", "owner"]로 둘 다 연다.
    "default": {**_test_database(f"{_snake}_app"), "TEST": {"MIRROR": "owner"}},
    # 마이그레이션 · 시드 · DDL 전용 = owner role(BYPASSRLS). lock_timeout 30s: 멈춘 스레드가 쥔 잠금 때문에 teardown flush가 무한
    # 대기하지 않게.
    "owner": _test_database(f"{_snake}_owner", options="-c lock_timeout=30s"),
}
