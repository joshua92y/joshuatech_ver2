# --- app role 권한(core/0001_app_role_grants) ---------------------------------------------------------------------------


def test_app_role_has_exactly_dml_on_every_table(pg: PgInfo) -> None:
    """public 표 전부에 app role 권한 = SELECT · INSERT · UPDATE · DELETE 정확히(TRUNCATE · REFERENCES · TRIGGER 없음) ·
    django_migrations만 SELECT 하나(앱은 마이그레이션 이력을 쓰지 않는다)."""
    tables = _public_relations("r")
    assert {"outbox", "rls_widget", MIGRATIONS_TABLE} <= set(tables)
    expected = {table: frozenset({"SELECT"}) if table == MIGRATIONS_TABLE else APP_TABLE_PRIVILEGES for table in tables}
    actual = {table: _table_privileges(pg.app_user, table) for table in tables}
    mismatched = {table: sorted(actual[table]) for table in tables if actual[table] != expected[table]}
    assert mismatched == {}


def test_app_role_uses_every_sequence(pg: PgInfo) -> None:
    """public 시퀀스 전부에 app role 권한 = USAGE · SELECT(UPDATE 없음 — setval 불가)."""
    sequences = _public_relations("S")
    assert sequences, "public 시퀀스가 하나도 없다(django_migrations id 시퀀스는 있어야 한다)"
    mismatched = {
        sequence: sorted(held)
        for sequence in sequences
        if (held := _sequence_privileges(pg.app_user, sequence)) != APP_SEQUENCE_PRIVILEGES
    }
    assert mismatched == {}


def test_default_privileges_cover_objects_created_later(pg: PgInfo) -> None:
    """owner가 마이그레이션 뒤에 만드는 표 · 시퀀스에도 app role 권한이 붙는다(ALTER DEFAULT PRIVILEGES) — app role이 그 표에 실제로
    INSERT · SELECT · UPDATE · DELETE를 하고, 시퀀스에 nextval을 부른다. 표는 RLS가 없으므로 끝나면 지운다(check_rls)."""
    table, sequence = "t072_later_probe", "t072_later_probe_seq"
    owner_execute(f"CREATE TABLE {table} (id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, note text NOT NULL)")
    owner_execute(f"CREATE SEQUENCE {sequence}")
    try:
        assert _table_privileges(pg.app_user, table) == APP_TABLE_PRIVILEGES
        assert _sequence_privileges(pg.app_user, f"{table}_id_seq") == APP_SEQUENCE_PRIVILEGES
        assert _sequence_privileges(pg.app_user, sequence) == APP_SEQUENCE_PRIVILEGES
        with connections["default"].cursor() as cursor:
            cursor.execute(f"INSERT INTO {table} (note) VALUES (%s) RETURNING id", ["x"])
            (row_id,) = cursor.fetchone()
            cursor.execute(f"UPDATE {table} SET note = %s WHERE id = %s", ["y", row_id])
            cursor.execute(f"SELECT note FROM {table} WHERE id = %s", [row_id])
            assert cursor.fetchone() == ("y",)
            cursor.execute(f"DELETE FROM {table} WHERE id = %s", [row_id])
            assert cursor.rowcount == 1
            cursor.execute("SELECT nextval(%s)", [sequence])
            assert cursor.fetchone() == (1,)
    finally:
        owner_execute(f"DROP TABLE IF EXISTS {table}")
        owner_execute(f"DROP SEQUENCE IF EXISTS {sequence}")


def test_relay_round_trip_as_app_role() -> None:
    """relay_once(app role · 컨텍스트 없음): 성공이면 행 삭제(DELETE) · 실패 DR이면 attempts 1(UPDATE) — 둘 다 app role 권한으로
    된다(SELECT … FOR UPDATE SKIP LOCKED 포함). 프로듀서는 대역이다(실 Kafka 왕복은 test_outbox)."""
    from django_common.outbox import relay_once

    seed(1, TENANT_A)
    delivered = relay_once(producer=FakeProducer())
    assert (delivered.published, delivered.failed, delivered.dead) == (1, 0, 0)
    assert owner_scalar("SELECT count(*) FROM outbox") == 0
    seed(1, TENANT_B)
    refused = relay_once(producer=FakeProducer(decide=fail_topics(KAFKA_TOPIC)))
    assert (refused.published, refused.failed, refused.dead) == (0, 1, 0)
    assert owner_scalar("SELECT attempts FROM outbox") == 1


# --- check_rls --------------------------------------------------------------------------------------------------------


def test_check_rls_passes_for_owner_and_app_role() -> None:
    """check_rls: owner(CI · migrate Job) · app role + require_rls_role(기동) 둘 다 위반 0 · 명령 성공 줄 · 이 템플릿의 표 등급 —
    rls_widget(A)은 ENABLE + FORCE ROW LEVEL SECURITY, outbox(B)는 RLS 없음."""
    assert check_rls(using="owner") == []
    assert check_rls(using="default", require_rls_role=True) == []
    out = io.StringIO()
    call_command("check_rls", database="owner", stdout=out)
    match = CHECK_RLS_OK.fullmatch(out.getvalue().strip())
    assert match is not None, "check_rls 성공 줄이 계약 꼴이 아니다"
    grade_a, grade_b, framework = (int(value) for value in match.groups())
    assert grade_a >= 1 and grade_b >= 1 and framework >= 1
    with connections["owner"].cursor() as cursor:
        cursor.execute(
            "SELECT c.relname, c.relrowsecurity, c.relforcerowsecurity FROM pg_catalog.pg_class c"
            " JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace"
            " WHERE n.nspname = 'public' AND c.relname IN ('rls_widget', 'outbox')"
        )
        flags = {name: (enabled, forced) for name, enabled, forced in cursor.fetchall()}
    assert flags == {"rls_widget": (True, True), "outbox": (False, False)}


def test_check_rls_flags_unlisted_table_without_rls() -> None:
    """허용 목록 밖의 표가 RLS 없이 있으면 check_rls(함수 · 명령)가 그 표 이름으로 실패한다 — 지우면 다시 통과한다."""
    table = "t072_rogue"
    owner_execute(f"CREATE TABLE {table} (id integer)")
    try:
        flagged = [violation for violation in check_rls(using="owner") if violation.startswith(f"{table}:")]
        assert flagged, f"check_rls가 {table}을 잡지 못했다"
        with pytest.raises(CommandError, match=table):
            call_command("check_rls", database="owner", stdout=io.StringIO())
    finally:
        owner_execute(f"DROP TABLE IF EXISTS {table}")
    assert check_rls(using="owner") == []


