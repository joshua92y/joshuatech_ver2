        RlsWidget.objects.using("owner").create(tenant_id=TENANT_A, name=name)
    for name in ("b1", "b2", "b3"):
        RlsWidget.objects.using("owner").create(tenant_id=TENANT_B, name=name)


def _table_privileges(app_user: str, table: str) -> frozenset[str]:
    """app role이 public.table에 가진 표 권한(has_table_privilege는 권한마다 따로 묻는다 — 쉼표 목록은 「하나라도」라 쓰지 않는다)."""
    held: set[str] = set()
    with connections["owner"].cursor() as cursor:
        for privilege in TABLE_PRIVILEGES:
            cursor.execute("SELECT has_table_privilege(%s, %s, %s)", [app_user, f"public.{table}", privilege])
            if cursor.fetchone()[0]:
                held.add(privilege)
    return frozenset(held)


def _sequence_privileges(app_user: str, sequence: str) -> frozenset[str]:
    held: set[str] = set()
    with connections["owner"].cursor() as cursor:
        for privilege in ("USAGE", "SELECT", "UPDATE"):
            cursor.execute("SELECT has_sequence_privilege(%s, %s, %s)", [app_user, f"public.{sequence}", privilege])
            if cursor.fetchone()[0]:
                held.add(privilege)
    return frozenset(held)


def _public_relations(relkind: str) -> list[str]:
    """public 스키마의 관계 이름(relkind r = 표 · S = 시퀀스)."""
    with connections["owner"].cursor() as cursor:
        cursor.execute(
            "SELECT c.relname FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace"
            " WHERE n.nspname = 'public' AND c.relkind = %s ORDER BY 1",
            [relkind],
        )
        return [row[0] for row in cursor.fetchall()]


def _auth_headers(jwks: JwksInfo, **bearer_overrides: object) -> dict[str, str]:
    """유효한 Access(서비스 토큰) + Bearer(기본 tenant_id = 테넌트 A) 헤더."""
    access = mint(access_claims(), jwks.access_key, ACCESS_KID)
    bearer = mint(bearer_claims(**bearer_overrides), jwks.authentik_key, AUTHENTIK_KID)
    return {"host": HOST, "Cf-Access-Jwt-Assertion": access, "Authorization": f"Bearer {bearer}"}


def _backend_pid_and_context() -> tuple[int, str | None]:
    with connections["default"].cursor() as cursor:
        cursor.execute("SELECT pg_backend_pid(), current_setting('app.tenant_id', true)")
        pid, context = cursor.fetchone()
    return pid, context


def _plain_lines(text: str) -> list[str]:
    """출력의 줄 가운데 구조 로그(JSON 객체 줄)가 아닌 것 — 명령의 고정 출력 줄만 남긴다."""
    return [line for line in text.splitlines() if line.strip() and not line.lstrip().startswith("{")]


def _windows(value: str, size: int = SECRET_WINDOW) -> tuple[str, ...]:
    """value의 모든 size자 조각 — 잘린 표현에 실린 비밀 조각을 찾는다."""
    return tuple(dict.fromkeys(value[start : start + size] for start in range(len(value) - size + 1)))


def _assert_absent(where: str, text: str, *needles: str) -> None:
    """needles가 text 어디에도 없다 — 인자를 Secret으로 다시 묶고 위치 번호로 접는다(실패 출력에 값이 실리지 않게)."""
    text = Secret(text)
    needles = tuple(Secret(needle) for needle in needles)
    leaked = [index for index, needle in enumerate(needles) if needle and needle in text]
    assert leaked == [], f"{where}에 민감 값이 있다(needles 위치 {leaked})"


def _redact(text: str, env: Mapping[str, str], extra: tuple[str, ...] = ()) -> str:
    values = {
        value
        for name, value in env.items()
        if value and len(value) >= 4 and any(marker in name.upper() for marker in SENSITIVE_ENV_MARKERS)
    }
    values.update(value for value in extra if value)
    for value in sorted(values, key=len, reverse=True):
        text = text.replace(value, "***")
    return text


@dataclass(frozen=True)
class CommandRun:
    """관리 명령 하위 프로세스 결과 — 출력 · env · 심은 비밀은 repr에서 뺀다."""

    returncode: int
    stdout: str = field(repr=False)
    stderr: str = field(repr=False)
    env: dict[str, str] = field(repr=False)
    planted: tuple[str, ...] = field(repr=False, default=())

    def summary(self) -> str:
        """종료 코드 + stderr 줄 수 + 마지막 줄(env 비밀 값 · 심은 비밀 가림 · 300자)."""
        lines = [line for line in self.stderr.splitlines() if line.strip()]
        last = _redact(lines[-1], self.env, self.planted)[:300] if lines else ""
        return f"종료 코드 {self.returncode} · stderr {len(lines)}줄 · 마지막 줄: {last}"


def _closed_port() -> int:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as probe:
        probe.bind(("127.0.0.1", 0))
        port: int = probe.getsockname()[1]
    return port


def _manage(args: list[str], overrides: Mapping[str, str], planted: tuple[str, ...]) -> CommandRun:
    """pod 설정(래퍼가 아니다)으로 `python manage.py <args>`를 새 프로세스로 돈다 — env = 이 프로세스의 os.environ(래퍼가 채운
    설정 env) + DJANGO_SETTINGS_MODULE={{ pod_snake }}.settings + overrides · cwd = pod 루트 · shell 없음 · 시간 상한."""
    env = dict(os.environ)
    env["DJANGO_SETTINGS_MODULE"] = POD_SETTINGS
    env["PYTHONIOENCODING"] = "utf-8"
    env.update(overrides)
    completed: subprocess.CompletedProcess[str] | None
    try:
        completed = subprocess.run(  # noqa: S603 — 인자 고정 · shell 없음 · 이 프로세스의 인터프리터
            [sys.executable, "manage.py", *args],
            cwd=POD_ROOT,
            env=env,
            capture_output=True,
            encoding="utf-8",
            errors="replace",
            timeout=BOOT_TIMEOUT_S,
            check=False,
            shell=False,
        )
    except subprocess.TimeoutExpired:
        completed = None  # 실패는 except 밖에서 낸다(명령 줄 · 부분 출력이 연쇄 예외로 실리지 않게)
    if completed is None:
        pytest.fail(f"manage.py {args[0]}가 {BOOT_TIMEOUT_S} s 안에 끝나지 않았다", pytrace=False)
    return CommandRun(completed.returncode, completed.stdout, completed.stderr, env, planted)


# --- A 등급(RlsWidget) --------------------------------------------------------------------------------------------------


def test_grade_a_tenant_context_sees_only_own_rows() -> None:
    """테넌트 A 컨텍스트(app role · set_tenant_context)에서는 A 행 2개만 · B 행 0 / tenant_context(B)로 바꾸면 B 행 3개만."""
    _seed_widgets()
    with transaction.atomic():
        set_tenant_context(TENANT_A)
        assert RlsWidget.objects.count() == 2
        assert RlsWidget.objects.filter(tenant_id=TENANT_B).count() == 0
        assert set(RlsWidget.objects.values_list("tenant_id", flat=True)) == {TENANT_A}
        with tenant_context(TENANT_B):
            assert set(RlsWidget.objects.values_list("tenant_id", flat=True)) == {TENANT_B}
            assert RlsWidget.objects.count() == 3
        assert current_tenant_id() == TENANT_A


def test_grade_a_without_context_sees_no_rows() -> None:
    """테넌트 컨텍스트가 없으면 app role은 0행이다(닫힌 쪽)."""
    _seed_widgets()
    assert RlsWidget.objects.count() == 0
    with transaction.atomic():
        assert current_tenant_id() is None
        assert RlsWidget.objects.count() == 0


def test_grade_a_owner_sees_all_rows() -> None:
    """owner role(BYPASSRLS)은 FORCE RLS 아래에서도 컨텍스트 없이 전체(5행)를 본다."""
    _seed_widgets()
    assert RlsWidget.objects.using("owner").count() == 5


def test_grade_a_with_check_blocks_cross_tenant_write() -> None:
    """테넌트 A 컨텍스트에서 B 행을 쓰면 정책의 WITH CHECK가 막는다(행은 남지 않는다)."""
    with pytest.raises(DatabaseError, match="row-level security"):
        with transaction.atomic():
            set_tenant_context(TENANT_A)
            RlsWidget.objects.create(tenant_id=TENANT_B, name="cross")
    assert RlsWidget.objects.using("owner").count() == 0


@pytest.mark.usefixtures("auth_settings", "dragonfly_clean")
def test_grade_a_request_context_from_bearer(jwks_server: JwksInfo, settings: SettingsWrapper) -> None:
    """pod 미들웨어 사슬: Bearer tenant_id(A) → request.tenant_id → 요청 트랜잭션 컨텍스트 → A 행 2개만 · Bearer tenant_id(B) →
    3개만 · tenant_id 없는 Bearer → 403 tenant_required · 요청 뒤 같은 DB 세션에 GUC가 남지 않는다(set_config(…, true))."""
    settings.ROOT_URLCONF = __name__
    _seed_widgets()
    client = Client()
    pid_before, _ = _backend_pid_and_context()
    first = client.get(WIDGET_COUNT_PATH, headers=_auth_headers(jwks_server))
    assert first.status_code == 200
    assert json.loads(first.content) == {"count": 2, "tenant_ids": [str(TENANT_A)], "context": str(TENANT_A)}
    second = client.get(WIDGET_COUNT_PATH, headers=_auth_headers(jwks_server, tenant_id=str(TENANT_B)))
    assert second.status_code == 200
    assert json.loads(second.content) == {"count": 3, "tenant_ids": [str(TENANT_B)], "context": str(TENANT_B)}
    without_tenant = client.get(WIDGET_COUNT_PATH, headers=_auth_headers(jwks_server, tenant_id=None))
    assert_problem(without_tenant, 403, "tenant_required")
    pid_after, leaked = _backend_pid_and_context()
    assert pid_after == pid_before  # 같은 세션이어야 누출 검사가 뜻이 있다(시험 Client는 요청 끝에 연결을 닫지 않는다)
    assert leaked in (None, "")
    assert RlsWidget.objects.count() == 0


