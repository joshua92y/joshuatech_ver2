def test_startup_check_unreachable_db_prints_class_name_only() -> None:
    """닫힌 포트 DB(하위 프로세스 · pod 설정 · --wait 1): 종료 코드 1 · stderr 한 줄 `startup_check: FAIL OperationalError` ·
    stdout은 재시도 줄뿐 · 트레이스백 · 접속 문자열 · 비밀번호(조각 포함) 없음(libpq 오류 문구는 자격 조각을 실을 수 있다)."""
    password = secrets.token_urlsafe(24)
    url = f"postgresql://{POD_SNAKE}_app:{password}@127.0.0.1:{_closed_port()}/{POD_SNAKE}?sslmode=require"
    result = _manage(["startup_check", "--wait", "1"], {"DATABASE_URL": url}, (password, url))
    assert result.returncode == 1, result.summary()
    one_line = _plain_lines(result.stderr) == ["startup_check: FAIL OperationalError"]
    assert one_line, f"stderr가 계약 한 줄이 아니다 — {result.summary()}"
    stray = [index for index, line in enumerate(_plain_lines(result.stdout)) if STARTUP_RETRY.fullmatch(line) is None]
    assert stray == [], f"stdout에 재시도 줄이 아닌 줄이 있다(줄 번호 {stray})"
    output = result.stdout + result.stderr
    has_traceback = "Traceback" in output
    assert not has_traceback, "startup_check 출력에 트레이스백이 있다"
    _assert_absent("startup_check 출력", output, password, url, "postgresql://", *_windows(password))
