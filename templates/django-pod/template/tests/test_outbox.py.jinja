def test_dead_rows_are_not_repicked_and_purge_after_30_days() -> None:
    """dead 행(10회 실패) · 29일 전 dead 행 · pending 행 → 성공 대역 릴레이는 pending만 보낸다(RelayResult(1, 0, 0) · dead 행 produce
    0) → call_command("outbox_purge") `outbox_purge: 0`(dead_at이 30일 안) → dead 행을 31일 전으로 옮기면 `outbox_purge: 1` · 남는
    행은 29일 전 dead 행뿐(pending은 릴레이가 지웠다 · purge는 dead_at IS NULL을 건드리지 않는다)."""
    dead, _, _ = _drive_to_dead()
    recent, pending = seed(2, TENANT_B)
    _mark_dead(recent.pk, 29)
    fresh = FakeProducer()
    assert relay_once(producer=fresh) == RelayResult(published=1, failed=0, dead=0)
    assert [call.row_id() for call in fresh.sent] == [pending.pk]
    out = io.StringIO()
    call_command("outbox_purge", stdout=out)
    assert _purge_count(out.getvalue()) == 0
    _mark_dead(dead.pk, 31)
    out = io.StringIO()
    call_command("outbox_purge", stdout=out)
    assert _purge_count(out.getvalue()) == 1
    assert set(owner_rows()) == {recent.pk}


