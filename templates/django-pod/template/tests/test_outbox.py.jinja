@DB
def test_publish_outside_atomic_raises() -> None:
    """transaction.atomic() 밖(autocommit)에서는 tenant_id를 넘겨도 OutboxUsageError · 행 0."""
    assert not connections["default"].in_atomic_block
    with pytest.raises(OutboxUsageError):
        publish(TOPIC, SUBJECT, dict(DATA), tenant_id=TENANT_A)
    assert OutboxEvent.objects.using("owner").count() == 0


@DB
def test_publish_without_context_or_tenant_raises() -> None:
    """atomic 안이어도 테넌트 컨텍스트도 tenant_id 인자도 없으면 OutboxUsageError · 행 0 — 새 세션(GUC NULL)과 앞 트랜잭션이
    컨텍스트를 두었다 끝난 세션(GUC '') 둘 다."""
    connections["default"].close()
    with pytest.raises(OutboxUsageError), transaction.atomic():
        publish(TOPIC, SUBJECT, dict(DATA))
    with transaction.atomic():
        set_tenant_context(TENANT_A)
    with pytest.raises(OutboxUsageError), transaction.atomic():
        publish(TOPIC, SUBJECT, dict(DATA))
    assert OutboxEvent.objects.using("owner").count() == 0


@DB
def test_publish_tenant_from_argument_or_request_context() -> None:
    """컨텍스트 없는 경로 + tenant_id=B → partition_key · 봉투 tenantid = B · 요청 컨텍스트 A(인자 없음) → A · 컨텍스트 A와 인자 B가
    어긋나면 OutboxUsageError · slug tenant_id → OutboxUsageError(행은 앞의 둘뿐)."""
    with transaction.atomic():
        by_argument = publish(TOPIC, SUBJECT, dict(DATA), tenant_id=TENANT_B)
    with transaction.atomic():
        set_tenant_context(TENANT_A)
        by_context = publish(TOPIC, SUBJECT, dict(DATA))
    with pytest.raises(OutboxUsageError), transaction.atomic():
        set_tenant_context(TENANT_A)
        publish(TOPIC, SUBJECT, dict(DATA), tenant_id=TENANT_B)
    with pytest.raises(OutboxUsageError), transaction.atomic():
        publish(TOPIC, SUBJECT, dict(DATA), tenant_id="joshuatech")
    rows = owner_rows()
    assert set(rows) == {by_argument.pk, by_context.pk}
    for event, tenant in ((by_argument, TENANT_B), (by_context, TENANT_A)):
        row = rows[event.pk]
        assert (row.partition_key, row.payload["tenantid"], row.topic) == (str(tenant), str(tenant), TOPIC)


@DB
def test_publish_owned_accepts_owned_events_only(monkeypatch: pytest.MonkeyPatch) -> None:
    """publish_owned(events/): OWNED_EVENTS 밖의 이벤트 → ValueError(행 0 — 다른 pod의 토픽 · 목록에 없는 이벤트를 발행하지 않는다) ·
    목록 안 → 논리 토픽 <OUTBOX_SOURCE>.<entity>.<event>(env 접두 없음)의 행 하나."""
    from {{ pod_snake }} import events

    owned = "outbox-test.recorded"
    monkeypatch.setattr(events, "OWNED_EVENTS", (*events.OWNED_EVENTS, owned))
    with pytest.raises(ValueError), transaction.atomic():
        events.publish_owned("outbox-test.unowned", SUBJECT, dict(DATA), tenant_id=TENANT_A)
    assert OutboxEvent.objects.using("owner").count() == 0
    with transaction.atomic():
        event = events.publish_owned(owned, SUBJECT, dict(DATA), tenant_id=TENANT_A)
    assert events.topic(owned) == TOPIC == f"{settings.OUTBOX_SOURCE}.{owned}"
    row = owner_rows()[event.pk]
    assert (row.topic, row.partition_key) == (TOPIC, str(TENANT_A))


