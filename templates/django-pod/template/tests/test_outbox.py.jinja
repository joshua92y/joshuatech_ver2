# 실제 relay 프로세스(manage.py outbox_relay)를 한 패스 돌리고, 끝난 뒤 그 프로세스의 지표 레지스트리(9464가 내보내는 기본 REGISTRY)를
# 싣는다 — 포트는 열지 않는다(--metrics-port 0 · 같은 REGISTRY).
_RELAY_BODY = """
import json
import runpy
import sys

sys.argv = ["manage.py", "outbox_relay", "--iterations", "1", "--metrics-port", "0", "--poll-interval", "0"]
try:
    runpy.run_path("manage.py", run_name="__main__")
finally:
    from prometheus_client import REGISTRY

    facts = {"metrics": sorted({metric.name for metric in REGISTRY.collect()})}
    print(MARK + json.dumps(facts), flush=True)
"""
RELAY_SCRIPT = f"MARK = {RELAY_MARK!r}\n" + _RELAY_BODY


@DB
def test_relay_process_registry_has_outbox_metrics_only(pg: PgInfo, kafka: str) -> None:
    """실제 relay 프로세스(하위 프로세스 · pod 설정 · 시험 DB app role · 실 Kafka) 한 패스: 종료 0 · 행 1 발행(로그
    outbox_relay.pass published=1) · 행 삭제 · 레지스트리에 outbox_pending · outbox_oldest_pending_seconds · outbox_dead는 있고 web
    지표 http_requests_total은 없다(D11 — web 지표는 web 프로세스 레지스트리만)."""
    (event,) = seed(1, TENANT_A)
    password = str(pg.app_password)
    env = _child_env({"DATABASE_URL": str(pg.url("app")), "KAFKA_BOOTSTRAP": kafka, "ENV": "test"})
    completed: subprocess.CompletedProcess[str] | None
    try:
        completed = subprocess.run(  # noqa: S603 — 인자 고정 · shell 없음 · 이 프로세스의 인터프리터
            [sys.executable, "-c", RELAY_SCRIPT],
            cwd=POD_ROOT,
            env=env,
            capture_output=True,
            encoding="utf-8",
            errors="replace",
            timeout=RELAY_TIMEOUT_S,
            check=False,
            shell=False,
        )
    except subprocess.TimeoutExpired:
        completed = None  # 실패는 except 밖에서 낸다(명령 줄 · 부분 출력이 연쇄 예외로 실리지 않게)
    if completed is None:
        pytest.fail(f"relay 프로세스가 {RELAY_TIMEOUT_S} s 안에 끝나지 않았다", pytrace=False)
    run = ChildRun(completed.returncode, completed.stdout, completed.stderr, env, (password,))
    # 비밀번호 부재를 먼저 본다 — 뒤 단언의 실패 메시지(출력 꼬리)가 그 값을 싣기 전에(H13)
    assert_absent("relay 출력", run.stdout + run.stderr, password)
    assert run.returncode == 0, run.summary()
    marked = [line for line in run.stdout.splitlines() if line.startswith(RELAY_MARK)]
    assert len(marked) == 1, f"레지스트리 줄 수 {len(marked)} · {run.summary()}"
    metrics = set(json.loads(marked[0][len(RELAY_MARK) :])["metrics"])
    assert {"outbox_pending", "outbox_oldest_pending_seconds", "outbox_dead"} <= metrics
    assert "http_requests" not in metrics, "relay 레지스트리에 web 지표 http_requests_total이 있다"
    passes = [
        record
        for line in run.stdout.splitlines()
        if line.startswith("{")
        for record in [json.loads(line)]
        if str(record.get("event", "")).startswith("outbox_relay.pass")
    ]
    assert [record["event"] for record in passes] == ["outbox_relay.pass published=1 failed=0 dead=0"]
    assert owner_scalar("SELECT count(*) FROM outbox WHERE id = %s", [event.pk]) == 0
