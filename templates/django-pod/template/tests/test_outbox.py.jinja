    stopped: list[Stopped] = []
    try:
        for name, argv in _celery_commands(schedule):
            processes.append(_start(name, argv, env, tmp_path / f"{name}.log"))

        def all_alive() -> bool:
            return all(process.popen.poll() is None for process in processes)

        _send_purge(dragonfly)
        purged = _wait_for(
            lambda: owner_scalar("SELECT count(*) FROM outbox WHERE id = %s", [old.pk]) == 0,
            WORKER_DEADLINE_S,
            alive=all_alive,
        )
        beat_file = _wait_for(lambda: any(tmp_path.glob("celerybeat-schedule*")), BEAT_DEADLINE_S, alive=all_alive)
        alive_before_stop = [process.name for process in processes if process.popen.poll() is None]
    finally:
        stopped = [_stop(process) for process in processes]
    logs = {process.name: process.log.read_text(encoding="utf-8", errors="replace") for process in processes}
    # 비밀번호 부재를 먼저 본다 — 뒤 단언의 실패 메시지(로그 꼬리)가 그 값을 싣기 전에(H13 · 꼬리도 맨 비밀번호를 가린다)
    for name, text in logs.items():
        assert_absent(f"{name} 로그", text, *passwords)
    assert purged, f"워커가 {WORKER_DEADLINE_S} s 안에 purge하지 않았다\n{_tails(logs, env, passwords)}"
    assert set(owner_rows()) == {recent.pk, pending.pk}
    events = [event for text in logs.values() for event in _json_events(text)]
    task_events = [event for event in events if event.startswith(f"Task {PURGE_TASK}[")]
    succeeded = [event for event in task_events if " succeeded in " in event]
    assert any(event.endswith(": 1") for event in succeeded), f"작업 성공 줄(결과 1) 없음\n{_tails(logs, env, passwords)}"
    others = [event for event in task_events if " succeeded in " not in event and not event.endswith("] received")]
    assert others == [], f"작업 실패 줄이 있다\n{_tails(logs, env, passwords)}"
    assert beat_file, f"beat 스케줄 파일이 생기지 않았다\n{_tails(logs, env, passwords)}"
    assert "beat: Starting..." in events
    noperm = any(marker in text for text in logs.values() for marker in NOPERM_MARKERS)
    assert not noperm, f"Celery 로그에 NOPERM(채널 권한 없는 pod 사용자로 pub/sub을 썼다)\n{_tails(logs, env, passwords)}"
    assert alive_before_stop == [process.name for process in processes]
    assert [(item.name, item.graceful) for item in stopped] == [(process.name, True) for process in processes]
    if not WINDOWS:
        assert [(item.name, item.returncode, item.leftover) for item in stopped] == [
            (process.name, 0, False) for process in processes
        ]
{%- endif %}
