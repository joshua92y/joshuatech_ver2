# --- Celery(D14) ------------------------------------------------------------------------------------------------------

WINDOWS = sys.platform == "win32"
WORKER_FLAGS = ("--without-gossip", "--without-mingle", "--without-heartbeat", "--loglevel", "INFO")
WORKER_DEADLINE_S = 120  # 워커 기동 · 작업 수신 · purge 관찰 상한(Windows 실측 약 4 s)
BEAT_DEADLINE_S = 60  # beat 스케줄 파일 관찰 상한
STOP_LIMIT_S = 30  # 멈춤 신호 뒤 스스로 끝나는 상한(warm shutdown)
KILL_WAIT_S = 15
GROUP_GRACE_S = 5.0  # (POSIX) 워커가 끝난 뒤 프로세스 그룹이 비기를 기다리는 시간
# Dragonfly ACL 거부의 두 표기 — 서버 응답(NOPERM)과 redis-py 예외 이름(원격 제어를 켜면 워커가 auth:NoPermissionError로 죽는다 · 실측)
NOPERM_MARKERS = ("NOPERM", "NoPermissionError")


@dataclass(frozen=True)
class CeleryProcess:
    name: str
    popen: subprocess.Popen[bytes] = field(repr=False)
    log: Path


@dataclass(frozen=True)
class Stopped:
    """멈춤 결과 — graceful = 멈춤 신호 뒤 STOP_LIMIT_S 안에 스스로 끝났다 · leftover = (POSIX) 같은 프로세스 그룹에 남은 프로세스가
    있었다(kill로 정리했다)."""

    name: str
    graceful: bool
    returncode: int | None
    leftover: bool


def _celery_commands(schedule: Path) -> list[tuple[str, list[str]]]:
    """D14 명령(배포 celery 컨테이너와 같은 인자 — 실행 파일만 이 venv의 `python -m celery`로 같은 CLI를 부른다):
    `celery --app <pod_snake> worker --pool solo --beat --schedule <파일> --without-gossip --without-mingle
    --without-heartbeat --loglevel INFO`. Windows에서는 Celery CLI가 -B/--beat를 거부한다(celery/bin/worker.py CeleryBeat —
    내장 beat는 별도 프로세스 fork에 기댄다) → 같은 워커 인자에서 --beat · --schedule만 빼고 같은 스케줄 파일의 `celery beat`를
    따로 띄운다(Celery가 Windows에 권하는 배치). CI · 컨테이너(Linux)는 D14 명령 그대로다."""
    base = [sys.executable, "-m", "celery", "--app", POD_SNAKE]
    if not WINDOWS:
        return [("worker", [*base, "worker", "--pool", "solo", "--beat", "--schedule", str(schedule), *WORKER_FLAGS])]
    return [
        ("worker", [*base, "worker", "--pool", "solo", *WORKER_FLAGS]),
        ("beat", [*base, "beat", "--schedule", str(schedule), "--loglevel", "INFO"]),
    ]


def _start(name: str, argv: list[str], env: dict[str, str], log: Path) -> CeleryProcess:
    """argv를 띄운다 — stdout · stderr는 로그 파일(파이프가 차서 멈추지 않게) · POSIX는 새 세션(프로세스 그룹 = 그 pid — 내장 beat
    자식까지 그룹으로 정리한다)."""
    with log.open("wb") as sink:
        popen = subprocess.Popen(  # noqa: S603 — 인자 고정 · shell 없음 · 이 프로세스의 인터프리터
            argv, cwd=POD_ROOT, env=env, stdout=sink, stderr=subprocess.STDOUT, start_new_session=not WINDOWS
        )
    return CeleryProcess(name, popen, log)


def _kill(popen: subprocess.Popen[bytes]) -> None:
    if WINDOWS:
        popen.kill()
        return
    try:
        os.killpg(popen.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass


def _group_left(pgid: int) -> bool:
    """(POSIX) 프로세스 그룹 pgid가 GROUP_GRACE_S 안에 비면 False · 남아 있으면 SIGKILL로 정리하고 True."""
    deadline = time.monotonic() + GROUP_GRACE_S
    while time.monotonic() < deadline:
        try:
            os.killpg(pgid, 0)
        except ProcessLookupError:
            return False
        time.sleep(0.1)
    try:
        os.killpg(pgid, signal.SIGKILL)
    except ProcessLookupError:
        return False
    return True


def _stop(process: CeleryProcess) -> Stopped:
    """멈춤 신호: POSIX = SIGTERM(Celery warm shutdown — 배포 종료와 같다) · Windows = TerminateProcess(프로세스 밖에서 보내는
    SIGTERM이 없다). STOP_LIMIT_S 안에 끝나지 않으면 kill(POSIX는 그룹째)하고 기다린다 — 시험은 늘 유한하게 끝난다."""
    popen = process.popen
    if popen.poll() is None:
        if WINDOWS:
            popen.terminate()
        else:
            popen.send_signal(signal.SIGTERM)
    graceful = True
    try:
        popen.wait(STOP_LIMIT_S)
    except subprocess.TimeoutExpired:
        graceful = False
        _kill(popen)
        try:
            popen.wait(KILL_WAIT_S)
        except subprocess.TimeoutExpired:
            pass
    leftover = False if WINDOWS else _group_left(popen.pid)
    return Stopped(process.name, graceful, popen.poll(), leftover)


def _wait_for(done: Callable[[], bool], timeout_s: float, *, alive: Callable[[], bool]) -> bool:
    """done()이 참이 되거나 timeout_s가 지나거나 alive()가 거짓(프로세스가 먼저 끝났다)이 될 때까지 0.25 s마다 본다."""
    deadline = time.monotonic() + timeout_s
    while True:
        if done():
            return True
        if time.monotonic() >= deadline or not alive():
            return done()
        time.sleep(0.25)


def _send_purge(dragonfly: DragonflyInfo) -> None:
    """이 프로세스의 Celery 앱으로 purge 작업을 보낸다 — 시험 Dragonfly pod 사용자 연결(앱 broker_url은 기동 시 닫힌 포트 자리값이다 ·
    전송 옵션 = 앱 설정 · 키 접두 <pod>:)."""
    from {{ pod_snake }}.celery import PURGE_TASK, app

    failure: BaseException | None = None
    try:
        with app.connection_for_write(url=str(dragonfly.pod_url)) as connection:
            app.send_task(PURGE_TASK, connection=connection)
    except Exception as exc:  # noqa: BLE001 — 원 트레이스백 없이 실패로 바꾼다(접속 문자열)
        failure = exc
    if failure is not None:
        _fail_without_trace("send_task", failure)


def _json_events(text: str) -> list[str]:
    """로그의 JSON 객체 줄 event 값(Celery 배너 같은 원문 줄은 건너뛴다)."""
    events: list[str] = []
    for line in text.splitlines():
        if not line.startswith("{"):
            continue
        try:
            record = json.loads(line)
        except ValueError:
            continue
        if isinstance(record, dict):
            events.append(str(record.get("event", "")))
    return events


def _tails(logs: dict[str, str], env: dict[str, str], planted: tuple[str, ...]) -> str:
    """실패 메시지용 로그 꼬리(프로세스마다 마지막 8줄 · env 비밀 값 · 심은 맨 비밀번호 가림 — H13)."""
    parts = []
    for name, text in logs.items():
        tail = "\n".join(text.splitlines()[-8:])
        parts.append(f"--- {name} ---\n{redact(tail, env, planted)}")
    return "\n".join(parts)


def test_celery_app_configuration() -> None:
    """Celery 앱(D14): 원격 제어 끔 · 루트 로거를 건드리지 않음 · eager 끔 · 결과 무시 · 기동 때 브로커 재시도 · 결과 백엔드 없음 ·
    UTC · 전송 옵션 = 키 접두 <pod>: · socket_timeout 5 · socket_connect_timeout 2 · 브로커 URL = 기동 시 DRAGONFLY_URL(ready의
    runtime 분기 configure_broker) · beat 일정 = purge 하나 · crontab 03:17 매일 · 작업 등록."""
    from celery.schedules import crontab

    from {{ pod_snake }}.celery import KEY_PREFIX, PURGE_TASK, app

    conf = app.conf
    assert KEY_PREFIX == f"{POD_NAME}:"
    transport = {"global_keyprefix": KEY_PREFIX, "socket_timeout": 5, "socket_connect_timeout": 2}
    assert conf.broker_transport_options == transport
    flags = (
        conf.worker_enable_remote_control,
        conf.worker_hijack_root_logger,
        conf.task_always_eager,
        conf.task_ignore_result,
        conf.broker_connection_retry_on_startup,
    )
    assert flags == (False, False, False, True, True)
    assert conf.result_backend is None
    assert conf.timezone == "UTC"
    same_broker = conf.broker_url == os.environ["DRAGONFLY_URL"]
    assert same_broker, "브로커 URL이 기동 시 DRAGONFLY_URL이 아니다(ready의 runtime 분기 configure_broker)"
    assert list(conf.beat_schedule) == ["purge-dead-outbox"]
    entry = conf.beat_schedule["purge-dead-outbox"]
    assert entry["task"] == PURGE_TASK
    schedule = entry["schedule"]
    assert isinstance(schedule, crontab)
    assert (schedule.minute, schedule.hour) == ({17}, {3})
    every_day = (schedule.day_of_week, schedule.day_of_month, schedule.month_of_year)
    assert every_day == (set(range(7)), set(range(1, 32)), set(range(1, 13)))
    app.loader.import_default_modules()
    assert PURGE_TASK in app.tasks


