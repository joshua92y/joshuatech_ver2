def test_relay_delivers_both_tenants_to_kafka(kafka: str) -> None:
    """테넌트 A(요청 컨텍스트) · B(tenant_id 인자) 행 → relay_once()(app role · 컨텍스트 없음 · owner 연결 쿼리 0) → 실 Kafka 2건 ·
    RelayResult(2, 0, 0) · 행 삭제 · 메시지마다 value = 저장된 봉투 · key = 그 행의 tenantid · 헤더 ce_type = 논리 토픽 · ce_source ·
    ce_id = 행 id · content-type · 봉투 꼴."""
    with transaction.atomic():
        set_tenant_context(TENANT_A)
        event_a = publish(TOPIC, SUBJECT, dict(DATA))
    with transaction.atomic():
        event_b = publish(TOPIC, SUBJECT_B, dict(DATA), tenant_id=TENANT_B)
    expected = {event_a.pk: (TENANT_A, SUBJECT), event_b.pk: (TENANT_B, SUBJECT_B)}
    stored = {row_id: row.payload for row_id, row in owner_rows().items()}
    assert set(stored) == set(expected)
    with subscribed(kafka, KAFKA_TOPIC) as consumer:
        with CaptureQueriesContext(connections["owner"]) as owner_queries:
            result = relay_once()
        messages = drain(consumer, 2, timeout_s=RECEIVE_TIMEOUT_S)
    assert result == RelayResult(published=2, failed=0, dead=0)
    assert len(owner_queries) == 0  # owner role(BYPASSRLS)은 런타임 릴레이가 쓰지 않는다
    assert len(messages) == 2
    seen: set[str] = set()
    for message in messages:
        headers = headers_dict(message)
        row_id = headers.get("ce_id")
        assert row_id in expected
        tenant, subject = expected[row_id]
        envelope = json.loads(message.value())
        assert envelope == stored[row_id]
        _assert_envelope_shape(envelope, row_id=row_id, tenant=tenant, subject=subject)
        assert message.key() == str(tenant).encode()
        assert (headers.get("ce_type"), headers.get("ce_source")) == (TOPIC, settings.OUTBOX_SOURCE)
        assert headers.get("content-type") == CONTENT_TYPE
        seen.add(row_id)
    assert seen == set(expected)
    assert OutboxEvent.objects.using("owner").count() == 0


