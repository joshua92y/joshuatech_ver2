def _single_document(path: Path) -> dict:
    """deploy/base 파일 하나(pyyaml) — 매핑 문서 정확히 하나."""
    documents = [doc for doc in yaml.safe_load_all(path.read_text(encoding="utf-8")) if doc is not None]
    assert len(documents) == 1 and isinstance(documents[0], dict), f"{path.name}: 매핑 문서 {len(documents)}개(기대 1)"
    return documents[0]


def _kafka_ca_mount_files() -> dict[str, list[str]]:
    """deploy/base/deployment.yaml의 컨테이너(web · relay)별 Kafka CA 파일 경로 — secret jt-kafka-cluster-ca-cert 볼륨을 subPath 없이
    마운트한 mountPath + /ca.crt(Secret 키 ca.crt가 그 디렉터리의 파일이 된다)."""
    spec = _single_document(DEPLOYMENT_FILE)["spec"]["template"]["spec"]
    volumes = {
        volume["name"]
        for volume in spec.get("volumes", [])
        if (volume.get("secret") or {}).get("secretName") == KAFKA_CA_SECRET
    }
    found: dict[str, list[str]] = {name: [] for name in KAFKA_CA_CONTAINERS}
    for container in spec.get("containers", []):
        if container.get("name") not in found:
            continue
        for mount in container.get("volumeMounts", []):
            if mount.get("name") in volumes and not mount.get("subPath"):
                found[container["name"]].append(str(mount["mountPath"]).rstrip("/") + "/" + KAFKA_CA_KEY)
    return found


def test_dev_shape_kafka_ca_and_prefix_match_deploy_base() -> None:
    """설정과 배포 매니페스트의 결속(T072 D17 · X2): dev 모양 기동(하위 프로세스)의 KAFKA_CLIENT_CONFIG["ssl.ca.location"] =
    deploy/base/deployment.yaml의 web · relay 컨테이너가 각각 한 번 마운트한 Kafka CA 경로(mountPath + /ca.crt) · 그 OUTBOX_TOPIC_PREFIX =
    base configmap.yaml의 ENV(dev) + "." = "dev."(base는 dev 값 — prod overlay가 바꾼다)."""
    facts = boot_facts(boot(dev_shape_env()), network_zero=True)
    expected = {name: [facts["kafka_ca_location"]] for name in KAFKA_CA_CONTAINERS}
    assert _kafka_ca_mount_files() == expected
    base_env = _single_document(CONFIGMAP_FILE)["data"]["ENV"]
    assert (base_env, facts["outbox_topic_prefix"]) == ("dev", "dev.")


