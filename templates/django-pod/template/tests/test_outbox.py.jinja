def _fail_without_trace(what: str, exc: BaseException) -> NoReturn:
    """예외를 원 트레이스백 · 메시지 없이 실패로 바꾼다(형식 이름만 — 호출자는 except 블록 밖에서 부른다)."""
    kind = f"{type(exc).__module__}.{type(exc).__name__}"
    pytest.fail(f"{what}: 예외로 끝났다({kind}) — 원 트레이스백 · 메시지는 비밀 노출을 막으려고 싣지 않는다", pytrace=False)


def _assert_envelope_shape(envelope: object, *, row_id: str, tenant: uuid.UUID, subject: str) -> None:
    """봉투 꼴(「스키마 통과」 대신 — 계약 §기본 테스트 2): 필수 키 9 정확히 · const 2 · 라이브러리 ENVELOPE_PATTERNS(id · source ·
    type · subject · tenantid — _envelope.json의 pattern과 같은지는 django-common 시험이 지킨다) · time = UTC 밀리초 Z · 값이 행 ·
    발행 인자와 같다 · data 왕복(jsonb 텍스트 → JSON)."""
    assert isinstance(envelope, dict)
    assert set(envelope) == ENVELOPE_KEYS
    for key, value in ENVELOPE_CONSTS.items():
        assert envelope[key] == value, key
    for key, pattern in ENVELOPE_PATTERNS.items():
        value = envelope[key]
        assert isinstance(value, str) and pattern.search(value) is not None, key
    assert TIME_SHAPE.fullmatch(envelope["time"]) is not None
    assert datetime.fromisoformat(envelope["time"]).utcoffset() == timedelta(0)
    observed = (envelope["id"], envelope["source"], envelope["type"], envelope["subject"], envelope["tenantid"])
    assert observed == (row_id, settings.OUTBOX_SOURCE, TOPIC, subject, str(tenant))
    assert envelope["data"] == DATA


def _mark_dead(row_id: str, days: int) -> None:
    """owner로 행을 dead로 만든다 — attempts = MAX_ATTEMPTS · dead_at = DB now() − days일."""
    owner_execute(
        "UPDATE outbox SET attempts = %s, dead_at = now() - make_interval(days => %s) WHERE id = %s",
        [MAX_ATTEMPTS, days, row_id],
    )


def _drive_to_dead() -> tuple[OutboxEvent, FakeProducer, list[RelayResult]]:
    """1행을 메인 토픽 실패 대역으로 MAX_ATTEMPTS번 릴레이해 dead로 만든다."""
    (event,) = seed(1, TENANT_A)
    fake = FakeProducer(decide=fail_topics(KAFKA_TOPIC, reason=INJECTED_ERROR))
    results = [relay_once(producer=fake) for _ in range(MAX_ATTEMPTS)]
    return event, fake, results


def _purge_count(output: str) -> int:
    """outbox_purge 명령 stdout(한 줄 `outbox_purge: N`)의 N."""
    lines = [line for line in output.splitlines() if line.strip()]
    assert len(lines) == 1, f"outbox_purge 출력 줄 수 {len(lines)}"
    match = PURGE_LINE.fullmatch(lines[0].strip())
    assert match is not None, "outbox_purge 출력이 계약 꼴(outbox_purge: N)이 아니다"
    return int(match.group(1))


def _child_env(overrides: dict[str, str]) -> dict[str, str]:
    """하위 프로세스 env — 이 프로세스의 os.environ(시험 래퍼가 덮어쓴 설정 env) − OTEL_* · 프록시 · SSLKEYLOGFILE ·
    PROMETHEUS_MULTIPROC_DIR · 검증된 설정을 대신하는 env(Celery 브로커 · 결과 URL · GUNICORN_CMD_ARGS) + pod 설정 모듈 +
    overrides(실제 의존에 닿아야 하는 값만 명시한다)."""
    env = {
        name: value
        for name, value in os.environ.items()
        if not name.upper().startswith("OTEL_") and name.upper() not in _DROPPED_ENV
    }
    env.update(DJANGO_SETTINGS_MODULE=POD_SETTINGS, PYTHONIOENCODING="utf-8")
    env.update(overrides)
    return env


@dataclass(frozen=True)
class ChildRun:
    """하위 프로세스 결과 — 출력 · env · 심은 맨 비밀번호는 repr에서 뺀다(단언 실패 출력에 실리지 않게). planted = env 값 통째가
    아니라 그 안의 맨 비밀번호(시험 DB app role · Dragonfly pod 사용자) — 출력 꼬리에 비밀번호만 실린 줄도 가린다(T072 ② r2 H13 ·
    B-5 · tests._boot.BootResult와 같은 꼴)."""

    returncode: int
    stdout: str = field(repr=False)
    stderr: str = field(repr=False)
    env: dict[str, str] = field(repr=False)
    planted: tuple[str, ...] = field(repr=False, default=())

    def summary(self) -> str:
        """종료 코드 + stderr 줄 수 + 마지막 줄(env 비밀 값 · 심은 맨 비밀번호 가림 · 300자)."""
        lines = [line for line in self.stderr.splitlines() if line.strip()]
        last = redact(lines[-1], self.env, self.planted)[:300] if lines else ""
        return f"종료 코드 {self.returncode} · stderr {len(lines)}줄 · 마지막 줄: {last}"


