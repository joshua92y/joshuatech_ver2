    from opentelemetry.sdk.trace import TracerProvider
    from opentelemetry.sdk.trace.export.in_memory_span_exporter import InMemorySpanExporter
    from pytest_django.fixtures import SettingsWrapper

    from tests.conftest import JwksInfo, LogLines

    OTel = tuple[TracerProvider, InMemorySpanExporter]

DB = pytest.mark.django_db(transaction=True, databases=["default", "owner"])

POD_ROOT = Path(__file__).resolve().parents[1]
POD_SETTINGS = "{{ pod_snake }}.settings"
HOST = "{{ pod_name }}.test.svc"  # 시험 래퍼의 ALLOWED_HOSTS
REQUEST_ID = "req-t072-logging"
OPENAPI_PATH = "/api/openapi.json"
OPENAPI_ROUTE = "api/openapi.json"
HEX32 = re.compile(r"[0-9a-f]{32}")
SPAN_ID = re.compile(r"[0-9a-f]{16}")
# 로그에 키로 남으면 안 되는 요청 헤더(정규화: 소문자 · `_` → `-`)
SENSITIVE_KEYS = frozenset({"authorization", "cookie", "x-authentik-signature", "cf-access-jwt-assertion"})
COOKIE_MARK = "MARK-COOKIE"
SIGNATURE_MARK = "MARK-SIGNATURE"
QUERY_MARK = "QS-MARK"
OTEL_MIDDLEWARE_PREFIX = "opentelemetry.instrumentation.django."
REQUEST_ID_MIDDLEWARE = "django_common.observability.RequestIdMiddleware"
BOOT_TIMEOUT_S = 120
BOOT_MARK = "JT-WSGI-BOOT "
SENSITIVE_ENV_MARKERS = ("PASSWORD", "SECRET", "TOKEN", "KEY", "URL", "DSN")
PROXY_ENV = frozenset({"HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "NO_PROXY"})


# --- 도우미 --------------------------------------------------------------------------------------------------------------


def _events(records: list[dict[str, Any]], event: str) -> list[dict[str, Any]]:
    return [record for record in records if record.get("event") == event]


def _one(records: list[dict[str, Any]], event: str) -> dict[str, Any]:
    """event 줄이 정확히 하나여야 한다."""
    matches = _events(records, event)
    assert len(matches) == 1, f"{event} 줄 수 {len(matches)}"
    return matches[0]


def _keys(value: object) -> Iterator[str]:
    """중첩 매핑 · 목록의 모든 키(정규화: 소문자 · `_` → `-`)."""
    if isinstance(value, Mapping):
        for key, item in value.items():
            yield str(key).lower().replace("_", "-")
            yield from _keys(item)
    elif isinstance(value, list | tuple):
        for item in value:
            yield from _keys(item)


def _auth_headers(jwks: JwksInfo) -> tuple[dict[str, str], tuple[str, str]]:
    """유효한 Access + Bearer(tenant_id = 테넌트 A · sub user-sub-1) 헤더와 두 토큰 문자열."""
    access = mint(access_claims(), jwks.access_key, ACCESS_KID)
    bearer = mint(bearer_claims(), jwks.authentik_key, AUTHENTIK_KID)
    return {"host": HOST, "Cf-Access-Jwt-Assertion": access, "Authorization": f"Bearer {bearer}"}, (access, bearer)


def _traceparent(trace_id: str, parent_id: str) -> str:
    """sampled W3C traceparent — 샘플러가 parentbased라 상류가 샘플링했으면 span이 기록된다."""
    return f"00-{trace_id}-{parent_id}-01"


def _all_loggers() -> list[logging.Logger]:
    found = [logging.getLogger()]
    found.extend(logger for logger in logging.root.manager.loggerDict.values() if isinstance(logger, logging.Logger))
    return found


def _redact(text: str, env: Mapping[str, str]) -> str:
    values = {
        value
        for name, value in env.items()
        if value and len(value) >= 4 and any(marker in name.upper() for marker in SENSITIVE_ENV_MARKERS)
    }
    for value in sorted(values, key=len, reverse=True):
        text = text.replace(value, "***")
    return text


@dataclass(frozen=True)
class BootRun:
    """wsgi 기동 하위 프로세스 결과 — 출력 · env는 repr에서 뺀다(단언 실패 출력에 실리지 않게)."""

    returncode: int
    stdout: str = field(repr=False)
    stderr: str = field(repr=False)
    env: dict[str, str] = field(repr=False)

    def summary(self) -> str:
        """종료 코드 + stderr 줄 수 + 마지막 줄(env 비밀 값 가림 · 300자)."""
        lines = [line for line in self.stderr.splitlines() if line.strip()]
        last = _redact(lines[-1], self.env)[:300] if lines else ""
        return f"종료 코드 {self.returncode} · stderr {len(lines)}줄 · 마지막 줄: {last}"


# 기동 하위 프로세스: socket 이름 조회 함수 넷을 감싸 모든 조회를 기록하고 공개 도메인 이름은 막는다(가드 자기검사 = 공개 이름
# 하나를 일부러 조회해 막히고 기록되는지 본 뒤 기록을 비운다) → wsgi 진입점 적재 → 사실 JSON 한 줄(finally — 실패 기동에도 조회
# 기록이 남는다). C 확장의 자체 이름 해석(libpq · librdkafka)은 보지 못한다 — 기동은 그 둘에 닿지 않는다(D7).
_BOOT_BODY = """
import json
import socket
import threading

lookups = []
_lock = threading.Lock()


def _name(host):
    if host is None:
        return ""
    text = host.decode("ascii", "replace") if isinstance(host, bytes) else str(host)
    return text.strip().lower().rstrip(".")


def _public(name):
    return name == PUBLIC_SUFFIX or name.endswith("." + PUBLIC_SUFFIX)


def _guarded(original):
    def wrapper(host, *args, **kwargs):
        name = _name(host)
        with _lock:
            lookups.append(name)
        if _public(name):
            raise socket.gaierror(socket.EAI_NONAME, "test guard blocked a public name lookup")
        return original(host, *args, **kwargs)

    return wrapper


for _attr in ("getaddrinfo", "gethostbyname", "gethostbyname_ex", "gethostbyaddr"):
    setattr(socket, _attr, _guarded(getattr(socket, _attr)))

guard_ok = False
try:
    socket.getaddrinfo("guard-selftest." + PUBLIC_SUFFIX, 443)
except socket.gaierror:
    guard_ok = lookups == ["guard-selftest." + PUBLIC_SUFFIX]
lookups.clear()

facts = {}
try:
    from {{ pod_snake }}.wsgi import application
    import sentry_sdk
    from django.conf import settings

    facts = {
        "application": type(application).__name__,
        "middleware": list(settings.MIDDLEWARE[:2]),
        "sentry_active": sentry_sdk.get_client().is_active(),
    }
finally:
    public = [name for name in lookups if _public(name)]
    print(MARK + json.dumps({"guard_ok": guard_ok, "public_lookups": public, "facts": facts}), flush=True)
"""
BOOT_SCRIPT = f"MARK = {BOOT_MARK!r}\nPUBLIC_SUFFIX = 'joshuatech.dev'\n" + _BOOT_BODY


def _boot_wsgi() -> BootRun:
    """pod 설정(래퍼가 아니다)으로 새 프로세스에서 wsgi 진입점을 적재한다 — env = 이 프로세스의 os.environ(래퍼가 채운 설정 env)
    + DJANGO_SETTINGS_MODULE={{ pod_snake }}.settings − OTEL_*(configure_otel 기본값 — 개발자 셸 값이 결과를 바꾸지 않게) − 프록시 ·
    SSLKEYLOGFILE · cwd = pod 루트 · shell 없음 · 시간 상한."""
    env = {
        name: value
        for name, value in os.environ.items()
        if not name.upper().startswith("OTEL_") and name.upper() not in PROXY_ENV and name.upper() != "SSLKEYLOGFILE"
    }
    env["DJANGO_SETTINGS_MODULE"] = POD_SETTINGS
    env["PYTHONIOENCODING"] = "utf-8"
    completed: subprocess.CompletedProcess[str] | None
    try:
        completed = subprocess.run(  # noqa: S603 — 인자 고정 · shell 없음 · 이 프로세스의 인터프리터
            [sys.executable, "-c", BOOT_SCRIPT],
            cwd=POD_ROOT,
            env=env,
            capture_output=True,
            encoding="utf-8",
            errors="replace",
            timeout=BOOT_TIMEOUT_S,
            check=False,
            shell=False,
        )
    except subprocess.TimeoutExpired:
        completed = None  # 실패는 except 밖에서 낸다(명령 줄 · 부분 출력이 연쇄 예외로 실리지 않게)
    if completed is None:
        pytest.fail(f"wsgi 기동이 {BOOT_TIMEOUT_S} s 안에 끝나지 않았다", pytrace=False)
    return BootRun(completed.returncode, completed.stdout, completed.stderr, env)


