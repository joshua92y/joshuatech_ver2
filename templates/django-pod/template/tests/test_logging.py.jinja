def test_django_default_logging_and_mail_are_off() -> None:
    """LOGGING_CONFIG = None · `django` · `django.request` 로거 핸들러 0 · 어느 로거에도 AdminEmailHandler 없음 · DEBUG False ·
    ADMINS · MANAGERS 빈 값 · MAILERS = {}(빈 MAILERS 경고 mail.W001은 끈다) · pod 설정 모듈에 EMAIL_ 이름 0(Django 전역 기본값
    EMAIL_* 은 남으므로 dir(settings)가 아니라 모듈 이름공간을 본다)."""
    assert settings.LOGGING_CONFIG is None
    assert settings.DEBUG is False
    assert list(settings.ADMINS) == []
    assert list(settings.MANAGERS) == []
    assert settings.MAILERS == {}
    assert "mail.W001" in settings.SILENCED_SYSTEM_CHECKS
    pod_settings = importlib.import_module(POD_SETTINGS)
    assert [name for name in vars(pod_settings) if name.startswith("EMAIL_")] == []
    assert logging.getLogger("django").handlers == []
    assert logging.getLogger("django.request").handlers == []
    mailers = [
        type(handler).__name__
        for logger in _all_loggers()
        for handler in logger.handlers
        if isinstance(handler, AdminEmailHandler)
    ]
    assert mailers == []


# --- 요청 로그 ------------------------------------------------------------------------------------------------------------


@DB
@pytest.mark.usefixtures("auth_settings", "dragonfly_clean")
def test_request_finished_carries_request_fields(otel: OTel, jwks_server: JwksInfo, log_lines: LogLines) -> None:
    """자격을 갖춘 요청(OTel 계측 · sampled traceparent · 상류 X-Request-ID · 민감 헤더 표식 · 쿼리 표식) → request_started ·
    request_finished의 request_id = 상류 값 = 응답 X-Request-ID · request_finished의 tenant_id · sub_hash(hex 32 · 원문 sub 아님) ·
    trace_id(상류) · span_id(내보낸 SERVER span) · route · code · request(쿼리 없음) · duration_ms / 모든 줄 ts · level · logger ·
    event / 민감 헤더 키 0 · 토큰 · 표식 · 쿼리 값 · 원문 sub 0."""
    _, exporter = otel
    trace_id, parent_id = secrets.token_hex(16), secrets.token_hex(8)
    headers, tokens = _auth_headers(jwks_server)
    headers.update(
        {
            "Cookie": f"jt_probe={COOKIE_MARK}",
            "X-Authentik-Signature": f"sha256={SIGNATURE_MARK}",
            "X-Request-ID": REQUEST_ID,
            "traceparent": _traceparent(trace_id, parent_id),
        }
    )
    response = Client().get(f"{OPENAPI_PATH}?access_token={QUERY_MARK}", headers=headers)
    assert response.status_code == 200
    assert response["X-Request-ID"] == REQUEST_ID
    records = log_lines()
    started = _one(records, "request_started")
    finished = _one(records, "request_finished")
    spans = exporter.get_finished_spans()
    assert len(spans) == 1
    span_id = format(spans[0].context.span_id, "016x")
    assert started.get("request_id") == REQUEST_ID
    assert finished.get("request_id") == REQUEST_ID
    assert finished.get("tenant_id") == TENANT_ID
    sub_hash = finished.get("sub_hash")
    assert isinstance(sub_hash, str) and HEX32.fullmatch(sub_hash) is not None
    assert finished.get("trace_id") == trace_id
    assert finished.get("span_id") == span_id and SPAN_ID.fullmatch(span_id) is not None
    assert finished.get("route") == OPENAPI_ROUTE
    assert finished.get("code") == 200
    assert finished.get("request") == f"GET {OPENAPI_PATH}"
    duration = finished.get("duration_ms")
    assert isinstance(duration, int | float) and not isinstance(duration, bool) and duration >= 0
    for index, record in enumerate(records):
        for key in ("ts", "level", "logger", "event"):
            value = record.get(key)
            assert isinstance(value, str) and value != "", (index, key)
    sensitive = sorted({key for record in records for key in _keys(record)} & SENSITIVE_KEYS)
    assert sensitive == [], f"로그에 민감 헤더 키가 있다: {sensitive}"
    needles = tuple(Secret(value) for value in (*tokens, COOKIE_MARK, SIGNATURE_MARK, QUERY_MARK, BEARER_SUB))
    raw = Secret(log_lines.raw)
    leaked = [index for index, needle in enumerate(needles) if needle in raw]
    assert leaked == [], f"로그에 토큰 · 표식 · 쿼리 값 · 원문 sub이 있다(needles 위치 {leaked})"


def test_health_and_refused_requests_log_no_identity(otel: OTel, log_lines: LogLines) -> None:
    """/healthz(sampled traceparent여도 트레이스 제외) → request_finished code 200 · route healthz · trace_id · span_id ·
    tenant_id · sub_hash · problem 키 없음 · span 0 / 자격 없는 /api/openapi.json → 403 access_required · request_finished code
    403 · problem access-required · route(URL 해석 전 거절) · tenant_id · sub_hash 키 없음."""
    _, exporter = otel
    client = Client()
    traceparent = _traceparent(secrets.token_hex(16), secrets.token_hex(8))
    healthz = client.get("/healthz", headers={"host": HOST, "traceparent": traceparent})
    assert healthz.status_code == 200
    health_line = _one(log_lines(), "request_finished")
    shape = (health_line.get("code"), health_line.get("route"), health_line.get("request"))
    assert shape == (200, "healthz", "GET /healthz")
    present = [key for key in ("trace_id", "span_id", "tenant_id", "sub_hash", "problem") if key in health_line]
    assert present == []
    assert len(exporter.get_finished_spans()) == 0
    assert_problem(client.get(OPENAPI_PATH, headers={"host": HOST}), 403, "access_required")
    refused = _one(log_lines(), "request_finished")
    assert (refused.get("code"), refused.get("problem")) == (403, "access-required")
    assert [key for key in ("route", "tenant_id", "sub_hash") if key in refused] == []


@DB
@pytest.mark.usefixtures("auth_settings", "dragonfly_clean")
def test_server_error_logs_one_django_request_line(
    jwks_server: JwksInfo, settings: SettingsWrapper, log_lines: LogLines, capsys: pytest.CaptureFixture[str]
) -> None:
    """처리하지 못한 예외(probe urlconf /probe/boom) → 500 internal_error(detail 없음) · django.request 줄 정확히 하나(error ·
    request_id = 응답 X-Request-ID) · request_failed 하나 · request_finished 없음 · stdout · stderr에 원문 줄 0(Django 기본 로깅의
    console · mail_admins가 돌지 않는다 — LOGGING_CONFIG = None)."""
    settings.ROOT_URLCONF = "tests.probe_urls"
    headers, _ = _auth_headers(jwks_server)
    capsys.readouterr()
    response = Client(raise_request_exception=False).get("/probe/boom", headers=headers)
    body = assert_problem(response, 500, "internal_error")
    assert "detail" not in body
    records = log_lines()
    request_lines = [record for record in records if record.get("logger") == "django.request"]
    assert len(request_lines) == 1
    assert request_lines[0].get("level") == "error"
    assert request_lines[0].get("request_id") == response["X-Request-ID"]
    assert len(_events(records, "request_failed")) == 1
    assert _events(records, "request_finished") == []
    captured = capsys.readouterr()
    raw_lines = (len(captured.out.splitlines()), len(captured.err.splitlines()))
    assert raw_lines == (0, 0), f"JSON sink 밖으로 나간 줄 수(stdout · stderr) {raw_lines}"


# --- wsgi 진입점(D7) -----------------------------------------------------------------------------------------------------


def test_wsgi_entry_boots_with_otel_and_no_public_lookups() -> None:
    """새 프로세스(pod 설정)에서 wsgi 적재 → 종료 0 · application WSGIHandler · MIDDLEWARE[0] OTel · [1] RequestIdMiddleware ·
    Sentry 꺼짐 · 공개 이름 조회 0(가드 자기검사 통과) · stdout은 줄마다 JSON 객체(otel_exporter_disabled 경고 포함) · stderr 0."""
    result = _boot_wsgi()
    assert result.returncode == 0, result.summary()
    marked = [line for line in result.stdout.splitlines() if line.startswith(BOOT_MARK)]
    assert len(marked) == 1, f"기동 결과 줄 수 {len(marked)} · {result.summary()}"
    report = json.loads(marked[0][len(BOOT_MARK) :])
    assert report["guard_ok"] is True, "이름 조회 가드가 공개 이름을 막지 못했다(가드 자기검사)"
    assert report["public_lookups"] == []
    facts = report["facts"]
    assert facts["application"] == "WSGIHandler"
    middleware = facts["middleware"]
    assert middleware[0].startswith(OTEL_MIDDLEWARE_PREFIX), "OTel 미들웨어가 맨 앞에 없다"
    assert middleware[1] == REQUEST_ID_MIDDLEWARE
    assert facts["sentry_active"] is False
    records: list[dict[str, Any]] = []
    non_json: list[int] = []
    for number, line in enumerate(result.stdout.splitlines(), start=1):
        if line.startswith(BOOT_MARK):
            continue
        try:
            record = json.loads(line)
        except ValueError:
            non_json.append(number)
            continue
        if isinstance(record, dict):
            records.append(record)
        else:
            non_json.append(number)
    assert non_json == [], f"기동 stdout에 JSON 객체가 아닌 줄(줄 번호 {non_json})"
    disabled = [(line.get("level"), line.get("logger")) for line in _events(records, "otel_exporter_disabled")]
    assert disabled == [("warning", "django_common.observability")]
    stderr_lines = len([line for line in result.stderr.splitlines() if line.strip()])
    assert stderr_lines == 0, f"기동 stderr 줄 수 {stderr_lines}"


# --- 시험 실행 위생(conftest 가드 — T072 ② r2 H9 · H12) ------------------------------------------------------------------

# conftest가 단언 재작성에 등록하는 도우미 모듈(재작성된 모듈에만 pytest가 넣는 이름 @pytest_ar가 있다)
REWRITTEN_HELPERS = ("tests._boot", "tests._problem", "tests._outbox_fakes", "tests._jwt", "tests._kafka")
# conftest pytest_configure 가드의 문구 앞머리 · 조건 이름(값 없음)
RUN_GUARD_PREFIX = "생성물 시험 실행 위생 위반: "
RUN_GUARD_LABELS = frozenset(
    {"PYTHONOPTIMIZE(-O)", "--tb", "--showlocals(-l)", "--show-capture", "--full-trace", "DJANGO_SETTINGS_MODULE(--ds)"}
)
USAGE_ERROR_EXIT = 4  # pytest ExitCode.USAGE_ERROR
PYTEST_CHILD_TIMEOUT_S = 120
PYTEST_CHILD_TARGET = "tests/test_openapi_snapshot.py"  # 모으기만 한다(컨테이너 없음)
# 자식 pytest가 이 프로세스에서 물려받지 않는 env — 사례가 정한다(pytest-django는 이 프로세스에 DJANGO_SETTINGS_MODULE을 둔다)
_PYTEST_CHILD_DROPPED = frozenset(
    {"PYTEST_ADDOPTS", "PYTEST_PLUGINS", "PYTHONOPTIMIZE", "DJANGO_SETTINGS_MODULE", "DJANGO_CONFIGURATION"}
)


def test_helper_modules_are_assert_rewritten() -> None:
    """conftest가 도우미 모듈을 pytest 단언 재작성에 등록했다(pytest.register_assert_rewrite — 도우미 import 앞): 기동 거부 · 위생 ·
    문제 응답 단언(tests._boot · tests._problem · tests._outbox_fakes …)이 재작성돼 python -O · PYTHONOPTIMIZE에서도 사라지지 않고
    (재작성한 단언은 명시 raise다) 공허하게 통과하지 않는다."""
    plain = [name for name in REWRITTEN_HELPERS if "@pytest_ar" not in vars(importlib.import_module(name))]
    assert plain == [], f"단언 재작성 밖의 도우미 모듈: {plain}"


def _pytest_collect(changes: Mapping[str, str]) -> BootRun:
    """이 pod에서 새 pytest 프로세스로 PYTEST_CHILD_TARGET을 모은다(--collect-only) — env = 이 프로세스 env − _PYTEST_CHILD_DROPPED +
    changes · cwd = pod 루트(이 pod의 pyproject addopts · conftest) · shell 없음 · 시간 상한."""
    env = {name: value for name, value in os.environ.items() if name.upper() not in _PYTEST_CHILD_DROPPED}
    env.update(changes)
    env["PYTHONIOENCODING"] = "utf-8"
    completed: subprocess.CompletedProcess[str] | None
    try:
        completed = subprocess.run(  # noqa: S603 — 인자 고정 · shell 없음 · 이 프로세스의 인터프리터
            [sys.executable, "-m", "pytest", "--collect-only", "-p", "no:cacheprovider", PYTEST_CHILD_TARGET],
            cwd=POD_ROOT,
            env=env,
            capture_output=True,
            encoding="utf-8",
            errors="replace",
            timeout=PYTEST_CHILD_TIMEOUT_S,
            check=False,
            shell=False,
        )
    except subprocess.TimeoutExpired:
        completed = None  # 실패는 except 밖에서 낸다(명령 줄 · 부분 출력이 연쇄 예외로 실리지 않게)
    if completed is None:
        pytest.fail(f"pytest 하위 프로세스가 {PYTEST_CHILD_TIMEOUT_S} s 안에 끝나지 않았다", pytrace=False)
    return BootRun(completed.returncode, completed.stdout, completed.stderr, env)


def _run_guard_labels(run: BootRun) -> set[str] | None:
    """stderr의 가드 문구(UsageError — `ERROR: <앞머리><이름> · <이름> … — <안내>`)에 실린 조건 이름 · 없으면 None."""
    lines = [line for line in run.stderr.splitlines() if RUN_GUARD_PREFIX in line]
    if not lines:
        return None
    names = lines[-1].split(RUN_GUARD_PREFIX, 1)[1].split(" — ", 1)[0]
    return {name.strip() for name in names.split(" · ")}


def test_run_guard_refuses_unsafe_runs() -> None:
    """conftest 가드(pytest_configure — H12 · H9 · B-4 · B-1): python -O(PYTHONOPTIMIZE) · short가 아닌 --tb · -l · no가 아닌
    --show-capture · --full-trace · tests.settings가 아닌 설정 모듈(--ds)이 PYTEST_ADDOPTS(명령줄과 같다)로 들어오면 시험을 모으기
    전에 UsageError(종료 4)로 멈추고, 문구는 어긴 조건 이름 여섯만 싣는다(값 없음)."""
    widening = f"--tb=long -l --show-capture=all --full-trace --ds={POD_SETTINGS}"
    run = _pytest_collect({"PYTHONOPTIMIZE": "1", "PYTEST_ADDOPTS": widening})
    assert run.returncode == USAGE_ERROR_EXIT, run.summary()
    assert _run_guard_labels(run) == RUN_GUARD_LABELS, run.summary()


def test_run_settings_module_is_the_wrapper_despite_shell_env() -> None:
    """셸 env DJANGO_SETTINGS_MODULE={{ pod_snake }}.settings(실제 설정)가 있어도 pyproject addopts --ds=tests.settings(pytest-django:
    옵션 > env > ini)가 시험 래퍼를 고정한다 — 새 pytest 프로세스가 `settings: tests.settings (from option)`으로 모으고 가드를
    통과한다(종료 0 · H9 · B-1)."""
    run = _pytest_collect({"DJANGO_SETTINGS_MODULE": POD_SETTINGS})
    assert run.returncode == 0, run.summary()
    pinned = "settings: tests.settings (from option)" in run.stdout
    assert pinned, "pytest-django 머리말에 `settings: tests.settings (from option)`이 없다 — 셸 env가 시험 래퍼를 비켜 갔다"
