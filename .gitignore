# Spec Kit runtime state (active feature pointer is per-checkout)
.specify/feature.json
.specify/extensions/*/local-config.yml

# superpowers plugin workspaces
.worktrees/
.superpowers/

# Claude Code local overrides
.claude/settings.local.json

# OS / editor
.DS_Store
Thumbs.db

# Spec Kit extension catalog cache (machine-local)
.specify/extensions/.cache/

# Node / pnpm workspace
node_modules/

# Python / uv
.venv/
__pycache__/
*.py[cod]

# OpenTofu / Terraform state (never commit state)
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!*.auto.tfvars.example

# Cloudflare build outputs (OpenNext, wrangler)
.open-next/
.wrangler/

# Environment files (commit only *.example)
.env
.env.*
!.env.example

# Test artifacts
e2e/.auth/
tests/fixtures/generated/
