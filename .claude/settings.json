{
  "permissions": {
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(rm -R *)",
      "Bash(sudo rm *)",
      "Bash(git reset --hard*)",
      "Bash(git * reset --hard*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git clean -f*)",
      "Bash(git clean -d*)",
      "Bash(git clean --force*)",
      "Bash(docker system prune*)",
      "Bash(docker * prune*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git * reset --hard*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git clean -f*)",
      "PowerShell(git clean -d*)",
      "PowerShell(git clean --force*)",
      "PowerShell(docker system prune*)",
      "PowerShell(docker * prune*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/approval-review.ps1\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/finish-gate.ps1\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "speckit-agent-context-update": "name-only",
    "speckit-analyze": "name-only",
    "speckit-archive-run": "name-only",
    "speckit-checklist": "name-only",
    "speckit-clarify": "name-only",
    "speckit-constitution": "name-only",
    "speckit-converge": "name-only",
    "speckit-git-commit": "name-only",
    "speckit-git-feature": "name-only",
    "speckit-git-initialize": "name-only",
    "speckit-git-remote": "name-only",
    "speckit-git-validate": "name-only",
    "speckit-implement": "name-only",
    "speckit-plan": "name-only",
    "speckit-specify": "name-only",
    "speckit-tasks": "name-only",
    "speckit-taskstoissues": "name-only"
  }
}
